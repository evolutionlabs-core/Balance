<% content_for :title, "Entry ##{@entry.number}" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Journal entries", path: journal_entries_path }, { label: "Entry ##{@entry.number}" } ] %>
<% end %>

<div class="mx-auto max-w-4xl">
  <div class="flex flex-col gap-4 border-b border-neutral-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <p class="text-sm font-medium text-balance-teal-700">Entry #<%= @entry.number %></p>
        <%= journal_entry_status(@entry) %>
      </div>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-neutral-950"><%= @entry.description.presence || "Journal entry" %></h1>
      <p class="mt-1 text-sm text-neutral-500"><%= @entry.effective_date.to_fs(:long) %></p>
    </div>
    <div class="flex flex-col gap-3 sm:items-end">
      <p class="text-3xl font-semibold tabular-nums text-neutral-950"><%= money(@entry.total) %></p>
      <div class="flex gap-2">
        <% if @entry.templatable? %>
          <%= link_to "Save as template", new_journal_entry_template_path(@entry), class: ghost_button_class(size: :compact), data: { turbo_frame: "modal" } %>
        <% end %>
        <% if @entry.reversible? %>
          <%= link_to "Reverse", new_journal_entry_reversal_path(@entry), class: secondary_button_class(size: :compact), data: { turbo_frame: "modal" } %>
        <% end %>
      </div>
    </div>
  </div>

  <dl class="mt-5 grid gap-4 border-b border-neutral-200 pb-5 sm:grid-cols-3">
    <div>
      <dt class="text-xs font-medium text-neutral-500">Source</dt>
      <dd class="mt-1 text-sm text-neutral-900"><%= journal_entry_source(@entry) %></dd>
    </div>
    <% if @entry.reference.present? %>
      <div>
        <dt class="text-xs font-medium text-neutral-500">Reference</dt>
        <dd class="mt-1 text-sm text-neutral-900"><%= @entry.reference %></dd>
      </div>
    <% end %>
    <% if @entry.tags.any? %>
      <div>
        <dt class="text-xs font-medium text-neutral-500">Tags</dt>
        <dd class="mt-1 text-sm"><%= journal_entry_tags(@entry.tags) %></dd>
      </div>
    <% end %>
    <div>
      <dt class="text-xs font-medium text-neutral-500">Posted by</dt>
      <dd class="mt-1 text-sm text-neutral-900"><%= @entry.posted_by&.full_name || blank_cell %></dd>
    </div>
    <% if @entry.reverses_entry %>
      <div>
        <dt class="text-xs font-medium text-neutral-500">Reverses</dt>
        <dd class="mt-1 text-sm"><%= link_to "Entry ##{@entry.reverses_entry.number}", journal_entry_path(@entry.reverses_entry), class: "font-medium text-balance-teal-700 hover:underline" %></dd>
      </div>
    <% elsif @entry.reversal %>
      <div>
        <dt class="text-xs font-medium text-neutral-500">Reversed by</dt>
        <dd class="mt-1 text-sm"><%= link_to "Entry ##{@entry.reversal.number}", journal_entry_path(@entry.reversal), class: "font-medium text-balance-teal-700 hover:underline" %></dd>
      </div>
    <% end %>
  </dl>

  <section class="mt-7">
    <h2 class="text-sm font-semibold text-neutral-900">Lines</h2>
    <%= render layout: "shared/table", locals: { frame_class: "mt-3", columns: [ { label: "Account" }, { label: "Debit", align: :right }, { label: "Credit", align: :right } ] } do %>
      <% @entry.journal_entry_lines.each do |line| %>
        <tr class="<%= table_row_class %>">
          <td class="<%= table_cell_class(strong: true) %>">
            <%= line.account.name %>
            <% if (counterparty = line.customer || line.vendor) %>
              <span class="mt-0.5 block text-xs font-normal text-neutral-500"><%= counterparty.name %></span>
            <% end %>
          </td>
          <td class="<%= table_cell_class(align: :right) %> tabular-nums"><%= line.debit.positive? ? money(line.debit) : blank_cell %></td>
          <td class="<%= table_cell_class(align: :right) %> tabular-nums"><%= line.credit.positive? ? money(line.credit) : blank_cell %></td>
        </tr>
      <% end %>
      <tr class="border-t border-neutral-200">
        <td class="<%= table_cell_class(strong: true) %>">Total</td>
        <td class="<%= table_cell_class(align: :right, strong: true) %> tabular-nums"><%= money(@entry.total) %></td>
        <td class="<%= table_cell_class(align: :right, strong: true) %> tabular-nums"><%= money(@entry.journal_entry_lines.sum(&:credit)) %></td>
      </tr>
    <% end %>
  </section>
</div>
