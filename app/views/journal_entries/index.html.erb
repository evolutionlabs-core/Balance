<% content_for :title, "Journal entries" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Journal entries" } ] %>
<% end %>

<% draft_count = current_workspace.journal_entry_drafts.unposted.count %>
<% new_entry = tag.div(class: "flex items-center gap-2") do %>
  <% if draft_count.positive? %>
    <%= link_to "Drafts (#{draft_count})", journal_entry_drafts_path, class: secondary_button_class(size: :compact) %>
  <% end %>
  <%= link_to(new_journal_entry_path, class: primary_button_class(size: :compact), data: { turbo_frame: "modal" }) do %>
    <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New entry
  <% end %>
<% end %>

<%= render "shared/page_header",
    title: "Journal entries",
    description: "Manage and review your journal entries.",
    action: new_entry %>

<%= form_with url: journal_entries_path, method: :get, class: "mt-4 flex flex-col gap-2 sm:flex-row", data: { controller: "date-range" } do |form| %>
  <div class="relative min-w-0 flex-1">
    <%= form.search_field :q, value: params[:q], placeholder: "Search entries", class: field_class %>
  </div>
  <div class="relative sm:w-64">
    <%= form.text_field :range,
        value: [ params[:from], params[:to] ].compact_blank.join(" to "),
        placeholder: "Select date range",
        autocomplete: "off",
        class: "#{field_class} cursor-pointer",
        data: { date_range_target: "input" } %>
    <%= form.hidden_field :from, value: params[:from], data: { date_range_target: "from" } %>
    <%= form.hidden_field :to, value: params[:to], data: { date_range_target: "to" } %>
  </div>
  <%= form.hidden_field :tag, value: params[:tag] if params[:tag].present? %>
  <%= form.submit "Filter", class: secondary_button_class %>
  <% if params[:q].present? || params[:from].present? || params[:tag].present? %>
    <%= link_to "Clear", journal_entries_path, class: ghost_button_class %>
  <% end %>
<% end %>

<% if params[:tag].present? %>
  <p class="mt-3 text-sm text-neutral-600">Tagged <span class="font-medium text-neutral-900"><%= params[:tag] %></span></p>
<% end %>

<% if @journal_entries.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No entries yet",
      description: "Entries recorded in your ledger appear here." %>
<% else %>
  <%= render "journal_entries/table", journal_entries: @journal_entries %>
<% end %>
