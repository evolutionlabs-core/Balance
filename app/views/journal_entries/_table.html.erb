<div class="mt-4 overflow-x-auto border-y border-neutral-200">
  <table class="min-w-full">
    <thead class="sticky top-0 z-10 bg-white">
      <tr>
        <th scope="col" class="py-2.5 pr-4 text-left text-xs font-medium text-neutral-500">Description</th>
        <th scope="col" class="px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Amount</th>
        <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500">Debit</th>
        <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500">Credit</th>
        <th scope="col" class="py-2.5 pl-4 text-right text-xs font-medium text-neutral-500">Date</th>
      </tr>
    </thead>

    <% journal_entries.each do |entry| %>
      <% debit_lines = entry.journal_entry_lines.select { |line| line.debit_kobo.positive? } %>
      <% credit_lines = entry.journal_entry_lines.select { |line| line.credit_kobo.positive? } %>
      <% split = entry.journal_entry_lines.size > 2 || entry.description.to_s.length > 80 %>

      <tbody class="border-t border-neutral-200 bg-white" data-controller="<%= "row-expand" if split %>">
        <tr id="<%= dom_id(entry) %>"
            class="group transition-colors hover:bg-neutral-50/80 <%= "cursor-pointer" if split %>"
            data-action="<%= "click->row-expand#toggle" if split %>">
          <td class="max-w-sm py-3 pr-4 text-sm text-neutral-900">
            <div class="flex min-w-0 items-center gap-1.5">
              <span class="min-w-0 truncate font-medium" title="<%= entry.description %>"><%= entry.description.presence || blank_cell %></span>
              <% if split %>
                <%= inline_svg_tag "icons/chevron-right.svg", class: "h-3.5 w-3.5 flex-none text-neutral-400 transition-transform", data: { row_expand_target: "icon" } %>
              <% end %>
              <% if entry.reverses_journal_entry_id? %>
                <span class="flex-none rounded bg-neutral-100 px-1.5 py-0.5 text-[11px] font-medium text-neutral-500">Reversal</span>
              <% end %>
            </div>
          </td>
          <td class="px-4 py-3 text-right text-sm font-semibold tabular-nums whitespace-nowrap text-neutral-900"><%= naira(debit_lines.sum(&:debit_kobo)) %></td>
          <td class="max-w-52 px-4 py-3 text-sm text-neutral-700"><span class="line-clamp-2"><%= debit_lines.map { |line| line.account.name }.to_sentence %></span></td>
          <td class="max-w-52 px-4 py-3 text-sm text-neutral-700"><span class="line-clamp-2"><%= credit_lines.map { |line| line.account.name }.to_sentence %></span></td>
          <td class="py-3 pl-4 text-right text-sm tabular-nums whitespace-nowrap text-neutral-500"><%= entry.entry_date.strftime("%b %-d, %Y") %></td>
        </tr>

        <% if split %>
          <tr data-row-expand-target="detail" hidden>
            <td colspan="5" class="bg-neutral-50/80 px-4 py-3">
              <% if entry.description.to_s.length > 80 %>
                <p class="mb-3 max-w-3xl text-sm text-neutral-700"><%= entry.description %></p>
              <% end %>
              <table class="ml-auto w-full max-w-2xl">
                <thead>
                  <tr class="text-left text-[11px] font-medium uppercase tracking-wide text-neutral-400">
                    <th class="pb-1">Account</th>
                    <th class="pb-1 text-right">Debit</th>
                    <th class="pb-1 text-right">Credit</th>
                  </tr>
                </thead>
                <% entry.journal_entry_lines.each do |line| %>
                  <tr>
                    <td class="w-1/2 py-1 text-xs font-medium text-neutral-700"><%= line.account.name %></td>
                    <td class="w-1/4 py-1 text-right text-xs tabular-nums text-neutral-500"><%= naira(line.debit_kobo) if line.debit_kobo.positive? %></td>
                    <td class="w-1/4 py-1 text-right text-xs tabular-nums text-neutral-500"><%= naira(line.credit_kobo) if line.credit_kobo.positive? %></td>
                  </tr>
                <% end %>
              </table>
            </td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </table>
</div>
