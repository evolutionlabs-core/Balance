<%= render layout: "shared/mobile_list" do %>
  <% journal_entries.each do |entry| %>
    <% debit_lines = entry.journal_entry_lines.select { |line| line.debit.positive? } %>
    <% split = entry.journal_entry_lines.size > 2 || entry.description.to_s.length > 80 %>
    <article class="py-4" data-controller="<%= "row-expand" if split %>">
      <div class="flex items-start justify-between gap-4">
        <%= link_to entry.description.presence || "Entry ##{entry.number}", journal_entry_path(entry), class: "min-w-0 flex-1 text-sm font-medium text-neutral-950" %>
        <span class="shrink-0 text-sm font-semibold tabular-nums text-neutral-950"><%= money(debit_lines.sum(&:debit)) %></span>
      </div>
      <div class="mt-2 flex items-center justify-between gap-3">
        <span class="text-xs tabular-nums text-neutral-500"><%= entry.effective_date.strftime("%b %-d, %Y") %></span>
        <% if split %>
          <button type="button" class="flex min-h-11 items-center gap-1 px-1 text-sm font-medium text-balance-teal-700" data-action="row-expand#toggle" aria-expanded="false">
            Details
            <%= inline_svg_tag "icons/chevron-right.svg", class: "h-4 w-4 transition-transform", data: { row_expand_target: "icon" } %>
          </button>
        <% else %>
          <span class="truncate text-xs text-neutral-500"><%= entry.journal_entry_lines.map { |line| line.account.name }.to_sentence %></span>
        <% end %>
      </div>
      <% if entry.source_type.present? %>
        <span class="mt-1.5 inline-block rounded bg-neutral-100 px-1.5 py-0.5 text-[11px] font-medium text-neutral-500"><%= [ journal_entry_origin_label(entry), journal_entry_status_label(entry) ].compact.join(" · ") %></span>
      <% end %>
      <% if entry.tags.any? %>
        <p class="mt-1.5"><%= journal_entry_tags(entry.tags) %></p>
      <% end %>
      <% if split %>
        <div class="mt-2 overflow-x-auto rounded-md bg-neutral-50 p-3" data-row-expand-target="detail" hidden>
          <% if entry.description.to_s.length > 80 %>
            <p class="mb-3 max-w-3xl text-sm text-neutral-700"><%= entry.description %></p>
          <% end %>
          <table class="w-full min-w-72">
            <thead><tr class="text-left text-[11px] font-medium text-neutral-500"><th class="pb-2">Account</th><th class="pb-2 text-right">Debit</th><th class="pb-2 text-right">Credit</th></tr></thead>
            <tbody>
              <% entry.journal_entry_lines.each do |line| %>
                <tr class="border-t border-neutral-200">
                  <td class="py-2 pr-3 text-xs text-neutral-700"><%= line.account.name %></td>
                  <td class="py-2 text-right text-xs tabular-nums text-neutral-600"><%= money(line.debit) if line.debit.positive? %></td>
                  <td class="py-2 text-right text-xs tabular-nums text-neutral-600"><%= money(line.credit) if line.credit.positive? %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </article>
  <% end %>
<% end %>

<div class="mt-4 hidden overflow-x-auto border-y border-neutral-200 sm:block">
  <table class="min-w-full">
    <thead class="sticky top-0 z-10 bg-white">
      <tr>
        <th scope="col" class="<%= table_header_class %>">Description</th>
        <th scope="col" class="<%= table_header_class(align: :right) %>">Amount</th>
        <th scope="col" class="<%= table_header_class %>">Debit</th>
        <th scope="col" class="<%= table_header_class %>">Credit</th>
        <th scope="col" class="<%= table_header_class(align: :right) %>">Date</th>
      </tr>
    </thead>

    <% journal_entries.each do |entry| %>
      <% debit_lines = entry.journal_entry_lines.select { |line| line.debit.positive? } %>
      <% credit_lines = entry.journal_entry_lines.select { |line| line.credit.positive? } %>
      <% split = entry.journal_entry_lines.size > 2 || entry.description.to_s.length > 80 %>

      <tbody class="border-t border-neutral-200 bg-white" data-controller="<%= "row-expand" if split %>">
        <tr id="<%= dom_id(entry) %>"
            class="group transition-colors hover:bg-neutral-50 <%= "cursor-pointer" if split %>"
            data-action="<%= "click->row-expand#toggle" if split %>">
          <td class="<%= table_cell_class(strong: true) %> max-w-sm">
            <div class="flex min-w-0 items-center gap-1.5">
              <%= link_to entry.description.presence || "Entry ##{entry.number}", journal_entry_path(entry), class: "min-w-0 truncate hover:underline", title: entry.description %>
              <% if split %>
                <%= inline_svg_tag "icons/chevron-right.svg", class: "h-3.5 w-3.5 flex-none text-neutral-400 transition-transform", data: { row_expand_target: "icon" } %>
              <% end %>
            </div>
            <% if entry.source_type.present? %>
              <span class="mt-0.5 block text-[11px] font-medium text-neutral-400"><%= [ journal_entry_origin_label(entry), journal_entry_status_label(entry) ].compact.join(" · ") %></span>
            <% end %>
            <% if entry.tags.any? %>
              <span class="mt-1 block"><%= journal_entry_tags(entry.tags) %></span>
            <% end %>
          </td>
          <td class="<%= table_cell_class(align: :right, strong: true) %> tabular-nums whitespace-nowrap"><%= money(debit_lines.sum(&:debit)) %></td>
          <td class="<%= table_cell_class %> max-w-52"><span class="line-clamp-2"><%= debit_lines.map { |line| line.account.name }.to_sentence %></span></td>
          <td class="<%= table_cell_class %> max-w-52"><span class="line-clamp-2"><%= credit_lines.map { |line| line.account.name }.to_sentence %></span></td>
          <td class="<%= table_cell_class(align: :right) %> tabular-nums whitespace-nowrap"><%= entry.effective_date.strftime("%b %-d, %Y") %></td>
        </tr>

        <% if split %>
          <tr data-row-expand-target="detail" hidden>
            <td colspan="5" class="bg-neutral-50/80 px-4 py-3">
              <% if entry.description.to_s.length > 80 %>
                <p class="mb-3 max-w-3xl text-sm text-neutral-700"><%= entry.description %></p>
              <% end %>
              <table class="ml-auto w-full max-w-2xl">
                <thead>
                  <tr class="text-left text-[11px] font-medium uppercase tracking-wide text-neutral-400">
                    <th class="pb-1">Account</th>
                    <th class="pb-1 text-right">Debit</th>
                    <th class="pb-1 text-right">Credit</th>
                  </tr>
                </thead>
                <% entry.journal_entry_lines.each do |line| %>
                  <tr>
                    <td class="w-1/2 py-1 text-xs font-medium text-neutral-700"><%= line.account.name %></td>
                    <td class="w-1/4 py-1 text-right text-xs tabular-nums text-neutral-500"><%= money(line.debit) if line.debit.positive? %></td>
                    <td class="w-1/4 py-1 text-right text-xs tabular-nums text-neutral-500"><%= money(line.credit) if line.credit.positive? %></td>
                  </tr>
                <% end %>
              </table>
            </td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </table>
</div>
