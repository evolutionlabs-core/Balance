<%= form_with model: entry_form,
    url: draft.persisted? ? journal_entry_draft_path(draft) : journal_entry_drafts_path,
    method: draft.persisted? ? :patch : :post,
    scope: :entry,
    class: "flex min-h-0 flex-1 flex-col",
    data: { controller: "journal-entry-lines", action: "submit->journal-entry-lines#validate" } do |form| %>
  <%= render "shared/modal/header", title: draft.persisted? ? "Edit draft" : "New journal entry" %>

  <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5">
    <%= render "shared/form_errors", record: entry_form %>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-[0.8fr_1.6fr]">
      <div>
        <%= form.label :effective_date, "Date", class: field_label_class %>
        <%= form.text_field :effective_date,
            value: entry_form.effective_date || Date.current,
            required: true,
            autocomplete: "off",
            class: "#{field_class} cursor-pointer",
            data: { controller: "date-picker" } %>
      </div>

      <div>
        <%= form.label :description, class: field_label_class %>
        <%= form.text_field :description,
            required: true,
            placeholder: "What happened?",
            autocomplete: "off",
            class: field_class %>
      </div>
    </div>

    <div class="mt-6">
      <div class="hidden grid-cols-[minmax(13rem,2fr)_minmax(8rem,1fr)_minmax(8rem,1fr)_4.5rem] gap-2 border-b border-neutral-200 pb-2 sm:grid">
        <span class="text-xs font-medium text-neutral-500">Account</span>
        <span class="text-xs font-medium text-neutral-500">Debit</span>
        <span class="text-xs font-medium text-neutral-500">Credit</span>
        <span></span>
      </div>

      <div data-journal-entry-lines-target="lines">
        <% entry_form.lines.each_with_index do |_line, index| %>
          <%= form.fields_for :lines, entry_form.lines[index], index: index do |line_form| %>
            <%= render "journal_entries/line_fields", form: line_form, protected: index < 2 %>
          <% end %>
        <% end %>
      </div>

      <template data-journal-entry-lines-target="template">
        <%= form.fields_for :lines, JournalEntries::ManualEntry::Line.new, index: "__INDEX__" do |line_form| %>
          <%= render "journal_entries/line_fields", form: line_form, protected: false %>
        <% end %>
      </template>

      <button type="button" data-action="journal-entry-lines#addLine" class="mt-3 <%= secondary_button_class(size: :sm) %>">
        <%= inline_svg_tag "icons/plus.svg", class: "h-3.5 w-3.5" %>Add line
      </button>

      <div class="mt-5 grid gap-3 border-t border-neutral-200 pt-4 sm:grid-cols-3">
        <div>
          <p class="text-xs text-neutral-500">Total debits</p>
          <p class="mt-0.5 font-semibold tabular-nums text-neutral-900" data-journal-entry-lines-target="debitTotal">0.00</p>
        </div>
        <div>
          <p class="text-xs text-neutral-500">Total credits</p>
          <p class="mt-0.5 font-semibold tabular-nums text-neutral-900" data-journal-entry-lines-target="creditTotal">0.00</p>
        </div>
        <div class="sm:text-right">
          <p class="text-xs text-neutral-500">Difference</p>
          <p class="mt-0.5 font-semibold tabular-nums text-neutral-900" data-journal-entry-lines-target="difference">0.00</p>
        </div>
      </div>

      <p class="mt-3 text-xs text-neutral-500" data-journal-entry-lines-target="status">Choose an account and enter either a debit or credit on each required line.</p>
    </div>
  </div>

  <div class="flex shrink-0 items-center justify-between gap-3 border-t border-neutral-200 bg-neutral-50/60 px-6 py-4">
    <p class="hidden text-xs text-neutral-500 sm:block">You can review before anything is posted.</p>
    <div class="ml-auto flex gap-2">
      <button type="button" data-action="modal#close" class="<%= secondary_button_class %>">Cancel</button>
      <%= button_tag "Save draft", type: "submit", name: "intent", value: "draft", formnovalidate: true,
          class: secondary_button_class, data: { journal_entry_lines_target: "draftButton" } %>
      <%= button_tag "Review", type: "submit", name: "intent", value: "review", disabled: true,
          class: "#{primary_button_class} disabled:cursor-not-allowed disabled:bg-neutral-200 disabled:text-neutral-400",
          data: { journal_entry_lines_target: "submit" } %>
    </div>
  </div>
<% end %>
