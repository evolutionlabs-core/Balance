<% content_for :title, title %>
<% content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Reports" }, { label: title } ] %>
<% end %>

<%= render "shared/page_header",
    title: title,
    description: "#{description} As of #{Date.current.strftime("%b %-d, %Y")}." %>

<% if aging.nil? %>
  <%= render "shared/empty_state",
      icon: "icons/gauge.svg",
      title: "No accounts yet",
      description: "This report appears here once your chart of accounts is provisioned." %>
<% else %>
  <% totals = aging.bucket_totals %>
  <% total = aging.total_kobo %>
  <% overdue = total - totals[:current] %>
  <% overdue_buckets = AgingHelper::AGING_BUCKETS.except(:current) %>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
    <% [ [ total_label, total, "text-neutral-950", "col-span-2 sm:col-span-1" ],
         [ "Not due yet", totals[:current], "text-neutral-950", "" ],
         [ "Overdue", overdue, overdue.positive? ? "text-red-700" : "text-neutral-950", "" ] ].each do |label, amount, tone, span| %>
      <div class="min-w-0 rounded-xl border border-neutral-200 bg-white p-4 sm:p-5 <%= span %>">
        <p class="text-sm font-medium text-neutral-500"><%= label %></p>
        <p class="mt-2 truncate text-lg font-semibold tracking-tight tabular-nums sm:text-2xl <%= tone %>"><%= aging_money(amount) %></p>
      </div>
    <% end %>
  </div>

  <% if total.positive? %>
    <section class="mt-3 rounded-xl border border-neutral-200 bg-white p-5" aria-labelledby="aging-breakdown-heading">
      <h2 id="aging-breakdown-heading" class="text-sm font-medium text-neutral-500">How overdue it is</h2>
      <div class="mt-4 flex h-2 gap-0.5 overflow-hidden rounded-full bg-neutral-100" aria-hidden="true">
        <% AgingHelper::AGING_BUCKETS.each do |bucket, style| %>
          <% if totals[bucket].positive? %>
            <span class="h-full" style="width: <%= aging_share(totals[bucket], total) %>%; background-color: <%= style[:color] %>"></span>
          <% end %>
        <% end %>
      </div>
      <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-5">
        <% AgingHelper::AGING_BUCKETS.each do |bucket, style| %>
          <div class="flex items-center justify-between gap-3 sm:block">
            <dt class="flex items-center gap-1.5 whitespace-nowrap text-neutral-500">
              <span class="size-2 flex-none rounded-full" style="background-color: <%= style[:color] %>" aria-hidden="true"></span>
              <%= style[:short] %><span class="sr-only"><%= " overdue" unless bucket == :current %></span>
            </dt>
            <dd class="font-medium tabular-nums <%= totals[bucket].zero? ? "text-neutral-400" : "text-neutral-900" %> sm:mt-1 sm:pl-3.5"><%= aging_money(totals[bucket]) %></dd>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>

  <section class="mt-6" aria-labelledby="aging-by-party-heading">
    <h2 id="aging-by-party-heading" class="text-base font-medium text-neutral-900">By <%= counterparty.downcase %></h2>

    <% if aging.rows.empty? %>
      <p class="mt-3 rounded-md border border-dashed border-neutral-200 bg-white px-4 py-8 text-center text-sm text-neutral-500"><%= empty %></p>
    <% else %>
      <div class="mt-3 divide-y divide-neutral-200 border-y border-neutral-200 sm:hidden">
        <% aging.rows.each do |row| %>
          <% oldest = aging_oldest_bucket(row) %>
          <article class="py-4">
            <div class="flex items-start justify-between gap-4">
              <span class="min-w-0 flex-1 truncate text-sm font-medium text-neutral-950"><%= row.counterparty&.name || "Unassigned" %></span>
              <span class="shrink-0 text-sm font-semibold tabular-nums text-neutral-950"><%= aging_money(row.total_kobo) %></span>
            </div>
            <div class="mt-2 flex items-center justify-between gap-3 text-xs text-neutral-500">
              <%= aging_bucket_label(oldest) %>
              <% if row.counterparty %>
                <%= link_to "View", polymorphic_path(row.counterparty), class: "flex min-h-11 shrink-0 items-center px-1 text-sm font-medium text-[#0f7082]" %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>

      <div class="mt-3 hidden overflow-x-auto border-y border-neutral-200 sm:block">
        <table class="min-w-full">
          <thead class="bg-white">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500"><%= counterparty %></th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Most overdue</th>
              <% [ "Not due yet", "Overdue", "Total" ].each do |label| %>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500"><%= label %></th>
              <% end %>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            <% aging.rows.each do |row| %>
              <% not_due = row.buckets[:current] %>
              <% overdue_amount = row.total_kobo - not_due %>
              <tr class="border-t border-neutral-200 transition-colors hover:bg-neutral-50">
                <th scope="row" class="px-4 py-4 text-left text-sm font-medium whitespace-nowrap text-neutral-900"><%= row.counterparty&.name || "Unassigned" %></th>
                <td class="px-4 py-4 text-sm whitespace-nowrap text-neutral-600"><%= aging_bucket_label(aging_oldest_bucket(row)) %></td>
                <td class="px-4 py-4 text-right text-sm tabular-nums whitespace-nowrap <%= not_due.zero? ? "text-neutral-300" : "text-neutral-600" %>"><%= not_due.zero? ? "—" : aging_money(not_due) %></td>
                <td class="px-4 py-4 text-right text-sm tabular-nums whitespace-nowrap <%= overdue_amount.zero? ? "text-neutral-300" : "text-neutral-900" %>"><%= overdue_amount.zero? ? "—" : aging_money(overdue_amount) %></td>
                <td class="px-4 py-4 text-right text-sm font-medium tabular-nums whitespace-nowrap text-neutral-900"><%= aging_money(row.total_kobo) %></td>
                <td class="px-4 py-4 text-right text-sm">
                  <% if row.counterparty %>
                    <%= link_to "View", polymorphic_path(row.counterparty), class: "font-medium text-[#0f7082] hover:underline" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <% unless aging.tied_out? %>
    <div id="tie-out" class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <p class="font-medium">This doesn't match your books</p>
      <p class="mt-1">
        <%= control_account %> is <%= aging_money(aging.ledger_kobo) %>, but unpaid <%= documents %> add up to <%= aging_money(aging.total_kobo) %>.
        Usually a journal entry touched <%= control_account %> directly. Check these:
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% aging.unmatched_rows.each do |row| %>
          <li><%= row.counterparty&.name || "Entries with no #{counterparty.downcase}" %>: books <%= aging_money(row.ledger_kobo) %>, <%= documents %> <%= aging_money(row.total_kobo) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>
