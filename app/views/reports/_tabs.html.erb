<% tabs = [ [ "Balance sheet", :balance_sheet, balance_sheet_path ], [ "Income statement", :income_statement, income_statement_path ], [ "Receivables", :aged_receivables, aged_receivables_path ] ] %>
<% tabs << [ "Payables", :aged_payables, aged_payables_path ] if current_workspace.business? %>
<nav class="inline-flex w-full overflow-x-auto rounded-lg bg-neutral-100 p-1 sm:w-auto" aria-label="Reports">
  <% tabs.each do |label, key, path| %>
    <%= link_to label, path, aria: { current: active == key ? "page" : nil },
        class: "flex min-h-11 flex-none items-center justify-center whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium transition-colors sm:px-4 #{active == key ? 'bg-white text-neutral-950 shadow-sm' : 'text-neutral-500 hover:text-neutral-950'}" %>
  <% end %>
</nav>
