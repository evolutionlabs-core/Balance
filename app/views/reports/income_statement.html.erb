<% content_for :title, "Income statement" %>
<% content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Reports" }, { label: "Income statement" } ] %>
<% end %>

<%= render "shared/page_header",
    title: "Income statement",
    description: current_workspace.personal? ? "What came in and what went out over a period." : "Revenue, costs, and profit over a period." %>

<% if @statement.nil? %>
  <%= render "shared/empty_state",
      icon: "icons/gauge.svg",
      title: "No accounts yet",
      description: "Your income statement appears here once your chart of accounts is provisioned." %>
<% else %>
  <%= render "statement", statement: @statement,
        title: current_workspace.personal? ? "Income and Spending" : "Profit and Loss",
        subtitle: "For #{@statement.columns.first.label}" %>
<% end %>
