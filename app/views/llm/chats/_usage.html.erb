<% usage = ChatUsage.new(llm_chat) %>
<% model = llm_chat.model %>

<div data-controller="menu" class="relative">
  <button type="button" data-menu-target="button" data-action="menu#toggle" class="<%= icon_button_class %>">
    <span class="sr-only">Usage and model details</span>
    <%= inline_svg_tag "icons/gauge.svg", class: "h-4 w-4" %>
  </button>

  <div data-menu-target="menu" class="hidden w-80 max-w-[calc(100vw-1rem)] rounded-md border border-neutral-200 bg-white p-4 text-left shadow-md">
    <p class="text-xs font-medium tracking-wide text-neutral-400 uppercase">This chat</p>

    <% if usage.context_percentage %>
      <div class="mt-2.5">
        <div class="flex items-baseline justify-between gap-2 text-sm">
          <span class="text-neutral-500">Context</span>
          <span class="font-medium tabular-nums text-neutral-900">
            <%= number_with_delimiter usage.context_used %> / <%= number_with_delimiter usage.context_window %>
          </span>
        </div>

        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-neutral-100">
          <div class="h-full rounded-full <%= usage.context_percentage >= 90 ? "bg-red-500" : "bg-neutral-900" %>" style="width: <%= usage.context_percentage %>%"></div>
        </div>

        <p class="mt-1 text-xs text-neutral-400"><%= usage.context_percentage %>% of the window used by the last turn</p>
      </div>
    <% end %>

    <dl class="mt-2.5 flex flex-col gap-1.5">
      <% if usage.reported? %>
        <div class="flex items-baseline justify-between gap-2 text-sm">
          <dt class="text-neutral-500">Tokens in</dt>
          <dd class="font-medium tabular-nums text-neutral-900"><%= number_with_delimiter usage.input_tokens %></dd>
        </div>

        <div class="flex items-baseline justify-between gap-2 text-sm">
          <dt class="text-neutral-500">Tokens out</dt>
          <dd class="font-medium tabular-nums text-neutral-900"><%= number_with_delimiter usage.output_tokens %></dd>
        </div>

        <% if usage.cached_tokens.positive? %>
          <div class="flex items-baseline justify-between gap-2 text-sm">
            <dt class="text-neutral-500">Cached</dt>
            <dd class="font-medium tabular-nums text-neutral-900"><%= number_with_delimiter usage.cached_tokens %></dd>
          </div>
        <% end %>

        <div class="flex items-baseline justify-between gap-2 border-t border-neutral-200 pt-1.5 text-sm">
          <dt class="text-neutral-500">Cost</dt>
          <dd class="font-medium tabular-nums text-neutral-900">
            <%= usage.cost ? number_to_currency(usage.cost, precision: 4) : blank_cell %>
          </dd>
        </div>
      <% else %>
        <p class="text-sm text-neutral-400">This provider hasn't reported token usage for these messages.</p>
      <% end %>
    </dl>

    <p class="mt-4 border-t border-neutral-200 pt-3 text-xs font-medium tracking-wide text-neutral-400 uppercase">Model</p>

    <dl class="mt-2.5 flex flex-col gap-1.5">
      <div class="flex items-baseline justify-between gap-3 text-sm">
        <dt class="flex-none text-neutral-500">Name</dt>
        <dd class="min-w-0 truncate font-medium text-neutral-900"><%= model&.label || default_model_display_name %></dd>
      </div>

      <% if model %>
        <div class="flex items-baseline justify-between gap-3 text-sm">
          <dt class="flex-none text-neutral-500">Provider</dt>
          <dd class="min-w-0 truncate font-medium text-neutral-900"><%= model.provider_class&.display_name || model.provider %></dd>
        </div>

        <div class="flex items-baseline justify-between gap-3 text-sm">
          <dt class="flex-none text-neutral-500">Context window</dt>
          <dd class="font-medium tabular-nums text-neutral-900"><%= model.context_window ? number_with_delimiter(model.context_window) : blank_cell %></dd>
        </div>

        <div class="flex items-baseline justify-between gap-3 text-sm">
          <dt class="flex-none text-neutral-500">Max output</dt>
          <dd class="font-medium tabular-nums text-neutral-900"><%= model.max_output_tokens ? number_with_delimiter(model.max_output_tokens) : blank_cell %></dd>
        </div>

        <div class="flex items-baseline justify-between gap-3 text-sm">
          <dt class="flex-none text-neutral-500">Per 1M tokens</dt>
          <dd class="font-medium tabular-nums text-neutral-900">
            <% if usage.priced? %>
              <%= number_to_currency model.price(:input) %> in · <%= number_to_currency model.price(:output) %> out
            <% else %>
              <%= blank_cell %>
            <% end %>
          </dd>
        </div>

        <%= link_to "View model", model_path(model), class: "mt-1.5 text-sm font-medium text-neutral-900 hover:underline", data: { turbo_frame: "modal" } %>
      <% end %>
    </dl>
  </div>
</div>
