<% details = {
     "Provider" => llm_model.provider_class&.display_name || llm_model.provider,
     "Model" => llm_model.name,
     "ID" => llm_model.model_id,
     "Context window" => (number_with_delimiter(llm_model.context_window) if llm_model.context_window),
     "Max output tokens" => (number_with_delimiter(llm_model.max_output_tokens) if llm_model.max_output_tokens),
     "Input per 1M tokens" => (number_to_currency(llm_model.price(:input)) if llm_model.price(:input)),
     "Output per 1M tokens" => (number_to_currency(llm_model.price(:output)) if llm_model.price(:output)),
     "Knowledge cutoff" => llm_model.knowledge_cutoff&.strftime("%b %Y")
   } %>

<dl class="flex flex-col gap-3">
  <% details.each do |label, value| %>
    <div class="flex items-baseline justify-between gap-4 text-sm">
      <dt class="flex-none text-neutral-500"><%= label %></dt>
      <dd class="min-w-0 truncate font-medium tabular-nums text-neutral-900"><%= value.presence || blank_cell %></dd>
    </div>
  <% end %>
</dl>

<% if llm_model.capabilities.any? %>
  <div class="mt-5 border-t border-neutral-200 pt-4">
    <p class="text-xs font-medium tracking-wide text-neutral-400 uppercase">Capabilities</p>

    <div class="mt-2 flex flex-wrap gap-1.5">
      <% llm_model.capabilities.each do |capability| %>
        <span class="rounded-full border border-neutral-200 px-2.5 py-0.5 text-xs font-medium text-neutral-700"><%= capability.to_s.humanize %></span>
      <% end %>
    </div>
  </div>
<% end %>
