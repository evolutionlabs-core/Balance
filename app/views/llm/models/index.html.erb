<% content_for :title, "Models" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Models" } ] %>
<% end %>

<%= render "shared/page_header",
    title: "Models",
    description: "Manage the models available to Balance.",
    action: button_to("Refresh list", model_catalog_path, method: :patch, class: secondary_button_class(size: :compact)) %>

<% if @llm_models.any? %>
  <%= render layout: "shared/table", locals: { columns: [ { label: "Provider" }, { label: "Model" }, { label: "Context window" }, { label: "Per 1M tokens (in / out)" }, { label: "", class: "w-24" } ] } do %>
    <%= render partial: "llm/models/model", collection: @llm_models, as: :model, locals: { persisted_ids: @persisted_ids } %>
  <% end %>
<% else %>
  <%= render "shared/empty_state",
      icon: "icons/message-circle.svg",
      title: "No models found",
      description: "Balance could not reach any provider. Check your API keys, then refresh the list.",
      action: button_to("Refresh list", model_catalog_path, method: :patch, class: primary_button_class) %>
<% end %>
