<% content_for :title, @llm_model.name %>

<% if turbo_frame_request? %>
  <%= render "shared/modal", width_class: "max-w-lg" do %>
    <%= render "shared/modal/header", title: @llm_model.name %>

    <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4">
      <%= render "llm/models/details", llm_model: @llm_model %>
    </div>

    <div class="flex shrink-0 justify-end gap-3 border-t border-neutral-200 px-5 py-3">
      <button type="button" data-action="modal#close" class="<%= secondary_button_class %>">Close</button>
    <%= link_to "Start an agent", chats_path(model: @llm_model.model_id), class: primary_button_class, data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
<% else %>
  <%= content_for(:breadcrumb) do %>
    <%= render "shared/breadcrumb", data: [ { label: "Models", path: models_path }, { label: @llm_model.name } ] %>
  <% end %>

  <%= render "shared/page_header",
      title: @llm_model.name,
      description: "#{@llm_model.provider_class&.name || @llm_model.provider} · #{@llm_model.model_id}",
      action: link_to("Start an agent", chats_path(model: @llm_model.model_id), class: primary_button_class) %>

  <div class="mt-4 max-w-2xl rounded-md border border-neutral-200 bg-white p-5">
    <%= render "llm/models/details", llm_model: @llm_model %>
  </div>
<% end %>
