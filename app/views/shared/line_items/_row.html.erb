<% form_id = "new_#{scope}_form" %>
<% input_class = "block min-h-11 w-full rounded-md border border-transparent bg-transparent px-2 text-base focus:border-neutral-300 focus:bg-white sm:h-9 sm:min-h-0 sm:text-sm" %>
<% mobile_label_class = "mb-1 block text-xs font-medium text-neutral-500 sm:hidden" %>
<tr id="new_<%= scope %>_line_<%= index %>" class="line-item border-t border-neutral-200 hover:bg-neutral-50/80" data-controller="service-line">
  <td class="line-item-number px-4 py-3 text-center text-sm text-neutral-500"></td>
  <%= fields_for "#{attributes_name}[#{index}]", line, include_id: false do |form| %>
    <td class="px-2 py-2">
      <% services = @services.select { |service| service.active? || service.id == line.service_id } %>
      <% options = services.map { |service| [ service.name, service.id, { data: { description: service.description.presence || service.name, rate: service.default_rate&.to_s("F") } } ] } %>
      <%= form.label :service_id, "Service", class: mobile_label_class %>
      <%= render "shared/select_menu", form: form, attribute: :service_id,
          options: options_for_select(options, line.service_id), prompt: "No service", include_blank_option: true,
          select_data: { service_line_target: "service", action: "change->service-line#applyDefaults" }, form_id: form_id,
          searchable: true, search_placeholder: "Search services…", empty_message: "No services found", required: false %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :description, "Description", class: mobile_label_class %>
      <%= form.text_field :description, form: form_id, placeholder: "Description", autocomplete: "off",
          data: { service_line_target: "description" }, class: input_class %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :quantity, class: mobile_label_class %>
      <%= form.number_field :quantity, form: form_id, min: 0.001, step: 0.001, placeholder: "1", inputmode: "decimal", aria: { label: "Quantity" },
          data: { service_line_target: "quantity", action: "input->service-line#calculateAmount change->form#submit" },
          class: "#{input_class} text-right tabular-nums" %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :rate, class: mobile_label_class %>
      <%= form.number_field :rate, form: form_id, min: 0, step: 0.01, placeholder: "0.00", inputmode: "decimal", aria: { label: "Rate" },
          data: { action: "input->service-line#calculateAmount change->form#submit", service_line_target: "rate" },
          class: "#{input_class} text-right tabular-nums" %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :amount, class: mobile_label_class %>
      <%= form.number_field :amount, form: form_id, min: 0, step: 0.01, inputmode: "decimal", aria: { label: "Amount" },
          data: { service_line_target: "amount", document_editor_target: "amount", action: "input->document-editor#calculateTotals change->form#submit" },
          class: "#{input_class} text-right font-medium tabular-nums" %>
    </td>
    <td class="px-2 py-2 text-right">
      <% unless local_assigns[:first] || index.to_s == "0" %>
        <%= button_tag form: form_id, formaction: remove_path, formmethod: :post,
            name: :_method, value: :delete, formnovalidate: true, class: icon_button_class do %>
          <span class="sr-only">Remove line</span>
          <%= inline_svg_tag "icons/trash.svg", class: "h-4 w-4" %>
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>
