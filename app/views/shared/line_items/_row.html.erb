<% form_id = "new_#{scope}_form" %>
<% input_class = "block min-h-11 w-full rounded-md border border-transparent bg-transparent px-2 text-base focus:border-neutral-300 focus:bg-white sm:h-9 sm:min-h-0 sm:text-sm" %>
<% mobile_label_class = "mb-1 block text-xs font-medium text-neutral-500 sm:hidden" %>
<tr id="new_<%= scope %>_line_<%= index %>" class="line-item border-t border-neutral-200 hover:bg-neutral-50/80" data-controller="service-line" data-service-line-catalog-value="<%= scope %>_service_catalog">
  <td class="line-item-number px-4 py-3 text-center text-sm text-neutral-500"></td>
  <%= fields_for "#{attributes_name}[#{index}]", line, include_id: false do |form| %>
    <td class="px-2 py-2">
      <% service = @services.find { |service| service.id == line.service_id } if line.service_id %>
      <%= form.label :description, "Item or description", class: mobile_label_class %>
      <div class="relative">
        <%= form.hidden_field :service_id, form: form_id, data: { service_line_target: "service" } %>
        <%= form.text_field :description, form: form_id, placeholder: "Item or description", autocomplete: "off",
            role: "combobox", aria: { label: "Item or description", expanded: false, autocomplete: "list", haspopup: "listbox" },
            data: { service_line_target: "description", action: "focus->service-line#search input->service-line#search keydown->service-line#navigate blur->service-line#close" },
            class: input_class %>
        <ul hidden role="listbox" data-service-line-target="menu"
            class="absolute left-0 z-30 mt-1 max-h-64 w-full min-w-64 overflow-auto rounded-md border border-neutral-200 bg-white p-1 shadow-lg"></ul>
      </div>
      <p class="mt-1 flex items-center gap-1 px-2 text-xs text-neutral-500" data-service-line-target="link" <%= "hidden" unless service %>>
        <span data-service-line-target="linkName"><%= service&.name %></span>
        <button type="button" class="cursor-pointer rounded px-1 hover:bg-neutral-100 hover:text-neutral-900" aria-label="Remove service" data-action="service-line#unlink">×</button>
      </p>
    </td>
    <td class="px-2 py-2">
      <%= form.label :quantity, class: mobile_label_class %>
      <%= form.number_field :quantity, value: line.quantity&.to_s("F")&.delete_suffix(".0"), form: form_id, min: 0.001, step: 0.001, placeholder: "1", inputmode: "decimal", aria: { label: "Quantity" },
          data: { service_line_target: "quantity", action: "input->service-line#calculateAmount change->form#submit" },
          class: "#{input_class} text-right tabular-nums" %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :rate, class: mobile_label_class %>
      <%= form.number_field :rate, value: money_input_value(line.rate), form: form_id, min: 0, step: 0.01, placeholder: "0.00", inputmode: "decimal", aria: { label: "Rate" },
          data: { action: "input->service-line#calculateAmount blur->service-line#formatMoney change->form#submit", service_line_target: "rate" },
          class: "#{input_class} text-right tabular-nums" %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :amount, class: mobile_label_class %>
      <%= form.number_field :amount, value: money_input_value(line.amount), form: form_id, min: 0, step: 0.01, placeholder: "0.00", inputmode: "decimal", aria: { label: "Amount" },
          data: { service_line_target: "amount", document_editor_target: "amount", action: "input->document-editor#calculateTotals blur->service-line#formatMoney change->form#submit" },
          class: "#{input_class} text-right font-medium tabular-nums" %>
    </td>
    <td class="px-2 py-2 text-right">
      <%= button_tag form: form_id, formaction: remove_path, formmethod: :post,
          name: :_method, value: :delete, formnovalidate: true, class: icon_button_class do %>
        <span class="sr-only">Remove line</span>
        <%= inline_svg_tag "icons/trash.svg", class: "h-4 w-4" %>
      <% end %>
    </td>
  <% end %>
</tr>
