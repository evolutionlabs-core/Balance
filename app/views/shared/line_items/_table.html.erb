<% header_class = "px-4 py-2.5 text-xs font-medium text-neutral-500" %>
<%= turbo_frame_tag "#{scope}_line_items", class: "block" do %>
  <% catalog = @services.select(&:active?).map { |service| { id: service.id, name: service.name, description: service.description.to_s, rate: service.default_rate&.to_s("F") } } %>
  <script type="application/json" id="<%= scope %>_service_catalog"><%= raw json_escape(catalog.to_json) %></script>
  <div class="border-y border-neutral-200">
    <table class="line-item-editor w-full">
      <thead class="bg-white">
        <tr>
          <th scope="col" class="w-14 text-center <%= header_class %>">#</th>
          <th scope="col" class="text-left <%= header_class %>">Item or description</th>
          <th scope="col" class="w-28 text-right <%= header_class %>">Qty</th>
          <th scope="col" class="w-40 text-right <%= header_class %>">Rate (<%= document.currency_code %>)</th>
          <th scope="col" class="w-40 text-right <%= header_class %>">Amount (<%= document.currency_code %>)</th>
          <th scope="col" class="w-12 px-4 py-2.5"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>

      <tbody id="<%= scope %>_lines" class="line-items bg-white">
        <%= yield %>
      </tbody>
    </table>
  </div>

  <div class="mt-3">
    <%= link_to add_path, class: secondary_button_class(size: :sm), data: { turbo_stream: true } do %>
      <%= inline_svg_tag "icons/plus.svg", class: "h-3.5 w-3.5" %><%= add_label %>
    <% end %>
  </div>

  <% unless local_assigns[:totals] == false %>
    <%= render "shared/line_items/summary", document: document, scope: scope, discount: local_assigns[:discount] %>
  <% end %>
<% end %>
