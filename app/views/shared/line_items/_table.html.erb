<% header_class = "px-4 py-2.5 text-xs font-medium text-neutral-500" %>
<%= turbo_frame_tag "#{scope}_line_items", class: "block" do %>
  <div class="border-y border-neutral-200">
    <table class="line-item-editor w-full">
      <thead class="bg-white">
        <tr>
          <th scope="col" class="w-14 text-center <%= header_class %>">#</th>
          <th scope="col" class="w-48 text-left <%= header_class %>">Service (optional)</th>
          <th scope="col" class="text-left <%= header_class %>">Description</th>
          <th scope="col" class="w-28 text-right <%= header_class %>">Qty</th>
          <th scope="col" class="w-40 text-right <%= header_class %>">Rate (<%= document.currency_code %>)</th>
          <th scope="col" class="w-40 text-right <%= header_class %>">Amount (<%= document.currency_code %>)</th>
          <th scope="col" class="w-12 px-4 py-2.5"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>

      <tbody id="<%= scope %>_lines" class="line-items bg-white">
        <%= yield %>
      </tbody>
    </table>
  </div>

  <div class="mt-3">
    <%= link_to add_path, class: secondary_button_class(size: :sm), data: { turbo_stream: true } do %>
      <%= inline_svg_tag "icons/plus.svg", class: "h-3.5 w-3.5" %><%= add_label %>
    <% end %>
  </div>

  <div class="mt-8 ml-auto max-w-sm border-t border-neutral-200 pt-4">
    <div class="flex items-center justify-between text-sm">
      <span class="text-neutral-500">Subtotal</span>
      <span id="<%= scope %>_subtotal" class="font-medium tabular-nums text-neutral-950" data-document-editor-target="total"><%= minor_currency(document.subtotal_minor, document.currency_code) %></span>
    </div>
    <div class="mt-3 flex items-center justify-between border-t border-neutral-200 pt-3">
      <span class="font-semibold text-neutral-950">Total</span>
      <span id="<%= scope %>_total" class="text-xl font-semibold tabular-nums text-neutral-950" data-document-editor-target="total"><%= minor_currency(document.total_minor, document.currency_code) %></span>
    </div>
  </div>
<% end %>
