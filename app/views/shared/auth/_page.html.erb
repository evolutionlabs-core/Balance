<div class="onboarding-enter w-full max-w-md">
  <div class="mb-7 flex justify-center">
    <div class="flex flex-col items-center gap-1.5">
      <%= render "shared/brand", compact: false %>
      <span class="text-center text-3xl font-bold tracking-tight text-neutral-950">Balance</span>
    </div>
  </div>

  <div class="space-y-5">
    <div class="flex flex-col gap-y-1">
      <h1 class="text-3xl font-medium tracking-tight text-neutral-950"><%= title %></h1>
      <p class="text-sm leading-6 text-neutral-500"><%= description %></p>
    </div>

    <%= yield %>

    <div class="flex items-center <%= Array(links).one? ? "justify-center" : "justify-between" %> gap-3 pt-1 text-sm">
      <% Array(links).each do |link| %>
        <%= link_to link[:label], link[:path], class: link[:emphasis] ? "font-medium text-neutral-900 hover:underline" : "text-neutral-500 transition-colors hover:text-neutral-900" %>
      <% end %>
    </div>
  </div>
</div>
