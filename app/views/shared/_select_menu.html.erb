<% compact = local_assigns.fetch(:compact, false) %>
<% include_blank_option = local_assigns.fetch(:include_blank_option, false) %>
<% required = local_assigns.fetch(:required, true) %>
<% searchable = local_assigns.fetch(:searchable, false) %>
<% search_in_trigger = local_assigns.fetch(:search_in_trigger, searchable) %>
<% search_placeholder = local_assigns.fetch(:search_placeholder, "Search…") %>
<% empty_message = local_assigns.fetch(:empty_message, "No options found") %>
<% footer_label = local_assigns[:footer_label] %>
<% footer_url = local_assigns[:footer_url] %>
<% form_id = local_assigns[:form_id] %>

<div class="relative <%= compact ? "inline-flex" : "" %>"
     data-controller="select-menu"
     data-select-menu-compact-value="<%= compact %>"
     data-select-menu-include-blank-value="<%= include_blank_option %>"
     data-select-menu-searchable-value="<%= searchable %>"
     data-select-menu-search-in-trigger-value="<%= search_in_trigger %>"
     data-select-menu-search-placeholder-value="<%= search_placeholder %>"
     data-select-menu-empty-message-value="<%= empty_message %>"
     data-select-menu-footer-label-value="<%= footer_label %>"
     data-select-menu-footer-url-value="<%= footer_url %>"
     data-action="select-menu:refresh->select-menu#refresh">
  <%= form.select attribute, options, { prompt: prompt },
      required: required,
      class: "sr-only",
      form: form_id,
      data: select_data.merge(select_menu_target: "native") %>

  <% if search_in_trigger %>
    <div class="relative">
      <input type="search"
             placeholder="<%= prompt %>"
             autocomplete="off"
             class="h-10 w-full rounded-md border border-neutral-300 bg-white px-3 pr-9 text-sm text-neutral-950 transition-colors outline-none placeholder:text-neutral-400 hover:border-neutral-400 focus:border-[#0f7082] focus:ring-1 focus:ring-[#0f7082]"
             role="combobox"
             aria-expanded="false"
             aria-haspopup="listbox"
             data-select-menu-target="button label"
             data-action="click->select-menu#openFromInput input->select-menu#search">
      <svg class="pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-neutral-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  <% else %>
    <button type="button"
            class="flex items-center justify-between gap-2 rounded-md text-left transition-colors focus:outline-none <%= compact ? "max-w-[15rem] px-2 py-1.5 text-xs font-medium text-neutral-500 hover:bg-neutral-100 hover:text-neutral-950" : "h-10 w-full border border-neutral-300 bg-white px-3 text-sm text-neutral-950 hover:border-neutral-400 focus:border-[#0f7082] focus:ring-1 focus:ring-[#0f7082]" %>"
            role="combobox"
            aria-expanded="false"
            aria-haspopup="listbox"
            data-select-menu-target="button"
            data-action="select-menu#toggle">
      <span class="truncate text-neutral-400" data-select-menu-target="label"><%= prompt %></span>
      <svg class="h-4 w-4 flex-none text-neutral-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  <% end %>

  <div class="fixed z-[60] hidden overflow-hidden rounded-md border border-neutral-200 bg-white p-1 shadow-lg"
       data-select-menu-target="menu"></div>
</div>
