<%= turbo_frame_tag "modal" do %>
  <dialog data-controller="modal"
       data-action="keydown->modal#keydown click->modal#clickOutside"
       class="fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none items-end justify-center overflow-y-auto border-0 bg-transparent p-0 open:flex sm:p-4">
    <div data-modal-target="backdrop"
         class="fixed inset-0 bg-neutral-950/45 opacity-0 backdrop-blur-[2px] transition-opacity duration-200 ease-out motion-reduce:transition-none"></div>

    <div data-modal-target="panel"
         class="relative z-10 flex max-h-[92vh] w-full <%= local_assigns.fetch(:width_class, "max-w-md") %> translate-y-4 scale-[0.98] flex-col overflow-hidden rounded-t-2xl border border-neutral-200 bg-white opacity-0 shadow-2xl transition duration-200 ease-out sm:translate-y-2 sm:rounded-xl motion-reduce:transition-none">
      <%= yield %>
    </div>
  </dialog>
<% end %>
