<div aria-label="sidenav" class="flex h-full w-full flex-col py-3">
  <div class="flex h-12 items-center gap-2 px-3">
    <div class="min-w-0 flex-1 overflow-hidden px-2 lg:group-data-[rail=collapsed]/sidebar:hidden">
      <%= render "shared/brand", compact: true, sidebar: true %>
    </div>

    <button type="button" data-sidebar-target="panelButton" data-action="sidebar#togglePanel" aria-expanded="true" aria-label="Collapse sidebar" class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center rounded-lg text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-900">
      <%= inline_svg_tag "icons/panel-left.svg", class: "h-4 w-4" %>
    </button>
  </div>

  <nav aria-label="Primary" class="flex flex-1 flex-col gap-5 overflow-y-auto px-3 pt-2" data-action="click->sidebar#closeOnNavigate">
    <% navigation_sections.each do |section| %>
      <div>
        <% if section[:label] %>
          <p class="px-3 pb-1 text-xs font-medium text-neutral-500 lg:group-data-[rail=collapsed]/sidebar:hidden"><%= section[:label] %></p>
        <% end %>

        <ul role="list" class="flex flex-col gap-1">
          <%= render partial: "shared/sidebar/nav", collection: section[:items], as: :item %>
        </ul>
      </div>
    <% end %>
  </nav>

  <div data-controller="menu" data-menu-match-trigger-width-value="true" data-action="keydown->menu#dismiss" class="relative mt-2 px-3">
    <button type="button" data-menu-target="button" data-action="menu#toggle" aria-expanded="false" aria-controls="account-menu" aria-label="Account settings for <%= Current.user.full_name %>" title="<%= Current.user.full_name %>" class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 text-left transition-colors hover:bg-neutral-100 lg:group-data-[rail=collapsed]/sidebar:justify-center lg:group-data-[rail=collapsed]/sidebar:px-0">
      <%= render "shared/sidebar/identity" %>
    </button>

    <div id="account-menu" data-menu-target="menu" class="hidden z-50 max-h-[min(28rem,calc(100dvh-1rem))] min-w-60 overflow-y-auto rounded-xl border border-neutral-200 bg-white shadow-lg shadow-neutral-900/10">
      <div class="border-b border-neutral-100 px-4 py-4">
        <p class="mb-3 text-xs font-medium text-neutral-500">Current workspace</p>
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-balance-teal-100 bg-balance-teal-100 text-sm font-semibold text-balance-teal-700" aria-hidden="true"><%= current_workspace.name.first&.upcase %></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-neutral-900"><%= current_workspace.name %></p>
            <p class="mt-0.5 truncate text-xs text-neutral-500"><%= Current.user.email_address %></p>
          </div>
          <%= inline_svg_tag "icons/check.svg", class: "h-4 w-4 flex-none text-balance-teal-700", aria: { hidden: true } %>
        </div>
      </div>

      <div class="p-1.5">
        <%= button_to session_path, method: :delete,
            class: "flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-balance-teal-700",
            form: { data: { turbo_confirm: "Sign out of Balance?" } } do %>
          <%= inline_svg_tag "icons/log-out.svg", class: "h-4 w-4 flex-none", aria: { hidden: true } %>
          Sign out
        <% end %>
      </div>
    </div>
  </div>
</div>
