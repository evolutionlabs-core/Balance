<%= turbo_frame_tag "modal" do %>
  <dialog data-controller="drawer"
       data-action="keydown->drawer#keydown click->drawer#clickOutside"
       class="fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none justify-end border-0 bg-transparent p-0 open:flex"
       aria-label="<%= title %>">
    <div data-drawer-target="backdrop"
         class="fixed inset-0 bg-neutral-950/30 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 ease-out motion-reduce:transition-none"></div>

    <div data-drawer-target="panel"
         class="relative z-10 flex h-full w-full max-w-md translate-x-full flex-col border-l border-neutral-200 bg-neutral-50 shadow-2xl transition duration-200 ease-out motion-reduce:transition-none">
      <div class="flex h-16 shrink-0 items-center justify-between gap-3 border-b border-neutral-200 bg-white px-5">
        <h2 class="text-base font-semibold tracking-tight text-neutral-900"><%= title %></h2>

        <button type="button" data-action="drawer#close" class="-mr-1.5 <%= icon_button_class %>">
          <span class="sr-only">Close</span>
          <%= inline_svg_tag "icons/x.svg", class: "h-4 w-4" %>
        </button>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto p-4">
        <%= yield %>
      </div>
    </div>
  </dialog>
<% end %>
