<div class="flex shrink-0 items-start justify-between gap-3 border-b border-neutral-200 px-5 py-4">
  <h2 class="min-w-0 text-base font-medium text-neutral-900"><%= title %></h2>

  <button type="button" data-action="modal#close" class="-mr-1.5 -mt-1 <%= icon_button_class %>">
    <span class="sr-only">Close</span>
    <%= inline_svg_tag "icons/x.svg", class: "h-4 w-4" %>
  </button>
</div>
