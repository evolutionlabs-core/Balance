<div aria-label="top-bar" class="sticky top-0 z-20 flex h-14 shrink-0 items-center gap-x-2 border-b border-neutral-200/80 bg-white/90 px-2 backdrop-blur sm:px-5 md:px-8">
  <button type="button" data-sidebar-target="hamburger" data-action="sidebar#toggleDrawer" aria-expanded="false" aria-controls="sidebar-panel" aria-label="Open navigation" class="-ml-1 mr-1 flex h-11 w-11 flex-none cursor-pointer items-center justify-center rounded-lg text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 sm:-ml-3 sm:mr-3 lg:hidden">
    <%= inline_svg_tag "icons/menu.svg", class: "h-5 w-5" %>
  </button>
  <% if content_for?(:breadcrumb) %>
    <%= yield :breadcrumb %>
  <% else %>
    <span class="truncate text-sm font-medium text-neutral-900"><%= content_for(:title) %></span>
  <% end %>

  <% if content_for?(:topbar_actions) %>
    <div class="ml-auto flex shrink-0 items-center gap-3">
      <%= yield :topbar_actions %>
    </div>
  <% end %>
</div>
