<% title_class = "min-w-0 flex-1 truncate text-sm font-medium text-neutral-950" %>
<% meta = local_assigns[:meta] %>
<% footer = local_assigns[:footer] %>
<% action = local_assigns[:action] %>
<article class="py-4">
  <div class="flex items-start justify-between gap-4">
    <% if local_assigns[:url] %>
      <%= link_to title, url, class: title_class %>
    <% else %>
      <p class="<%= title_class %>"><%= title %></p>
    <% end %>
    <%= local_assigns[:trailing] %>
  </div>
  <% if meta.present? %>
    <p class="mt-1 truncate text-xs text-neutral-500"><%= meta %></p>
  <% end %>
  <% if footer.present? || action.present? %>
    <div class="mt-2 flex items-center justify-between gap-3">
      <div class="flex min-w-0 items-center gap-2 text-xs text-neutral-500"><%= footer %></div>
      <div class="flex shrink-0 items-center gap-3"><%= action %></div>
    </div>
  <% end %>
</article>
