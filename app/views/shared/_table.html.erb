<% frame_class = local_assigns.fetch(:frame_class, "mt-4") %>
<div class="<%= frame_class %> overflow-x-auto border-y border-neutral-200">
  <table class="min-w-full">
    <thead class="<%= local_assigns[:sticky] ? "sticky top-0 z-10 " : "" %>bg-white">
      <tr>
        <% columns.each do |column| %>
          <th scope="col" class="<%= table_header_class(align: column.fetch(:align, :left)) %> <%= column[:class] %>">
            <% if column[:label].present? %>
              <%= column[:label] %>
            <% else %>
              <span class="sr-only"><%= column.fetch(:sr_label, "Actions") %></span>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody class="bg-white">
      <%= yield %>
    </tbody>
  </table>
</div>
