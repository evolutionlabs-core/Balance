<% content_for :title, "Contacts" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Contacts" } ] %>
<% end %>

<% new_contact = link_to(new_contact_path, class: primary_button_class, data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New contact
<% end %>

<%= render "shared/page_header",
    title: "Contacts",
    description: "Manage your customers and vendors.",
    action: new_contact %>

<% if @contacts.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/users.svg",
      title: "No contacts yet",
      description: "Create a contact once, then use it wherever that person or organization appears.",
      action: new_contact %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <% [ "Name", "Type", "Email", "Phone", "Status" ].each do |label| %>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @contacts.each do |contact| %>
          <tr id="<%= dom_id(contact) %>" class="group border-t border-neutral-200 transition-colors hover:bg-neutral-50">
            <td class="p-0 text-sm font-medium whitespace-nowrap text-neutral-900">
              <%= link_to contact.name, contact_path(contact), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm text-neutral-600">
              <%= link_to contact.contact_kind.humanize, contact_path(contact), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm text-neutral-600">
              <%= link_to contact.email.presence || blank_cell, contact_path(contact), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm text-neutral-600">
              <%= link_to contact.phone.presence || blank_cell, contact_path(contact), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm">
              <%= link_to contact_path(contact), class: "block px-4 py-4" do %>
                <%= contact_status(contact) %>
              <% end %>
            </td>
            <td class="px-4 py-4 text-right text-sm">
              <%= link_to "Edit", edit_contact_path(contact), class: "font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" }, aria: { label: "Edit #{contact.name}" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
