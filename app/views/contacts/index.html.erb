<% content_for :title, "Contacts" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Contacts" } ] %>
<% end %>

<% new_contact = link_to(new_contact_path, class: primary_button_class, data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New contact
<% end %>

<%= render "shared/page_header",
    title: "Contacts",
    description: "People and organizations connected to your financial activity.",
    action: new_contact %>

<nav class="mt-4 flex flex-wrap gap-2" aria-label="Contact roles">
  <% [ [ "All", nil ], [ "Vendors", "vendor" ], [ "Customers", "customer" ] ].each do |label, role| %>
    <% selected = @role == role %>
    <%= link_to label, contacts_path(role: role), class: "rounded-md px-3 py-1.5 text-sm font-medium #{selected ? 'bg-neutral-900 text-white' : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200 hover:text-neutral-900'}" %>
  <% end %>
</nav>

<% if @contacts.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/users.svg",
      title: @role ? "No #{@role.pluralize} yet" : "No contacts yet",
      description: "Create a contact once, then use it wherever that person or organization appears.",
      action: new_contact %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="sticky top-0 z-10 bg-white">
        <tr>
          <% [ "Name", "Type", "Roles", "Email", "Phone", "Status" ].each do |label| %>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="w-12 px-4 py-2.5 text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @contacts.each do |contact| %>
          <tr id="<%= dom_id(contact) %>" class="relative border-t border-neutral-200 transition-colors hover:bg-neutral-50/80">
            <td class="px-4 py-3 text-sm font-medium whitespace-nowrap text-neutral-900">
              <%= link_to contact.name, contact_path(contact), class: "before:absolute before:inset-0 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-sm text-neutral-600"><%= contact.contact_kind.humanize %></td>
            <td class="px-4 py-3 text-sm text-neutral-600">
              <div class="flex flex-wrap gap-1">
                <% contact.role_names.each do |role| %>
                  <span class="inline-flex rounded-md bg-neutral-100 px-2 py-1 text-xs font-medium text-neutral-600"><%= role.humanize %></span>
                <% end %>
              </div>
            </td>
            <td class="px-4 py-3 text-sm text-neutral-600"><%= contact.email.presence || blank_cell %></td>
            <td class="px-4 py-3 text-sm text-neutral-600"><%= contact.phone.presence || blank_cell %></td>
            <td class="px-4 py-3 text-sm">
              <span class="inline-flex rounded-full px-2 py-1 text-xs font-medium <%= contact.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-neutral-100 text-neutral-500' %>"><%= contact.active? ? "Active" : "Inactive" %></span>
            </td>
            <td class="relative z-10 px-4 py-2 text-right">
              <%= link_to edit_contact_path(contact), class: icon_button_class, data: { turbo_frame: "modal" }, aria: { label: "Edit #{contact.name}" } do %>
                <%= inline_svg_tag "icons/edit.svg", class: "h-4 w-4" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
