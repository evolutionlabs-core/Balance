<%= turbo_stream.replace dom_id(@invoice, :customer), partial: "invoices/customer", locals: { invoice: @invoice } %>
<%= turbo_stream.update "modal", "" %>
<% unless @invoice.persisted? %>
  <%= turbo_stream.replace "new_invoice_submission", partial: "invoices/create_button", locals: { invoice: @invoice } %>
<% end %>
