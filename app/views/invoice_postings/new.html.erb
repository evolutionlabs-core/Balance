<%= render "shared/modal" do %>
  <%= form_with model: @invoice, url: invoice_posting_path(@invoice), method: :post, class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: "Post to ledger" %>

    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @invoice %>
      <p class="text-sm text-neutral-600">Record <%= minor_currency(@invoice.total_minor, @invoice.currency_code) %> as owed by this customer. Review where each charge's income will be recorded before posting.</p>
      <%= form.fields_for :invoice_lines do |line_form| %>
        <div class="space-y-2 border-b border-neutral-200 pb-4">
          <p class="text-sm font-medium text-neutral-950"><%= line_form.object.description %></p>
          <p class="text-sm text-neutral-500"><%= minor_currency(line_form.object.amount_minor, @invoice.currency_code) %></p>
          <%= line_form.label :account_id, "Income account", class: field_label_class %>
          <%= line_form.collection_select :account_id, @income_accounts, :id, :name, { prompt: "Select income account" }, { required: true, class: field_class } %>
        </div>
      <% end %>
      <% if @income_accounts.empty? %>
        <p class="text-sm text-neutral-600">Create an income account in your chart of accounts before posting this invoice.</p>
      <% end %>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Post invoice" %>
  <% end %>
<% end %>
