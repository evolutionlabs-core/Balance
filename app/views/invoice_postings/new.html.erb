<%= render "shared/modal" do %>
  <%= form_with url: invoice_posting_path(@invoice), method: :post, class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: "Issue invoice" %>

    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @invoice %>
      <p class="text-sm text-neutral-600">Record <%= minor_currency(@invoice.total_minor, @invoice.currency_code) %> as owed by this customer.</p>
      <% @invoice.invoice_lines.each do |line| %>
        <div class="space-y-2 border-b border-neutral-200 pb-4">
          <p class="text-sm font-medium text-neutral-950"><%= line.description %></p>
          <p class="text-sm text-neutral-500"><%= minor_currency(line.amount_minor, @invoice.currency_code) %></p>
        </div>
      <% end %>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Issue invoice" %>
  <% end %>
<% end %>
