<% content_for :title, "Create your account" %>

<%= render layout: "shared/auth/page", locals: {
      title: "Create your account",
      description: "Set up your identity first. Your personal workspace comes next.",
      links: [ { label: "Already have an account? Sign in", path: new_session_path } ]
    } do %>
  <%= form_with url: registration_path, class: "space-y-3" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div>
      <%= label_tag :full_name, "Full name", class: field_label_class %>
      <%= text_field_tag :full_name, params[:full_name], required: true, autofocus: true, autocomplete: "name", class: field_class %>
    </div>

    <div>
      <%= label_tag :email_address, "Email", class: field_label_class %>
      <%= email_field_tag :email_address, params[:email_address], required: true, autocomplete: "username", class: field_class %>
    </div>

    <div>
      <%= label_tag :password, "Password", class: field_label_class %>
      <%= password_field_tag :password, nil, required: true, autocomplete: "new-password", maxlength: 72, class: field_class %>
    </div>

    <%= form.submit "Create account", class: "#{primary_button_class} w-full justify-center" %>
  <% end %>
<% end %>
