<% content_for :title, "Accounts" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Accounts" } ] %>
<% end %>

<%= render "shared/page_header",
    title: "Accounts",
    description: "Your chart of accounts." %>

<% if @ledger_accounts.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/wallet.svg",
      title: "No accounts yet",
      description: "Accounts appear here once your chart of accounts is provisioned." %>
<% else %>
  <div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200 sm:hidden">
    <% @ledger_accounts.each do |ledger_account| %>
      <article class="flex items-center gap-3 py-4">
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium text-neutral-950"><%= ledger_account.name %></p>
          <p class="mt-1 truncate text-xs text-neutral-500"><%= ledger_account.code %> · <%= ledger_account.base_type.humanize %> · <%= ledger_account.subtype.humanize %></p>
        </div>
        <% if ledger_account.system? %>
          <span class="flex min-h-11 min-w-11 items-center justify-center text-neutral-400" title="System account — locked">
            <span class="sr-only">System account — locked</span><%= inline_svg_tag "icons/lock.svg", class: "h-4 w-4" %>
          </span>
        <% end %>
      </article>
    <% end %>
  </div>
  <div class="mt-4 hidden overflow-x-auto border-y border-neutral-200 sm:block">
    <table class="min-w-full">
      <thead class="sticky top-0 z-10 bg-white">
        <tr>
          <% [ "Code", "Name", "Type", "Subtype" ].each do |label| %>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="w-12 px-4 py-2.5 text-right"><span class="sr-only">System</span></th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @ledger_accounts.each do |ledger_account| %>
          <tr id="<%= dom_id(ledger_account) %>" class="border-t border-neutral-200 transition-colors hover:bg-neutral-50/80">
            <td class="px-4 py-3 font-mono text-sm whitespace-nowrap text-neutral-600"><%= ledger_account.code %></td>
            <td class="px-4 py-3 text-sm font-medium whitespace-nowrap text-neutral-900"><%= ledger_account.name %></td>
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= ledger_account.base_type.humanize %></td>
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= ledger_account.subtype.humanize %></td>
            <td class="px-4 py-2 text-right">
              <% if ledger_account.system? %>
                <span class="inline-flex rounded-md p-1.5 text-neutral-400" title="System account — locked">
                  <span class="sr-only">System account — locked</span>
                  <%= inline_svg_tag "icons/lock.svg", class: "h-4 w-4" %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
