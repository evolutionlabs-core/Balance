<% content_for :title, "Accounts" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Accounts" } ] %>
<% end %>

<% new_account = link_to(new_account_path, class: primary_button_class(size: :compact), data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New account
<% end %>

<%= render "shared/page_header",
    title: "Accounts",
    description: "Your chart of accounts.",
    action: new_account %>

<%= form_with url: accounts_path, method: :get, class: "mt-4 flex flex-col gap-2 sm:flex-row sm:items-center",
    data: { controller: "form", turbo_frame: "accounts", turbo_action: "replace" } do |form| %>
  <%= form.hidden_field :archived, value: "1" if @archived %>
  <div class="relative min-w-0 flex-1">
    <%= form.search_field :q, value: params[:q], placeholder: "Search by name or code", autocomplete: "off",
        aria: { label: "Search accounts" }, class: field_class, data: { action: "input->form#search" } %>
  </div>
  <%= link_to @archived ? "Active accounts" : "Archived", accounts_path(archived: (@archived ? nil : "1")), class: ghost_button_class, data: { turbo_frame: "_top" } %>
<% end %>

<%= turbo_frame_tag "accounts", target: "_top" do %>
  <% if current_workspace.ledgers.none? %>
    <%= render "shared/empty_state",
        icon: "icons/wallet.svg",
        title: "No accounts yet",
        description: "Accounts appear here once your chart of accounts is provisioned." %>
  <% elsif @accounts.empty? %>
    <%= render "shared/empty_state",
        icon: "icons/wallet.svg",
        title: @archived ? "No archived accounts" : "No accounts found",
        description: @archived ? "Accounts you archive appear here and can be restored." : "Try a different name or code." %>
  <% else %>
    <%= render "list", accounts: @accounts, balances: @balances %>
  <% end %>
<% end %>
