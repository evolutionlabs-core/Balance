<% content_for :title, "Accounts" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Accounts" } ] %>
<% end %>

<% new_account = link_to(new_account_path, class: primary_button_class, data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New account
<% end %>

<%= render "shared/page_header",
    title: "Accounts",
    description: "Manage and track your accounts.",
    action: new_account %>

<% if @accounts.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/wallet.svg",
      title: "No accounts yet",
      description: "Create an account for every place money sits or moves through — a bank, cash on hand, or a category for sales.",
      action: new_account %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="sticky top-0 z-10 bg-white">
        <tr>
          <% [ "Name", "Base type", "Type", "Detail type" ].each do |label| %>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="w-12 px-4 py-2.5 text-right"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @accounts.each do |account| %>
          <tr id="<%= dom_id(account) %>" class="border-t border-neutral-200 transition-colors hover:bg-neutral-50/80">
            <td class="px-4 py-3 text-sm font-medium whitespace-nowrap text-neutral-900"><%= account.name %></td>
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= account.base_type.humanize %></td>
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= account.account_type.humanize %></td>
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= account.detail_type.humanize %></td>
            <td class="px-4 py-2 text-right">
              <% if account.role.present? %>
                <span class="inline-flex rounded-md p-1.5 text-neutral-400" title="System account — locked">
                  <span class="sr-only">System account — locked</span>
                  <%= inline_svg_tag "icons/lock.svg", class: "h-4 w-4" %>
                </span>
              <% else %>
                <div data-controller="menu" class="relative inline-block text-left">
                  <button type="button" data-menu-target="button" data-action="menu#toggle" class="<%= icon_button_class %>" aria-label="Actions for <%= account.name %>">
                    <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4" %>
                  </button>
                  <div data-menu-target="menu" class="hidden w-36 rounded-md border border-neutral-200 bg-white p-1 text-left shadow-md">
                    <%= link_to edit_account_path(account), class: menu_item_class, data: { turbo_frame: "modal" } do %>
                      <%= inline_svg_tag "icons/edit.svg", class: "h-4 w-4 flex-none" %>
                      Edit
                    <% end %>
                    <%= button_to account_path(account), method: :delete,
                        class: "#{menu_item_class} text-red-600 hover:bg-red-50",
                        form: { class: "contents", data: { turbo_confirm: "Delete #{account.name}?" } } do %>
                      <%= inline_svg_tag "icons/trash.svg", class: "h-4 w-4 flex-none" %>
                      Delete
                    <% end %>
                  </div>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
