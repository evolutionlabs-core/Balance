<% subtype_labels = AccountSubtypes::SUBTYPES.transform_values { |subtypes| subtypes.map { |subtype| [ subtype.humanize, subtype ] } } %>
<%= form_with model: account, url: account.persisted? ? account_path(account) : accounts_path,
    data: { controller: "account-subtypes", account_subtypes_map_value: subtype_labels.to_json } do |form| %>
  <%= render "shared/modal/header", title: account.persisted? ? "Edit account" : "New account" %>

  <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-4">
    <%= render "shared/form_errors", record: account %>

    <div>
      <%= form.label :code, class: field_label_class %>
      <%= form.text_field :code, required: true, autofocus: true, placeholder: "1010", class: "#{field_class} font-mono" %>
    </div>

    <div>
      <%= form.label :name, class: field_label_class %>
      <%= form.text_field :name, required: true, placeholder: "Account name", class: field_class %>
    </div>

    <div>
      <%= form.label :base_type, "Type", class: field_label_class %>
      <%= render "shared/select_menu", form: form, attribute: :base_type,
          options: options_for_select(AccountSubtypes::SUBTYPES.keys.map { |type| [ type.humanize, type ] }, account.base_type),
          prompt: "Select type",
          select_data: { account_subtypes_target: "type", action: "change->account-subtypes#filter" } %>
    </div>

    <div>
      <%= form.label :subtype, "Subtype", class: field_label_class %>
      <%= render "shared/select_menu", form: form, attribute: :subtype,
          options: options_for_select(subtype_labels.fetch(account.base_type.to_s, []), account.subtype),
          prompt: account.base_type.present? ? "Select subtype" : "Select a type first",
          select_data: { account_subtypes_target: "subtype" },
          searchable: true, search_placeholder: "Search subtypes…", empty_message: "No subtypes found" %>
    </div>

    <div>
      <%= form.label :description, class: field_label_class %>
      <%= form.text_area :description, rows: 2, placeholder: "Optional", class: field_class %>
    </div>
  </div>

  <%= render "shared/modal/footer", form: form, submit_label: account.persisted? ? "Save changes" : "Create account" %>
<% end %>
