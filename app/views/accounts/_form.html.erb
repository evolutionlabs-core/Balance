<%= form_with model: account, data: {
      controller: "account-taxonomy",
      account_taxonomy_taxonomy_value: current_workspace.catalog.as_hash,
      account_taxonomy_account_type_value: account.account_type,
      account_taxonomy_detail_type_value: account.detail_type
    } do |form| %>
  <%= render "shared/modal/header", title: account.persisted? ? "Edit account" : "New account" %>

  <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-4">
    <%= render "shared/form_errors", record: account %>

    <div>
      <%= form.label :name, class: field_label_class %>
      <%= form.text_field :name, required: true, autofocus: true, placeholder: "Account name", class: field_class %>
    </div>

    <%= form.hidden_field :base_type, data: { account_taxonomy_target: "baseType" } %>

    <div>
      <%= form.label :account_type, "Account type", class: field_label_class %>
      <%= render "shared/select_menu", form: form, attribute: :account_type,
          options: catalog_grouped_options_for_select(current_workspace.catalog, account.account_type),
          prompt: "Select account type",
          select_data: { account_taxonomy_target: "accountType", action: "change->account-taxonomy#accountTypeChanged" },
          searchable: true, search_placeholder: "Search account types…", empty_message: "No account types found" %>
    </div>

    <div>
      <%= form.label :detail_type, "Detail type", class: field_label_class %>
      <%= render "shared/select_menu", form: form, attribute: :detail_type,
          options: [], prompt: "Select detail type",
          select_data: { account_taxonomy_target: "detailType" },
          searchable: true, search_placeholder: "Search detail types…", empty_message: "No detail types found" %>
    </div>

    <div>
      <%= form.label :description, class: field_label_class %>
      <%= form.text_area :description, rows: 2, placeholder: "Optional", class: field_class %>
    </div>
  </div>

  <%= render "shared/modal/footer", form: form, submit_label: account.persisted? ? "Save changes" : "Create account" %>
<% end %>
