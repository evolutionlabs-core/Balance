<tr id="<%= dom_id(account) %>" class="<%= table_row_class %>">
  <td class="<%= table_cell_class %> font-mono whitespace-nowrap"><%= account.code %></td>
  <td class="<%= table_cell_class(strong: true) %> whitespace-nowrap"><%= account.name %></td>
  <td class="<%= table_cell_class %> whitespace-nowrap"><%= account.base_type.humanize %></td>
  <td class="<%= table_cell_class %> whitespace-nowrap"><%= account.subtype.humanize %></td>
  <td class="<%= table_cell_class(align: :right) %> py-2">
    <% if account.system? %>
      <span class="inline-flex rounded-md p-1.5 text-neutral-400" title="System account — locked">
        <span class="sr-only">System account — locked</span>
        <%= inline_svg_tag "icons/lock.svg", class: "h-4 w-4" %>
      </span>
    <% end %>
  </td>
</tr>
