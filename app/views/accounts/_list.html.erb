<div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200 sm:hidden">
  <%= render partial: "account_card", collection: accounts, as: :account %>
</div>
<div class="mt-4 hidden overflow-x-auto border-y border-neutral-200 sm:block">
  <table class="min-w-full">
    <thead class="sticky top-0 z-10 bg-white">
      <tr>
        <% [ "Code", "Name", "Type", "Subtype" ].each do |label| %>
          <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500"><%= label %></th>
        <% end %>
        <th scope="col" class="w-12 px-4 py-2.5 text-right"><span class="sr-only">System</span></th>
      </tr>
    </thead>
    <tbody class="bg-white">
      <%= render partial: "account_row", collection: accounts, as: :account %>
    </tbody>
  </table>
</div>
