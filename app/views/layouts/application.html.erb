<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Balance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Balance">
    <meta name="mobile-web-app-capable" content="yes">

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png" sizes="180x180">
    <link rel="icon" href="/favicon.ico">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-neutral-950 antialiased">
    <div id="flash_messages"><%= render "shared/flash" %></div>

    <%= turbo_frame_tag "modal" %>

    <div class="group/sidebar flex" data-controller="sidebar" data-sidebar data-drawer="closed" data-rail="expanded">
      <dialog id="sidebar-panel" aria-label="Primary navigation" data-sidebar-target="panel" data-action="click->sidebar#clickOutside" class="fixed inset-y-0 left-0 z-40 m-0 h-dvh w-[min(20rem,85vw)] max-h-none max-w-none -translate-x-[105%] overflow-hidden border-0 border-r border-neutral-200/80 bg-white p-0 transition-transform duration-200 ease-out open:flex group-data-[drawer=open]/sidebar:translate-x-0 lg:sticky lg:top-0 lg:z-30 lg:h-dvh lg:w-64 lg:flex-none lg:translate-x-0 lg:overflow-visible lg:transition-none lg:group-data-[rail=collapsed]/sidebar:w-16 lg:group-data-[sidebar-ready]/sidebar:transition-[width] motion-reduce:transition-none">
        <%= render "shared/sidebar/sidenav" %>
      </dialog>

      <div class="flex min-w-0 flex-1 flex-col <%= content_for?(:full_bleed) ? "h-dvh min-h-0 overflow-hidden" : "min-h-screen" %>">
        <%= render "shared/topbar" %>

        <main class="<%= content_for?(:full_bleed) ? "flex min-h-0 flex-1 flex-col overflow-hidden" : "mx-auto w-full max-w-7xl flex-1 px-4 pt-6 pb-8 sm:px-5 sm:pt-8 md:px-8" %>">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
