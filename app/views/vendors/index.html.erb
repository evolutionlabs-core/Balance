<% content_for :title, "Vendors" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Vendors" } ] %>
<% end %>

<% new_vendor = link_to(new_vendor_path, class: primary_button_class(size: :compact), data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New vendor
<% end %>

<%= render "shared/page_header",
    title: "Vendors",
    description: "The suppliers you receive bills from.",
    action: new_vendor %>

<% if @vendors.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/users.svg",
      title: "No vendors yet",
      description: "Add a vendor once, then record the bills they send you.",
      action: new_vendor %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <% [ "Name", "Email", "Phone", "Status" ].each do |label| %>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @vendors.each do |vendor| %>
          <tr id="<%= dom_id(vendor) %>" class="border-t border-neutral-200 transition-colors hover:bg-neutral-50">
            <td class="p-0 text-sm font-medium whitespace-nowrap text-neutral-900">
              <%= link_to vendor.name, vendor_path(vendor), class: "block px-4 py-4" %>
            </td>
            <td class="px-4 py-4 text-sm text-neutral-600"><%= vendor.email.presence || blank_cell %></td>
            <td class="px-4 py-4 text-sm text-neutral-600"><%= vendor.phone.presence || blank_cell %></td>
            <td class="px-4 py-4 text-sm"><%= status_badge(vendor.active? ? "Active" : "Inactive", tone: vendor.active? ? :success : :warning) %></td>
            <td class="px-4 py-4 text-right text-sm">
              <%= link_to "Edit", edit_vendor_path(vendor), class: "font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" }, aria: { label: "Edit #{vendor.name}" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
