<%= form_with model: vendor, class: "flex min-h-0 flex-1 flex-col" do |form| %>
  <%= render "shared/modal/header", title: vendor.persisted? ? "Edit vendor" : "New vendor" %>

  <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
    <%= render "shared/form_errors", record: errors_except(vendor, :email, :phone) %>

    <section class="space-y-4">
      <div>
        <%= form.label :name, class: field_label_class %>
        <%= form.text_field :name, required: true, autofocus: true, placeholder: "Vendor name", class: field_class %>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :email, class: field_label_class %>
          <%= form.email_field :email, placeholder: "name@example.com", class: field_class_for(vendor, :email), autocomplete: "email",
              aria: { invalid: vendor.errors.include?(:email), describedby: ("email_error" if vendor.errors.include?(:email)) } %>
          <%= field_error(vendor, :email) %>
        </div>
        <div>
          <%= form.label :phone, class: field_label_class %>
          <%= form.telephone_field :phone, placeholder: "Phone number", class: field_class_for(vendor, :phone), inputmode: "tel", autocomplete: "tel", data: { controller: "phone-input", action: "input->phone-input#clean" } %>
          <%= field_error(vendor, :phone) %>
        </div>
      </div>

      <label class="flex items-center gap-2 text-sm text-neutral-700">
        <%= form.check_box :active %>
        Active
      </label>
    </section>

    <section class="space-y-4 border-t border-neutral-200 pt-5">
      <h3 class="text-sm font-semibold text-neutral-950">Address</h3>
      <%= form.text_area :address, rows: 3, placeholder: "Address", class: field_class, aria: { label: "Address" } %>
    </section>
  </div>

  <%= render "shared/modal/footer", form: form, submit_label: vendor.persisted? ? "Save changes" : "Create vendor" %>
<% end %>
