<% content_for :title, @vendor.name %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Vendors", path: vendors_path }, { label: @vendor.name } ] %>
<% end %>

<% vendor_actions = capture do %>
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Edit vendor", edit_vendor_path(@vendor), class: secondary_button_class(size: :compact), data: { turbo_frame: "modal" } %>
    <%= link_to new_bill_path(vendor_id: @vendor.id), class: primary_button_class(size: :compact) do %>
      <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New bill
    <% end %>
  </div>
<% end %>

<%= render "shared/page_header",
    title: @vendor.name,
    description: [ @vendor.email.presence, @vendor.phone.presence ].compact.join(" · ").presence || "Vendor",
    action: vendor_actions %>

<% outstanding = @bills.select(&:open?).sum(&:balance_due_kobo) %>
<dl class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-md border border-neutral-200 bg-neutral-200 sm:grid-cols-2">
  <div class="bg-white px-4 py-3">
    <dt class="text-xs font-medium text-neutral-500">Outstanding</dt>
    <dd class="mt-1 text-sm font-semibold tabular-nums text-neutral-900"><%= money(outstanding) %></dd>
  </div>
  <div class="bg-white px-4 py-3">
    <dt class="text-xs font-medium text-neutral-500">Bills</dt>
    <dd class="mt-1 text-sm text-neutral-900"><%= @bills.size %></dd>
  </div>
</dl>

<% if @bills.any? %>
  <%= render layout: "shared/table", locals: { frame_class: "mt-6", columns: bill_table_columns } do %>
    <%= render partial: "bills/bill", collection: @bills %>
  <% end %>
<% end %>
