<% content_for :title, @bill.voided? ? "#{@bill.display_name} (voided)" : @bill.display_name %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Bills", path: bills_path }, { label: @bill.display_name } ] %>
<% end %>

<div class="mx-auto max-w-5xl">
  <div class="flex flex-col gap-4 border-b border-neutral-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold tracking-tight text-neutral-950"><%= @bill.display_name %></h1>
        <%= bill_status_badge(@bill) %>
      </div>
      <p class="mt-1 text-sm text-neutral-500">From <%= link_to @bill.vendor.name, vendor_path(@bill.vendor), class: "font-medium text-[#0f7082] hover:underline" %></p>
    </div>
    <div class="sm:text-right">
      <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Balance due</p>
      <p class="mt-1 text-3xl font-semibold tabular-nums text-neutral-950"><%= naira(@bill.open? ? @bill.balance_due_kobo : 0) %></p>
    </div>
  </div>

  <dl class="mt-6 grid grid-cols-1 gap-px overflow-hidden rounded-md border border-neutral-200 bg-neutral-200 sm:grid-cols-4">
    <% [
         [ "Bill date", @bill.bill_date&.strftime("%b %-d, %Y") || blank_cell ],
         [ "Due date", @bill.due_date&.strftime("%b %-d, %Y") || blank_cell ],
         [ "Total", naira(@bill.total_kobo) ],
         [ "Paid", naira(@bill.applied_amount_kobo) ]
       ].each do |label, value| %>
      <div class="bg-white px-4 py-3">
        <dt class="text-xs font-medium text-neutral-500"><%= label %></dt>
        <dd class="mt-1 text-sm tabular-nums text-neutral-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <% if @bill.notes.present? %>
    <p class="mt-4 text-sm text-neutral-600"><%= @bill.notes %></p>
  <% end %>

  <div class="mt-6 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Account</th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Description</th>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Amount</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @bill.bill_lines.each do |line| %>
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 text-sm text-neutral-900"><%= line.account.name %></td>
            <td class="px-4 py-3 text-sm text-neutral-600"><%= line.description %></td>
            <td class="px-4 py-3 text-right text-sm tabular-nums text-neutral-900"><%= naira(line.amount_kobo) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "bills/payments", bill: @bill %>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <%= link_to "Back to bills", bills_path, class: ghost_button_class %>
    <div class="flex flex-wrap items-center gap-2">
      <% if @bill.draft? %>
        <%= link_to "Edit bill", edit_bill_path(@bill), class: secondary_button_class %>
        <%= link_to "Void bill", new_bill_void_path(@bill), class: secondary_button_class, data: { turbo_frame: "modal" } %>
        <%= link_to "Enter bill", new_bill_issuance_path(@bill), class: primary_button_class, data: { turbo_frame: "modal" } %>
      <% elsif @bill.open? %>
        <% if @bill.may_mark_voided? %>
          <%= link_to "Void bill", new_bill_void_path(@bill), class: secondary_button_class, data: { turbo_frame: "modal" } %>
        <% end %>
        <% if @bill.balance_due_kobo.positive? %>
          <%= link_to "Record payment", new_bill_payment_path(@bill), class: primary_button_class, data: { turbo_frame: "modal" } %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
