<% received = bill.payments.reject(&:reverses_bill_payment_id?).sort_by(&:id) %>
<% if received.any? %>
  <section class="mt-6" aria-labelledby="payments-heading">
    <h2 id="payments-heading" class="text-base font-semibold text-neutral-950">Payments</h2>
    <%= render layout: "shared/table", locals: { frame_class: "mt-3", columns: [ { label: "Date" }, { label: "Paid from" }, { label: "Amount", align: :right }, { label: "", align: :right } ] } do %>
      <% received.each do |payment| %>
        <% entry = payment.journal_entry %>
        <% reversed = payment.reversal_payment.present? %>
        <tr class="<%= table_row_class %>">
          <td class="<%= table_cell_class(muted: reversed) %> whitespace-nowrap"><%= entry.effective_date.strftime("%b %-d, %Y") %></td>
          <td class="<%= table_cell_class(muted: reversed) %>"><%= entry.journal_entry_lines.find { |line| line.credit.positive? }.account.name %></td>
          <td class="<%= table_cell_class(align: :right, strong: true, muted: reversed) %> tabular-nums <%= "line-through" if reversed %>"><%= money(payment.amount_kobo, bill.currency_code) %></td>
          <td class="<%= table_cell_class(align: :right, muted: reversed) %>">
            <% if reversed %>
              <span class="text-xs">Reversed</span>
            <% elsif !bill.voided? %>
              <%= button_to "Reverse", bill_payment_reversal_path(bill, payment), method: :post,
                  class: "cursor-pointer bg-transparent text-sm font-medium text-red-700 hover:underline",
                  form: { data: { turbo_confirm: "Reverse this #{money(payment.amount_kobo, bill.currency_code)} payment? The bill balance goes back up by the same amount." } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </section>
<% end %>
