<% content_for :title, "Edit #{@bill.display_name.downcase_first}" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Bills", path: bills_path }, { label: @bill.display_name, path: bill_path(@bill) }, { label: "Edit" } ] %>
<% end %>

<div class="mx-auto max-w-5xl">
  <%= render "bills/form", bill: @bill %>
</div>
