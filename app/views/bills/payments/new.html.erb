<%= render "shared/modal" do %>
  <%= form_with scope: :bill_payment, url: bill_payment_path(@bill), class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: "Record payment" %>

    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @bill %>
      <p class="text-sm text-neutral-600">Record money paid to <%= @bill.vendor.name %> against this bill.</p>

      <div>
        <%= form.label :payment_account_id, "Paid from", class: field_label_class %>
        <%= render "shared/select_menu", form: form, attribute: :payment_account_id,
            options: options_from_collection_for_select(@payment_accounts, :id, :name, params.dig(:bill_payment, :payment_account_id)),
            prompt: "Select account", searchable: true, search_placeholder: "Search payment accounts…",
            empty_message: "No payment accounts found", select_data: {}, required: true %>
      </div>

      <div>
        <%= form.label :paid_on, "Payment date", class: field_label_class %>
        <%= form.text_field :paid_on, value: params.dig(:bill_payment, :paid_on) || Date.current,
            required: true, autocomplete: "off", class: "#{field_class} cursor-pointer", data: { controller: "date-picker" } %>
      </div>

      <div>
        <%= form.label :amount, "Amount paid", class: field_label_class %>
        <%= form.number_field :amount, value: params.dig(:bill_payment, :amount) || format("%.2f", BigDecimal(@bill.balance_due_kobo) / 100), min: 0.01,
            max: format("%.2f", BigDecimal(@bill.balance_due_kobo) / 100), step: 0.01, required: true, class: field_class %>
      </div>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Record payment" %>
  <% end %>
<% end %>
