<% content_for :title, "Update your password" %>

<%= render layout: "shared/auth/page", locals: {
      title: "Update your password",
      description: "Choose a new password for your account.",
      links: [ { label: "Back to sign in", path: new_session_path } ]
    } do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-3" do |form| %>
    <div>
      <%= form.label :password, "New password", class: field_label_class %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: field_class %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: field_label_class %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: field_class %>
    </div>

    <%= form.submit "Save", class: "#{primary_button_class} w-full justify-center" %>
  <% end %>
<% end %>
