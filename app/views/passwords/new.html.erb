<% content_for :title, "Forgot your password?" %>

<%= render layout: "shared/auth/page", locals: {
      title: "Forgot your password?",
      description: "We'll email you reset instructions.",
      links: [ { label: "Back to sign in", path: new_session_path } ]
    } do %>
  <%= form_with url: passwords_path, class: "space-y-3" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: field_label_class %>
      <%= form.email_field :email_address, value: params[:email_address], required: true, autofocus: true, autocomplete: "username", class: field_class %>
    </div>

    <%= form.submit "Email reset instructions", class: "#{primary_button_class} w-full justify-center" %>
  <% end %>
<% end %>
