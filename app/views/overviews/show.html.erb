<% content_for :title, "Overview" %>
<% content_for :breadcrumb do %>
  <%= render "shared/breadcrumb", data: [ { label: "Overview" } ] %>
<% end %>

<div class="mx-auto max-w-7xl space-y-5 sm:space-y-6">
  <header class="flex flex-col gap-4 border-b border-neutral-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <div class="flex min-w-0 items-center gap-2.5">
        <h1 class="truncate text-xl font-semibold tracking-tight text-neutral-950 sm:text-2xl"><%= current_workspace.name %></h1>
        <span class="inline-flex flex-none rounded-md border border-neutral-200 bg-neutral-50 px-2 py-0.5 text-xs font-medium text-neutral-600"><%= @overview.t("badge") %></span>
      </div>
      <p class="mt-1.5 text-sm tabular-nums text-neutral-500">
        <%= @overview.t("range", from: @overview.date_range.begin.strftime("%b %-d"), to: @overview.date_range.end.strftime("%b %-d, %Y"), currency: current_workspace.currency_code) %>
      </p>
    </div>
    <nav class="inline-flex self-start rounded-lg border border-neutral-200 bg-white p-0.5 sm:self-auto" aria-label="<%= @overview.t("period_nav") %>">
      <% Overview::PERIODS.each do |days| %>
        <% active = days == @overview.days %>
        <%= link_to @overview.t("short_periods.#{days}"), overview_path(days: days),
            aria: { current: active ? "page" : nil, label: @overview.t("periods.#{days}") }, title: @overview.t("periods.#{days}"),
            class: "inline-flex h-8 min-w-12 items-center justify-center rounded-md px-3 text-xs font-semibold tabular-nums transition-colors #{active ? 'bg-neutral-900 text-white' : 'text-neutral-500 hover:bg-neutral-100 hover:text-neutral-950'}" %>
      <% end %>
    </nav>
  </header>

  <%= render "overviews/kpis", overview: @overview %>

  <% @overview.rows.each do |row| %>
    <div class="grid gap-5 sm:gap-6 <%= "lg:grid-cols-2" if row.many? %>">
      <% row.each do |panel| %>
        <%= render "overviews/panels/#{panel}", overview: @overview %>
      <% end %>
    </div>
  <% end %>
</div>
