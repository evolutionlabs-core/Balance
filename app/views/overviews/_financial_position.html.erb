<section class="border-t border-neutral-200 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0" aria-labelledby="position-heading">
  <h2 id="position-heading" class="text-base font-semibold">Financial position</h2>
  <p class="mt-1 text-sm text-neutral-500">As of <%= Date.current.strftime("%b %-d, %Y") %></p>

  <% if position.nil? %>
    <p class="mt-4 rounded-md border border-dashed border-neutral-200 p-4 text-sm text-neutral-500">
      Your financial position appears here once your chart of accounts is provisioned.
    </p>
  <% else %>
    <dl class="mt-4 divide-y divide-neutral-100 text-sm">
      <% position.total(:outline).each do |section| %>
        <div class="py-3 first:pt-0">
          <div class="flex items-baseline justify-between gap-3">
            <dt class="font-medium text-neutral-950"><%= section.label %></dt>
            <dd class="font-semibold tabular-nums text-neutral-950"><%= statement_figure(section.amounts.first) %></dd>
          </div>
          <% section.groups.each do |group| %>
            <div class="mt-1.5 flex items-baseline justify-between gap-3 pl-3 text-neutral-600">
              <dt class="truncate"><%= group.label %></dt>
              <dd class="tabular-nums"><%= statement_figure(group.amounts.first) %></dd>
            </div>
          <% end %>
        </div>
      <% end %>
    </dl>
    <p class="mt-2 text-xs text-neutral-500">Amounts in <%= current_workspace.currency_code %>.</p>

    <% if receivables && payables %>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <% [ [ "Owed to you", receivables, aged_receivables_path ], [ "You owe", payables, aged_payables_path ] ].each do |label, aging, path| %>
          <% overdue = aging.total_kobo - aging.bucket_totals[:current] %>
          <%= link_to path, class: "block rounded-lg border border-neutral-200 p-3 hover:border-neutral-300 hover:bg-neutral-50" do %>
            <p class="text-xs font-medium text-neutral-500"><%= label %></p>
            <p class="mt-1 text-base font-semibold tabular-nums text-neutral-950"><%= naira(aging.total_kobo) %></p>
            <p class="mt-0.5 text-xs <%= overdue.positive? ? "text-red-700" : "text-neutral-500" %>">
              <%= overdue.positive? ? "#{naira(overdue)} overdue" : "Nothing overdue" %>
            </p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= link_to "View balance sheet →", balance_sheet_path, class: "mt-5 inline-block text-sm font-medium text-balance-teal-700 hover:underline" %>
</section>
