<% slices = overview.top_expenses %>
<% total = slices.sum(&:amount_kobo) %>
<% colors = overview_slice_colors(slices) %>

<section class="@container <%= overview_panel_class %>" aria-labelledby="top-expenses-heading">
  <h2 id="top-expenses-heading" class="text-base font-semibold text-neutral-950"><%= overview.t("top_expenses.title") %></h2>
  <p class="mt-1 text-sm text-neutral-500"><%= overview.t("top_expenses.description") %></p>

  <% if slices.empty? %>
    <p class="mt-5 rounded-lg border border-dashed border-neutral-200 p-6 text-center text-sm text-neutral-500"><%= overview.t("top_expenses.empty") %></p>
  <% else %>
    <div class="mt-5 grid items-center gap-6 @2xl:grid-cols-[13rem_minmax(0,1fr)]">
      <div class="relative mx-auto w-52" role="img" aria-label="<%= overview.t("top_expenses.chart_label") %>">
        <%= pie_chart slices.to_h { |slice| [ slice.label, slice.amount_kobo / 100.0 ] }, donut: true, height: "208px", legend: false, colors: colors, **overview_chart_money_options(overview),
            dataset: { borderWidth: 2, borderColor: "#ffffff", hoverOffset: 4 },
            library: { cutout: "68%" } %>
        <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center">
          <span class="text-xs text-neutral-500"><%= overview.t("top_expenses.total") %></span>
          <span class="mt-0.5 max-w-[8.5rem] break-words text-sm font-semibold tabular-nums text-neutral-950"><%= overview_money(overview, total) %></span>
        </div>
      </div>

      <ul class="min-w-0 space-y-2.5 text-sm">
        <% slices.zip(colors).each do |slice, color| %>
          <li class="flex items-center gap-2.5">
            <span class="size-2.5 flex-none rounded-sm" style="background-color: <%= color %>" aria-hidden="true"></span>
            <span class="min-w-0 flex-1 truncate text-neutral-700"><%= slice.label %></span>
            <span class="w-10 flex-none text-right text-xs tabular-nums text-neutral-500"><%= overview_share(slice.amount_kobo, total) %></span>
            <span class="flex-none text-right font-medium tabular-nums text-neutral-950"><%= overview_money(overview, slice.amount_kobo) %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
