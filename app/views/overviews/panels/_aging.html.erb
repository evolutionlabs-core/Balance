<% buckets = aging ? aging.bucket_totals : AgedBalances::BUCKETS.keys.index_with { 0 } %>
<% total = buckets.values.sum %>
<% current = buckets[:current] %>
<% overdue = total - current %>

<section class="<%= overview_panel_class %>" aria-labelledby="<%= side %>-heading">
  <div class="flex items-baseline justify-between gap-3">
    <h2 id="<%= side %>-heading" class="text-sm font-medium text-neutral-500"><%= overview.t("#{side}.title") %></h2>
    <%= link_to overview.t("#{side}.link"), path, class: "whitespace-nowrap text-sm font-medium text-balance-teal-700 hover:underline" %>
  </div>

  <p class="mt-2 text-2xl font-semibold tracking-tight tabular-nums text-neutral-950"><%= overview_money(overview, total) %></p>

  <div class="mt-4 flex h-1.5 gap-0.5 overflow-hidden rounded-full bg-neutral-100" aria-hidden="true">
    <% if total.positive? %>
      <% [ [ current, OverviewsHelper::CURRENT_COLOR ], [ overdue, OverviewsHelper::OVERDUE_COLOR ] ].each do |amount, color| %>
        <% if amount.positive? %>
          <span class="h-full" style="width: <%= (amount * 100.0 / total).round(2) %>%; background-color: <%= color %>"></span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
    <% [ [ "current", current, OverviewsHelper::CURRENT_COLOR ], [ "overdue", overdue, OverviewsHelper::OVERDUE_COLOR ] ].each do |key, amount, color| %>
      <div class="flex items-center gap-1.5">
        <span class="size-2 rounded-full" style="background-color: <%= color %>" aria-hidden="true"></span>
        <dt class="text-neutral-500"><%= overview.t("#{side}.#{key}") %></dt>
        <dd class="font-medium tabular-nums text-neutral-900"><%= overview_money(overview, amount) %></dd>
      </div>
    <% end %>
  </dl>
</section>
