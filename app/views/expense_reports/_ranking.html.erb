<section>
  <h2 class="text-base font-medium text-neutral-900"><%= title %></h2>
  <% if rows.any? %>
    <ol class="mt-3 divide-y divide-neutral-200 border-y border-neutral-200">
      <% rows.each do |row| %>
        <li class="flex items-center justify-between gap-4 py-3 text-sm">
          <span class="truncate text-neutral-700"><%= row.label %></span>
          <span class="font-medium tabular-nums whitespace-nowrap text-neutral-950"><%= money(row.amount_kobo) %></span>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-3 border-y border-neutral-200 py-4 text-sm text-neutral-500"><%= empty_message %></p>
  <% end %>
</section>
