<% content_for :title, "Choose a workspace — Balance" %>

<div class="mb-6">
  <p class="mb-2 text-sm font-medium text-balance-teal-700">Start with the right books</p>
  <h1 class="max-w-xl text-3xl font-medium tracking-tight text-neutral-950 sm:text-4xl">What are you keeping track of?</h1>
  <p class="mt-2 max-w-lg text-base leading-7 text-neutral-500">Your choice shapes the account catalog and the accounting rules available in this workspace.</p>
</div>

<%= form_with url: onboarding_step_path(:workspace_type), method: :patch, class: "space-y-3" do %>
  <label class="group flex cursor-pointer items-center gap-5 border-y border-neutral-200 bg-white px-1 py-5 transition hover:border-neutral-400">
    <%= radio_button_tag :workspace_type, "personal", true, class: "peer sr-only" %>
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-balance-teal-100 text-lg text-balance-teal-700">P</span>
    <span class="min-w-0 flex-1">
      <span class="block text-base font-medium text-neutral-950">Personal</span>
      <span class="mt-1 block text-sm text-neutral-500">Track your money, income, spending, savings, and debts.</span>
    </span>
    <span class="h-4 w-4 rounded-full border border-neutral-300 p-[3px] peer-checked:border-balance-teal-700 peer-checked:bg-balance-teal-700"></span>
  </label>

  <label class="group flex cursor-pointer items-center gap-5 border-b border-neutral-200 bg-white px-1 py-5 transition hover:border-neutral-400">
    <%= radio_button_tag :workspace_type, "business", false, class: "peer sr-only" %>
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-balance-teal-100 text-lg text-balance-teal-700">B</span>
    <span class="min-w-0 flex-1">
      <span class="block text-base font-medium text-neutral-950">Business</span>
      <span class="mt-1 block text-sm text-neutral-500">Accounting for companies, teams, customers, and operations.</span>
    </span>
    <span class="h-4 w-4 rounded-full border border-neutral-300 p-[3px] peer-checked:border-balance-teal-700 peer-checked:bg-balance-teal-700"></span>
  </label>

  <div class="flex justify-end pt-4">
    <%= submit_tag "Continue", class: primary_button_class %>
  </div>
<% end %>
