<% current = summary.period(days: days) %>
<% previous = summary.previous_period(days: days) %>
<% difference = current.profit_kobo - previous.profit_kobo %>

<section aria-label="Financial summary" class="grid gap-4 border-y border-neutral-200 py-6 md:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-lg bg-balance-teal-100 p-4">
    <p class="text-sm font-medium text-balance-teal-700">Cash available</p>
    <p class="mt-3 text-2xl font-semibold tracking-tight tabular-nums text-neutral-950"><%= naira(summary.liquid_balance_kobo) %></p>
    <p class="mt-3 text-xs text-neutral-600">Cash and bank balances today</p>
  </div>
  <div class="px-2 py-5">
    <p class="text-sm font-medium text-neutral-500"><%= current.profit_kobo.negative? ? "Net loss" : "Net profit" %></p>
    <p class="mt-3 text-2xl font-semibold tracking-tight tabular-nums <%= current.profit_kobo.negative? ? 'text-red-700' : 'text-neutral-950' %>"><%= naira(current.profit_kobo) %></p>
    <p class="mt-3 text-xs text-neutral-500"><%= naira(difference.abs) %> <%= difference.negative? ? "lower" : "higher" %> than prior <%= days %> days</p>
  </div>
  <% [["Income", current.income_kobo, "Earned in this period"], ["Expenses", current.expense_kobo, "Incurred in this period"]].each do |label, value, description| %>
    <div class="px-2 py-5">
      <p class="text-sm font-medium text-neutral-500"><%= label %></p>
      <p class="mt-3 text-2xl font-semibold tracking-tight tabular-nums"><%= naira(value) %></p>
      <p class="mt-3 text-xs text-neutral-500"><%= description %></p>
    </div>
  <% end %>
</section>
