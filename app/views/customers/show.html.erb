<% content_for :title, @customer.name %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Customers", path: customers_path }, { label: @customer.name } ] %>
<% end %>

<% edit_customer = link_to(edit_customer_path(@customer), class: secondary_button_class(size: :compact), data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/edit.svg", class: "h-4 w-4" %>Edit customer
<% end %>

<%= render "shared/page_header",
    title: @customer.name,
    description: @customer.customer_type.humanize,
    action: edit_customer %>

<% details = [
     [ "Email", @customer.email.presence || blank_cell ],
     [ "Phone", @customer.phone.presence || blank_cell ],
     [ "Status", customer_status(@customer) ]
   ] %>

<dl class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-md border border-neutral-200 bg-neutral-200 sm:grid-cols-3">
  <% details.each do |label, value| %>
    <div class="bg-white px-4 py-3">
      <dt class="text-xs font-medium text-neutral-500"><%= label %></dt>
      <dd class="mt-1 text-sm text-neutral-900"><%= value %></dd>
    </div>
  <% end %>
</dl>
