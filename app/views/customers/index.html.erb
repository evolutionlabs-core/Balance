<% content_for :title, "Customers" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Customers" } ] %>
<% end %>

<% new_customer = link_to(new_customer_path, class: primary_button_class, data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New customer
<% end %>

<%= render "shared/page_header",
    title: "Customers",
    description: "Manage your customers.",
    action: new_customer %>

<% if @customers.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/users.svg",
      title: "No customers yet",
      description: "Create a customer once, then use it wherever that person or organization appears.",
      action: new_customer %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <% [ "Name", "Type", "Email", "Phone", "Status" ].each do |label| %>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @customers.each do |customer| %>
          <tr id="<%= dom_id(customer) %>" class="group border-t border-neutral-200 transition-colors hover:bg-neutral-50">
            <td class="p-0 text-sm font-medium whitespace-nowrap text-neutral-900">
              <%= link_to customer.name, customer_path(customer), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm text-neutral-600">
              <%= link_to customer.customer_type.humanize, customer_path(customer), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm text-neutral-600">
              <%= link_to customer.email.presence || blank_cell, customer_path(customer), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm text-neutral-600">
              <%= link_to customer.phone.presence || blank_cell, customer_path(customer), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm">
              <%= link_to customer_path(customer), class: "block px-4 py-4" do %>
                <%= customer_status(customer) %>
              <% end %>
            </td>
            <td class="px-4 py-4 text-right text-sm">
              <%= link_to "Edit", edit_customer_path(customer), class: "font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" }, aria: { label: "Edit #{customer.name}" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
