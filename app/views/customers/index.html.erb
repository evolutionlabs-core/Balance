<% content_for :title, "Customers" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Customers" } ] %>
<% end %>

<% new_customer = link_to(new_customer_path, class: primary_button_class(size: :compact), data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New customer
<% end %>

<%= render "shared/page_header",
    title: "Customers",
    description: "Manage your customers.",
    action: new_customer %>

<% if @customers.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/users.svg",
      title: "No customers yet",
      description: "Create a customer once, then use it wherever that person or organization appears.",
      action: new_customer %>
<% else %>
  <div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200 sm:hidden">
    <% @customers.each do |customer| %>
      <article class="py-4">
        <div class="flex items-start justify-between gap-3">
          <%= link_to customer.name, customer_path(customer), class: "min-w-0 flex-1 truncate text-sm font-medium text-neutral-950" %>
          <%= customer_status(customer) %>
        </div>
        <p class="mt-1 truncate text-sm text-neutral-500"><%= customer.email.presence || customer.phone.presence || customer.customer_type.humanize %></p>
        <div class="mt-1 flex items-center justify-between gap-3">
          <span class="truncate text-xs text-neutral-500"><%= [customer.customer_type.humanize, customer.phone.presence].compact.join(" · ") %></span>
          <%= link_to "Edit", edit_customer_path(customer), class: "flex min-h-11 shrink-0 items-center px-1 text-sm font-medium text-balance-teal-700", data: { turbo_frame: "modal" }, aria: { label: "Edit #{customer.name}" } %>
        </div>
      </article>
    <% end %>
  </div>
  <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [
        { label: "Name" }, { label: "Type" }, { label: "Email" }, { label: "Phone" }, { label: "Status" }, { label: "Actions", align: :right }
      ] } do %>
    <% @customers.each do |customer| %>
      <tr id="<%= dom_id(customer) %>" class="<%= table_row_class %>">
        <td class="<%= table_cell_class(strong: true, link: true) %> whitespace-nowrap">
          <%= link_to customer.name, customer_path(customer), class: table_cell_link_class %>
        </td>
        <% [ customer.customer_type.humanize, customer.email.presence || blank_cell, customer.phone.presence || blank_cell ].each do |value| %>
          <td class="<%= table_cell_class(link: true) %>"><%= link_to value, customer_path(customer), class: table_cell_link_class %></td>
        <% end %>
        <td class="<%= table_cell_class(link: true) %>">
          <%= link_to customer_path(customer), class: table_cell_link_class do %><%= customer_status(customer) %><% end %>
        </td>
        <td class="<%= table_cell_class(align: :right) %>">
          <%= link_to "Edit", edit_customer_path(customer), class: "font-medium text-balance-teal-700 hover:underline", data: { turbo_frame: "modal" }, aria: { label: "Edit #{customer.name}" } %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
