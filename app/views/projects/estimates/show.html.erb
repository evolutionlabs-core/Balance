<% content_for :title, "Estimate #{@estimate.number}" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Projects", path: projects_path }, { label: @project.name, path: project_path(@project) }, { label: @estimate.number } ] %>
<% end %>

<div class="mx-auto max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Edit", edit_project_estimate_path(@estimate), class: secondary_button_class(size: :sm) unless @estimate.invoiced? %>
      <%= link_to "Download", project_estimate_path(@estimate, format: :pdf), class: primary_button_class(size: :sm), data: { turbo: false } %>
      <% if @estimate.may_convert_to_invoice? %>
        <%= button_to "Convert to Invoice", project_estimate_conversion_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
      <% if @estimate.may_send_to_client? %>
        <%= button_to "Mark as sent", project_estimate_delivery_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
        <%= button_to "Create client link", project_estimate_review_link_path(@estimate),
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
      <% if @estimate.sent? %>
        <div data-controller="menu" data-action="keydown->menu#dismiss" class="relative inline-block text-left">
          <button type="button" data-menu-target="button" data-action="menu#toggle"
              class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-neutral-300 text-neutral-600 transition-colors hover:bg-neutral-50 hover:text-neutral-950"
              aria-label="Client actions" aria-haspopup="menu" aria-expanded="false">
            <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4" %>
          </button>
          <div data-menu-target="menu" role="menu" class="hidden w-52 rounded-md border border-neutral-200 bg-white p-1 text-left shadow-md">
            <button type="button" role="menuitem" data-controller="copy"
                data-copy-value-value="<%= estimate_review_url(@estimate.generate_token_for(:client_review)) %>"
                data-action="copy#copy" class="<%= menu_item_class %>">
              <span data-copy-target="defaultIcon" class="flex items-center gap-2.5">
                <%= inline_svg_tag "icons/copy.svg", class: "h-4 w-4 flex-none" %>
                Copy client link
              </span>
              <span hidden data-copy-target="doneIcon" class="flex items-center gap-2.5 text-green-600">
                <%= inline_svg_tag "icons/check.svg", class: "h-4 w-4 flex-none" %>
                Link copied
              </span>
            </button>
            <%= button_to project_estimate_approval_path(@estimate), class: menu_item_class,
                form: { class: "contents" }, role: "menuitem" do %>
              <%= inline_svg_tag "icons/check-circle.svg", class: "h-4 w-4 flex-none" %>
              Approve manually
            <% end %>
            <%= button_to project_estimate_decline_path(@estimate), class: menu_item_class,
                form: { class: "contents" }, role: "menuitem" do %>
              <%= inline_svg_tag "icons/x.svg", class: "h-4 w-4 flex-none" %>
              Decline manually
            <% end %>
          </div>
        </div>
      <% end %>
      <% if @estimate.may_reopen? %>
        <%= button_to "Reopen", project_estimate_reopening_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
    </div>
    <%= estimate_status_badge(@estimate) %>
  </div>

  <%= render "projects/estimates/document", document: @estimate.review_content %>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <%= link_to "Back to estimates", project_project_estimates_path(@project), class: ghost_button_class %>
  </div>
</div>
