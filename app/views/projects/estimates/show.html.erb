<% content_for :title, "Estimate #{@estimate.number}" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Projects", path: projects_path }, { label: @project.name, path: project_path(@project) }, { label: @estimate.number } ] %>
<% end %>

<div class="mx-auto max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Edit", edit_project_estimate_path(@estimate), class: secondary_button_class(size: :sm) unless @estimate.invoiced? %>
      <%= link_to "Download", project_estimate_path(@estimate, format: :pdf), class: primary_button_class(size: :sm), data: { turbo: false } %>
      <% if @estimate.may_convert_to_invoice? %>
        <%= button_to "Convert to Invoice", project_estimate_conversion_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
      <% if @estimate.may_send_to_client? %>
        <%= button_to "Mark as sent", project_estimate_delivery_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
      <% if @estimate.may_reopen? %>
        <%= button_to "Reopen", project_estimate_reopening_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
    </div>
    <%= estimate_status_badge(@estimate) %>
  </div>

  <% if @estimate.draft? %>
    <div class="mt-5">
      <%= button_to "Create client review link", project_estimate_review_link_path(@estimate), class: secondary_button_class(size: :sm) %>
      <p class="mt-2 text-sm text-neutral-500">Marks this estimate as sent. Share the link yourself; no email is sent.</p>
    </div>
  <% elsif @estimate.sent? %>
    <div class="mt-5" data-controller="clipboard">
      <label for="client-review-link" class="block text-sm font-medium">Client review link</label>
      <div class="mt-2 flex gap-2">
        <%= text_field_tag :client_review_link, estimate_review_url(@estimate.generate_token_for(:client_review)), id: "client-review-link", readonly: true, class: "min-w-0 flex-1 rounded-md border border-neutral-300 p-2 text-sm", data: { clipboard_target: "input" } %>
        <button type="button" class="<%= secondary_button_class(size: :sm) %>" data-action="clipboard#copy">Copy link</button>
      </div>
      <p class="mt-2 text-sm text-neutral-500">Anyone with this link can respond. Valid for 30 days; edits or a decision invalidate it.</p>
      <p role="status" class="text-sm text-neutral-600" data-clipboard-target="status"></p>
      <div class="mt-3 flex gap-3">
        <%= button_to "Record manual approval", project_estimate_approval_path(@estimate), class: secondary_button_class(size: :sm) %>
        <%= button_to "Record manual decline", project_estimate_decline_path(@estimate), class: secondary_button_class(size: :sm) %>
      </div>
    </div>
  <% end %>

  <%= render "projects/estimates/document", document: @estimate.review_content %>

  <% if @estimate.client_decided_at? %>
    <details class="mt-6 border border-neutral-200 p-4">
      <summary class="cursor-pointer text-sm font-medium">Client <%= @estimate.client_decision %> on <%= @estimate.client_decided_at.to_fs(:long) %> · View reviewed estimate</summary>
      <%= render "projects/estimates/document", document: @estimate.client_review_snapshot %>
    </details>
  <% end %>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <%= link_to "Back to estimates", project_project_estimates_path(@project), class: ghost_button_class %>
  </div>
</div>
