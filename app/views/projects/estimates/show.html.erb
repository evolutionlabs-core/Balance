<% content_for :title, "Estimate #{@estimate.number}" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Projects", path: projects_path }, { label: @project.name, path: project_path(@project) }, { label: @estimate.number } ] %>
<% end %>

<div class="mx-auto max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Edit", edit_project_estimate_path(@estimate), class: secondary_button_class(size: :sm) unless @estimate.invoiced? %>
      <%= link_to "Download", project_estimate_path(@estimate, format: :pdf), class: primary_button_class(size: :sm), data: { turbo: false } %>
      <% if @estimate.may_convert_to_invoice? %>
        <%= button_to "Convert to Invoice", project_estimate_conversion_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
      <% if @estimate.may_send_to_client? %>
        <%= button_to "Mark as sent", project_estimate_delivery_path(@estimate), method: :post,
            class: "cursor-pointer bg-transparent text-sm font-medium text-[#0f7082] hover:underline" %>
      <% end %>
    </div>
    <%= estimate_status_badge(@estimate) %>
  </div>

  <article class="mt-6 border border-neutral-200 bg-white shadow-sm">
    <header class="flex flex-col gap-8 border-b border-neutral-200 px-8 py-10 sm:flex-row sm:justify-between md:px-12">
      <div>
        <p class="text-2xl font-semibold tracking-tight text-[#0f7082]">ESTIMATE</p>
        <p class="mt-5 font-semibold text-neutral-950"><%= @estimate.business_name.presence || @project.workspace.name %></p>
        <p class="mt-1 text-sm text-neutral-500"><%= @estimate.business_email.presence || "—" %></p>
        <% if @estimate.business_address.present? %>
          <p class="mt-1 whitespace-pre-line text-sm text-neutral-500"><%= @estimate.business_address %></p>
        <% end %>
      </div>
    </header>

    <section class="bg-[#f4f8f8] px-8 py-7 md:px-12">
      <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Bill to</p>
      <% if @estimate.bill_to_name.present? || @estimate.bill_to_email.present? || @estimate.bill_to_address.present? %>
        <p class="mt-2 font-semibold text-neutral-950"><%= @estimate.bill_to_name.presence || "—" %></p>
        <p class="mt-1 text-sm text-neutral-600"><%= @estimate.bill_to_email.presence || "—" %></p>
        <% if @estimate.bill_to_address.present? %>
          <p class="mt-1 whitespace-pre-line text-sm text-neutral-600"><%= @estimate.bill_to_address %></p>
        <% end %>
      <% else %>
        <p class="mt-2 text-sm text-neutral-400">No customer selected</p>
      <% end %>
    </section>

    <section class="px-8 py-8 md:px-12">
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead>
            <tr class="border-b border-neutral-200">
              <th class="py-3 text-left text-xs font-medium text-neutral-500">Description</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Qty</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Rate</th>
              <th class="py-3 text-right text-xs font-medium text-neutral-500">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% @estimate.line_items.each do |line| %>
              <tr class="border-b border-neutral-200">
                <td class="py-4 text-sm text-neutral-900"><%= line.description.presence || "—" %></td>
                <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line.quantity || "—" %></td>
                <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line.rate_minor ? minor_currency(line.rate_minor, @estimate.currency_code) : "—" %></td>
                <td class="py-4 text-right text-sm font-medium tabular-nums text-neutral-950"><%= minor_currency(line.amount_minor, @estimate.currency_code) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @estimate.line_items.empty? %>
          <p class="border-b border-neutral-200 py-8 text-center text-sm text-neutral-400">No line items added</p>
        <% end %>
      </div>

      <dl class="mt-8 ml-auto max-w-sm">
        <div class="flex justify-between text-sm">
          <dt class="text-neutral-500">Subtotal</dt>
          <dd class="font-medium tabular-nums text-neutral-950"><%= minor_currency(@estimate.subtotal_minor, @estimate.currency_code) %></dd>
        </div>
        <div class="mt-4 flex justify-between border-t border-neutral-200 pt-4">
          <dt class="font-semibold text-neutral-950">Total</dt>
          <dd class="text-xl font-semibold tabular-nums text-neutral-950"><%= minor_currency(@estimate.total_minor, @estimate.currency_code) %></dd>
        </div>
      </dl>
    </section>

    <% if @estimate.notes.present? %>
      <section class="border-t border-neutral-200 px-8 py-6 md:px-12">
        <h2 class="text-sm font-semibold text-neutral-950">Notes</h2>
        <p class="mt-2 whitespace-pre-line text-sm text-neutral-600"><%= @estimate.notes %></p>
      </section>
    <% end %>
  </article>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <%= link_to "Back to estimates", project_project_estimates_path(@project), class: ghost_button_class %>
  </div>
</div>
