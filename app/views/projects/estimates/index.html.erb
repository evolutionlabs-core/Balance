<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :estimates %>

<div class="mt-6 flex items-center justify-between gap-4">
  <h2 class="text-sm font-semibold text-neutral-950">Estimates</h2>
  <%= link_to(new_project_project_estimate_path(@project), class: secondary_button_class(size: :sm)) do %>
    <%= inline_svg_tag "icons/plus.svg", class: "h-3.5 w-3.5" %>New estimate
  <% end %>
</div>

<% if @estimates.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No estimates yet",
      description: "Send the client an upfront view of what you plan to spend.",
      action: link_to("New estimate", new_project_project_estimate_path(@project), class: primary_button_class(size: :sm)) %>
<% else %>
  <%= render layout: "shared/mobile_list", locals: { frame_class: "mt-4" } do %>
    <% @estimates.each do |estimate| %>
      <%= render "shared/mobile_card", title: estimate.number, url: project_estimate_path(estimate),
          trailing: mobile_card_amount(minor_currency(estimate.total_minor, estimate.currency_code)),
          footer: estimate_status_badge(estimate),
          action: render("projects/estimates/actions_menu", estimate: estimate) %>
    <% end %>
  <% end %>
  <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [ { label: "Estimate" }, { label: "Total", align: :right }, { label: "Status" }, { label: "Actions", align: :right } ] } do %>
    <% @estimates.each do |estimate| %>
      <tr class="<%= table_row_class %>">
        <td class="<%= table_cell_class(strong: true, link: true) %> whitespace-nowrap">
          <%= link_to estimate.number, project_estimate_path(estimate), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(align: :right, link: true) %> tabular-nums whitespace-nowrap">
          <%= link_to minor_currency(estimate.total_minor, estimate.currency_code), project_estimate_path(estimate), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
          <%= link_to project_estimate_path(estimate), class: table_cell_link_class do %>
            <%= estimate_status_badge(estimate) %>
          <% end %>
        </td>
        <td class="<%= table_cell_class(align: :right) %> py-2 whitespace-nowrap">
          <%= render "projects/estimates/actions_menu", estimate: estimate %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
