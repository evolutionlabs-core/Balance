<article class="mt-6 border border-neutral-200 bg-white shadow-sm">
  <header class="flex flex-col gap-8 border-b border-neutral-200 px-8 py-10 sm:flex-row sm:justify-between md:px-12">
    <div>
      <p class="text-2xl font-semibold tracking-tight text-[#0f7082]">ESTIMATE</p>
      <p class="mt-5 font-semibold text-neutral-950"><%= document["business_name"].presence || "—" %></p>
      <p class="mt-1 text-sm text-neutral-500"><%= document["business_email"].presence || "—" %></p>
      <% if document["business_address"].present? %>
        <p class="mt-1 whitespace-pre-line text-sm text-neutral-500"><%= document["business_address"] %></p>
      <% end %>
    </div>
  </header>

  <section class="bg-[#f4f8f8] px-8 py-7 md:px-12">
    <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Bill to</p>
    <% if document["bill_to_name"].present? || document["bill_to_email"].present? || document["bill_to_address"].present? %>
      <p class="mt-2 font-semibold text-neutral-950"><%= document["bill_to_name"].presence || "—" %></p>
      <p class="mt-1 text-sm text-neutral-600"><%= document["bill_to_email"].presence || "—" %></p>
      <% if document["bill_to_address"].present? %>
        <p class="mt-1 whitespace-pre-line text-sm text-neutral-600"><%= document["bill_to_address"] %></p>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm text-neutral-400">No customer selected</p>
    <% end %>
  </section>

  <section class="px-8 py-8 md:px-12">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-neutral-200">
            <th class="py-3 text-left text-xs font-medium text-neutral-500">Description</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Qty</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Rate</th>
            <th class="py-3 text-right text-xs font-medium text-neutral-500">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% document["line_items"].each do |line| %>
            <tr class="border-b border-neutral-200">
              <td class="py-4 text-sm text-neutral-900"><%= line["description"].presence || "—" %></td>
              <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line["quantity"] || "—" %></td>
              <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line["rate_minor"] ? minor_currency(line["rate_minor"], document["currency_code"]) : "—" %></td>
              <td class="py-4 text-right text-sm font-medium tabular-nums text-neutral-950"><%= minor_currency(line["amount_minor"], document["currency_code"]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if document["line_items"].empty? %>
        <p class="border-b border-neutral-200 py-8 text-center text-sm text-neutral-400">No line items added</p>
      <% end %>
    </div>

    <dl class="mt-8 ml-auto max-w-sm">
      <div class="flex justify-between text-sm">
        <dt class="text-neutral-500">Subtotal</dt>
        <dd class="font-medium tabular-nums text-neutral-950"><%= minor_currency(document["subtotal_minor"], document["currency_code"]) %></dd>
      </div>
      <div class="mt-4 flex justify-between border-t border-neutral-200 pt-4">
        <dt class="font-semibold text-neutral-950">Total</dt>
        <dd class="text-xl font-semibold tabular-nums text-neutral-950"><%= minor_currency(document["total_minor"], document["currency_code"]) %></dd>
      </div>
    </dl>
  </section>

  <% if document["notes"].present? %>
    <section class="border-t border-neutral-200 px-8 py-6 md:px-12">
      <h2 class="text-sm font-semibold text-neutral-950">Notes</h2>
      <p class="mt-2 whitespace-pre-line text-sm text-neutral-600"><%= document["notes"] %></p>
    </section>
  <% end %>
</article>
