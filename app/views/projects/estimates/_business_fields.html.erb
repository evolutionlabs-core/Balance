<%= turbo_frame_tag dom_id(estimate, :business), class: "mt-5 block" do %>
  <p class="font-semibold text-neutral-950"><%= estimate.business_name.presence || project.workspace.name %></p>
  <p class="mt-1 text-sm text-neutral-600"><%= estimate.business_email.presence || Current.user.email_address %></p>
  <% if estimate.business_address.present? || project.workspace.address.present? %>
    <p class="mt-1 whitespace-pre-line text-sm text-neutral-600"><%= estimate.business_address.presence || project.workspace.address %></p>
  <% end %>
  <%= link_to "Edit company", edit_project_project_estimate_workspace_path(project, estimate_id: (estimate.id if estimate.persisted?)),
      class: "mt-4 inline-block text-sm font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" } %>
<% end %>
