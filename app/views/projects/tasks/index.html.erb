<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :work %>
<%= render "projects/work_subnav", project: @project, active: :tasks %>

<% if @tasks.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No tasks yet",
      description: "Track the work to be done.",
      action: link_to("Add task", new_project_project_task_path(@project), class: primary_button_class(size: :sm), data: { turbo_frame: "modal" }) %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Task</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Status</th>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @tasks.each do |task| %>
          <tr class="border-t border-neutral-200">
            <td class="max-w-72 px-4 py-3 text-sm break-words text-neutral-900">
              <span class="font-medium"><%= task.title %></span>
              <% if task.description.present? %>
                <span class="mt-0.5 block font-normal break-words text-neutral-500"><%= task.description %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= task.status.humanize %></td>
            <td class="px-4 py-3 text-right text-sm whitespace-nowrap">
              <%= link_to "Log time", new_project_project_time_entry_path(@project, task_id: task.id), class: "mr-3 font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" } %>
              <%= link_to "Edit", edit_project_project_task_path(@project, task), class: "font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
