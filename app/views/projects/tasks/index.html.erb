<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :work %>
<%= render "projects/work_subnav", project: @project, active: :tasks %>

<% if @tasks.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No tasks yet",
      description: "Track the work to be done.",
      action: link_to("Add task", new_project_project_task_path(@project), class: primary_button_class(size: :sm), data: { turbo_frame: "modal" }) %>
<% else %>
  <%= render layout: "shared/mobile_list", locals: { frame_class: "mt-4" } do %>
    <% @tasks.each do |task| %>
      <%= render "shared/mobile_card", title: task.title, meta: task.description, footer: task.status.humanize,
          action: safe_join([
            link_to("Log time", new_project_project_time_entry_path(@project, task_id: task.id), class: mobile_card_action_class, data: { turbo_frame: "modal" }),
            link_to("Edit", edit_project_project_task_path(@project, task), class: mobile_card_action_class, data: { turbo_frame: "modal" })
          ]) %>
    <% end %>
  <% end %>
  <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [ { label: "Task" }, { label: "Status" }, { label: "", align: :right } ] } do %>
    <% @tasks.each do |task| %>
      <tr class="<%= table_row_class %>">
        <td class="<%= table_cell_class(strong: true) %> max-w-72 break-words">
          <span><%= task.title %></span>
          <% if task.description.present? %>
            <span class="mt-0.5 block font-normal break-words text-neutral-500"><%= task.description %></span>
          <% end %>
        </td>
        <td class="<%= table_cell_class %> whitespace-nowrap"><%= task.status.humanize %></td>
        <td class="<%= table_cell_class(align: :right) %> whitespace-nowrap">
          <%= link_to "Log time", new_project_project_time_entry_path(@project, task_id: task.id), class: "mr-3 font-medium text-balance-teal-700 hover:underline", data: { turbo_frame: "modal" } %>
          <%= link_to "Edit", edit_project_project_task_path(@project, task), class: "font-medium text-balance-teal-700 hover:underline", data: { turbo_frame: "modal" } %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
