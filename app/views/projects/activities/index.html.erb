<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :activity %>

<h2 class="mt-6 text-sm font-semibold text-neutral-950">Activity</h2>

<% if @events.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No activity yet",
      description: "Logged time will appear here." %>
<% else %>
  <ol class="mt-4 divide-y divide-neutral-100 border-y border-neutral-200">
    <% @events.each do |event| %>
      <li class="flex items-baseline gap-3 py-2.5">
        <span class="w-24 shrink-0 text-sm tabular-nums whitespace-nowrap text-neutral-500"><%= event[:date].strftime("%b %-d, %Y") %></span>
        <span class="min-w-0 flex-1 text-sm text-neutral-900"><%= project_activity_description(@project, event) %></span>
      </li>
    <% end %>
  </ol>
<% end %>
