<%= render "shared/modal" do %>
  <%= form_with model: @project, url: project_project_budget_path(@project), class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: @project.cost_budget_kobo? ? "Edit budget" : "Set budget" %>

    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @project %>

      <div>
        <%= form.label :cost_budget, "Budget amount (NGN)", class: field_label_class %>
        <%= form.number_field :cost_budget, min: 0, step: 0.01, placeholder: "Enter budget amount", required: true, class: field_class %>
      </div>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Save budget" %>
  <% end %>
<% end %>
