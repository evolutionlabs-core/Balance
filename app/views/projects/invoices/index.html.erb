<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :invoices %>

<div class="mt-6 flex items-center justify-between gap-4">
  <h2 class="text-sm font-semibold text-neutral-950">Invoices</h2>
</div>

<% if @invoices.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/invoice.svg",
      title: "No invoices yet",
      description: "Approved estimates converted to invoices will appear here." %>
<% else %>
  <%= render layout: "shared/mobile_list", locals: { frame_class: "mt-4" } do %>
    <% @invoices.each do |invoice| %>
      <%= render "shared/mobile_card", title: invoice.invoice_number.presence || blank_cell, url: invoice_path(invoice),
          trailing: mobile_card_amount(minor_currency(invoice.total_minor, invoice.currency_code)),
          meta: [ invoice.issue_date&.strftime("%b %-d, %Y"), ("Due #{invoice.due_date.strftime("%b %-d")}" if invoice.due_date) ].compact.join(" · "),
          footer: invoice_status_badge(invoice),
          action: (link_to("Edit", edit_invoice_path(invoice), class: mobile_card_action_class) if invoice.draft?) %>
    <% end %>
  <% end %>
  <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [ { label: "Invoice" }, { label: "Total", align: :right }, { label: "Status" }, { label: "Date" }, { label: "Due date" }, { label: "", align: :right } ] } do %>
    <% @invoices.each do |invoice| %>
      <tr class="<%= table_row_class %>">
        <td class="<%= table_cell_class(strong: true, link: true) %> whitespace-nowrap">
          <%= link_to invoice.invoice_number.presence || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(align: :right, link: true) %> tabular-nums whitespace-nowrap">
          <%= link_to minor_currency(invoice.total_minor, invoice.currency_code), invoice_path(invoice), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
          <%= link_to invoice_path(invoice), class: table_cell_link_class do %>
            <%= invoice_status_badge(invoice) %>
          <% end %>
        </td>
        <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
          <%= link_to invoice.issue_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
          <%= link_to invoice.due_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(align: :right) %> whitespace-nowrap">
          <%= link_to "Edit", edit_invoice_path(invoice), class: "font-medium text-balance-teal-700 hover:underline" if invoice.draft? %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
