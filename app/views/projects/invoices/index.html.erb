<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :invoices %>

<div class="mt-6 flex items-center justify-between gap-4">
  <h2 class="text-sm font-semibold text-neutral-950">Invoices</h2>
</div>

<% if @invoices.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/invoice.svg",
      title: "No invoices yet",
      description: "Approved estimates converted to invoices will appear here." %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Invoice</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Total</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Due date</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-neutral-500"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @invoices.each do |invoice| %>
          <tr class="border-t border-neutral-200">
            <td class="p-0 text-sm font-medium whitespace-nowrap text-neutral-900">
              <%= link_to invoice.invoice_number.presence || "—", invoice_path(invoice), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-right text-sm tabular-nums whitespace-nowrap text-neutral-600">
              <%= link_to minor_currency(invoice.total_minor, invoice.currency_code), invoice_path(invoice), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm whitespace-nowrap">
              <%= link_to invoice_path(invoice), class: "block px-4 py-4" do %>
                <%= invoice_status_badge(invoice) %>
              <% end %>
            </td>
            <td class="p-0 text-sm whitespace-nowrap text-neutral-600">
              <%= link_to invoice.issue_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm whitespace-nowrap text-neutral-600">
              <%= link_to invoice.due_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: "block px-4 py-4" %>
            </td>
            <td class="px-4 py-4 text-right text-sm whitespace-nowrap">
              <%= link_to "Edit", edit_invoice_path(invoice), class: "font-medium text-[#0f7082] hover:underline" unless invoice.posted? %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
