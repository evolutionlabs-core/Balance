<% content_for :title, "Projects" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Projects" } ] %>
<% end %>

<% new_project = link_to(new_project_path, class: primary_button_class(size: :compact), data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New project
<% end %>

<%= render "shared/page_header",
    title: "Projects",
    description: "Track estimates, work, costs, invoices, and payments for each customer.",
    action: new_project %>

<% if @projects.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/project.svg",
      title: "No projects yet",
      description: "Create a project to combine fixed-price work, hourly work, and expenses.",
      action: new_project %>
<% else %>
  <%= render layout: "shared/mobile_list", locals: { frame_class: "mt-4" } do %>
    <% @projects.each do |project| %>
      <%= render "shared/mobile_card", title: project.name, url: project_path(project), meta: project.customer.name,
          action: link_to("Edit", edit_project_path(project), class: mobile_card_action_class, data: { turbo_frame: "modal" }, aria: { label: "Edit #{project.name}" }) %>
    <% end %>
  <% end %>
  <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [ { label: "Name" }, { label: "Customer" }, { label: "Actions", align: :right } ] } do %>
    <% @projects.each do |project| %>
      <tr id="<%= dom_id(project) %>" class="<%= table_row_class %>">
        <td class="<%= table_cell_class(strong: true, link: true) %> whitespace-nowrap">
          <%= link_to project.name, project_path(project), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(link: true) %>">
          <%= link_to project.customer.name, project_path(project), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(align: :right) %>">
          <%= link_to "Edit", edit_project_path(project), class: "font-medium text-balance-teal-700 hover:underline", data: { turbo_frame: "modal" }, aria: { label: "Edit #{project.name}" } %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
