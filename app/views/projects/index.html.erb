<% content_for :title, "Projects" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Projects" } ] %>
<% end %>

<% new_project = link_to(new_project_path, class: primary_button_class(size: :compact), data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New project
<% end %>

<%= render "shared/page_header",
    title: "Projects",
    description: "Track estimates, work, costs, invoices, and payments for each customer.",
    action: new_project %>

<% if @projects.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/project.svg",
      title: "No projects yet",
      description: "Create a project to combine fixed-price work, hourly work, and expenses.",
      action: new_project %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <% [ "Name", "Customer" ].each do |label| %>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @projects.each do |project| %>
          <tr id="<%= dom_id(project) %>" class="group border-t border-neutral-200 transition-colors hover:bg-neutral-50">
            <td class="p-0 text-sm font-medium whitespace-nowrap text-neutral-900">
              <%= link_to project.name, project_path(project), class: "block px-4 py-4" %>
            </td>
            <td class="p-0 text-sm text-neutral-600">
              <%= link_to project.customer.name, project_path(project), class: "block px-4 py-4" %>
            </td>
            <td class="px-4 py-4 text-right text-sm">
              <%= link_to "Edit", edit_project_path(project), class: "font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" }, aria: { label: "Edit #{project.name}" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
