<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :work %>
<%= render "projects/work_subnav", project: @project, active: :time %>

<% if @time_entries.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No time logged yet",
      description: "Log dated work against a task, or on its own.",
      action: link_to("Log time", new_project_project_time_entry_path(@project), class: primary_button_class(size: :sm), data: { turbo_frame: "modal" }) %>
<% else %>
  <%= render layout: "shared/table", locals: { columns: [ { label: "Date" }, { label: "Work performed" }, { label: "Task" }, { label: "Hours", align: :right }, { label: "", align: :right } ] } do %>
    <% @time_entries.each do |entry| %>
      <tr class="<%= table_row_class %>">
        <td class="<%= table_cell_class %> whitespace-nowrap"><%= entry.occurred_on.strftime("%b %-d, %Y") %></td>
        <td class="<%= table_cell_class(strong: true) %> max-w-72 break-words"><%= entry.description %></td>
        <td class="<%= table_cell_class %> whitespace-nowrap"><%= entry.task&.title || blank_cell %></td>
        <td class="<%= table_cell_class(align: :right, strong: true) %> tabular-nums whitespace-nowrap"><%= entry.hours %></td>
        <td class="<%= table_cell_class(align: :right) %> whitespace-nowrap">
          <%= link_to "Edit", edit_project_project_time_entry_path(@project, entry), class: "font-medium text-balance-teal-700 hover:underline", data: { turbo_frame: "modal" } %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
