<%= render "projects/project_header", project: @project %>
<%= render "projects/project_tabs", project: @project, active_tab: :work %>
<%= render "projects/work_subnav", project: @project, active: :time %>

<% if @time_entries.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No time logged yet",
      description: "Log dated work against a task, or on its own.",
      action: link_to("Log time", new_project_project_time_entry_path(@project), class: primary_button_class(size: :sm), data: { turbo_frame: "modal" }) %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Date</th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Work performed</th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Task</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Hours</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @time_entries.each do |entry| %>
          <tr class="border-t border-neutral-200">
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= entry.occurred_on.strftime("%b %-d, %Y") %></td>
            <td class="max-w-72 px-4 py-3 text-sm break-words text-neutral-900"><%= entry.description %></td>
            <td class="px-4 py-3 text-sm whitespace-nowrap text-neutral-600"><%= entry.task&.title || "—" %></td>
            <td class="px-4 py-3 text-right text-sm tabular-nums whitespace-nowrap text-neutral-900"><%= entry.hours %></td>
            <td class="px-4 py-3 text-right text-sm whitespace-nowrap">
              <%= link_to "Edit", edit_project_project_time_entry_path(@project, entry), class: "font-medium text-[#0f7082] hover:underline", data: { turbo_frame: "modal" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
