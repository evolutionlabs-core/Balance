<%= form_with model: [ @project, time_entry ], class: "flex min-h-0 flex-1 flex-col" do |form| %>
  <%= render "shared/modal/header", title: time_entry.persisted? ? "Edit time entry" : "Log time" %>

  <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
    <%= render "shared/form_errors", record: time_entry %>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :occurred_on, "Date", class: field_label_class %>
        <%= form.text_field :occurred_on, class: "#{field_class} cursor-pointer", data: { controller: "date-picker" }, autocomplete: "off" %>
      </div>
      <div>
        <%= form.label :hours, class: field_label_class %>
        <%= form.number_field :hours, min: 0.25, max: 24, step: 0.25, required: true, autofocus: true, class: field_class %>
      </div>
    </div>

    <div>
      <%= form.label :project_task_id, "Task (optional)", class: field_label_class %>
      <%= form.collection_select :project_task_id, @project.tasks.ordered, :id, :title,
          { include_blank: "No task" }, { class: field_class } %>
    </div>

    <div>
      <%= form.label :description, "Work performed", class: field_label_class %>
      <%= form.text_field :description, required: true, placeholder: "Meaningful description of work done", class: field_class %>
    </div>

    <div>
      <%= form.label :internal_note, "Private note (never shown to client)", class: field_label_class %>
      <%= form.text_field :internal_note, class: field_class %>
    </div>
  </div>

  <%= render "shared/modal/footer", form: form, submit_label: time_entry.persisted? ? "Save changes" : "Log time" %>
<% end %>
