<div class="mx-auto max-w-6xl" data-controller="document-editor form" data-document-editor-currency-value="<%= invoice.currency_code %>">
  <% if invoice.persisted? %>
    <%= form_with model: invoice, url: invoice_calculation_path, method: :post, id: "new_invoice_form",
        data: { document_editor_target: "form", save_url: invoice_path(invoice), save_method: "patch" } do %>
      <%= hidden_field_tag :_method, "post" %>
    <% end %>
  <% else %>
    <%= form_with model: invoice, url: invoice_calculation_path, method: :post, id: "new_invoice_form" do %>
    <% end %>
  <% end %>

  <% tab_class = "inline-flex cursor-pointer items-center gap-1.5 whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium text-neutral-500 transition-colors hover:text-neutral-900 aria-selected:bg-white aria-selected:text-neutral-950 aria-selected:shadow-sm" %>
  <div role="tablist" aria-label="Invoice editor" class="mb-5 inline-flex gap-1 rounded-lg bg-neutral-100 p-1">
    <button type="button" role="tab" aria-selected="true" class="<%= tab_class %>"
        data-document-editor-target="tab" data-panel="edit" data-action="document-editor#show">
      <%= inline_svg_tag "icons/edit.svg", class: "h-4 w-4", aria: { hidden: true } %>Edit
    </button>
    <%= button_tag type: "submit", role: "tab", aria: { selected: false }, class: tab_class, form: "new_invoice_form",
        formaction: invoice_preview_path(invoice_id: (invoice.id if invoice.persisted?)), formmethod: :post, formnovalidate: true,
        data: { turbo_frame: "invoice_preview", document_editor_target: "tab", panel: "preview", action: "document-editor#show" } do %>
      <%= inline_svg_tag "icons/eye.svg", class: "h-4 w-4", aria: { hidden: true } %>Preview
    <% end %>
  </div>

  <section role="tabpanel" aria-label="Edit" data-document-editor-target="panel" data-panel="edit">
    <article class="border border-neutral-200 bg-white shadow-sm">
      <div class="flex flex-col gap-5 border-b border-neutral-200 px-4 py-6 sm:flex-row sm:items-start sm:justify-between sm:px-8 sm:py-10 md:px-12">
        <div class="w-full max-w-md">
          <p class="flex flex-wrap items-baseline gap-x-3 text-2xl font-semibold tracking-tight text-balance-teal-700">
            INVOICE
            <% if invoice.invoice_number.present? %>
              <span id="invoice_number" class="text-base font-medium tabular-nums text-neutral-500"><%= invoice.invoice_number %></span>
            <% end %>
          </p>
          <%= render "invoices/business_fields", invoice: invoice %>
        </div>
        <div class="sm:text-right">
          <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Balance due</p>
          <p id="invoice_balance_due" class="mt-1 text-2xl font-semibold tabular-nums text-neutral-950" data-document-editor-target="total"><%= minor_currency(invoice.total_minor, invoice.currency_code) %></p>
        </div>
      </div>

      <div id="invoice_errors"><%= render "shared/form_errors", record: invoice %></div>

      <div class="grid gap-6 bg-balance-teal-50 px-4 py-6 sm:px-8 sm:py-8 md:grid-cols-[1.2fr_1fr] md:px-12">
        <%= render "invoices/customer", invoice: invoice %>
        <%= render invoice.persisted? ? "invoices/details" : "invoices/new_details", invoice: invoice %>
      </div>

      <section class="px-4 py-6 sm:px-6 sm:py-7 md:px-10">
        <div class="mb-4">
          <h2 class="text-sm font-semibold text-neutral-950">Product or service</h2>
          <p class="mt-1 text-sm text-neutral-500">Type to find a service, or describe the charge.</p>
        </div>

        <%= render layout: "shared/line_items/table", locals: { document: invoice, scope: "invoice", add_path: new_invoice_line_path, add_label: "Add line", totals: false } do %>
          <% invoice.invoice_lines.each_with_index do |line, index| %>
            <%= render "invoices/new_line", line: line, index: line.persisted? ? "-#{line.id}" : index, first: index.zero? %>
          <% end %>
        <% end %>
      </section>

      <section class="grid gap-8 border-t border-neutral-200 px-4 py-6 sm:px-6 sm:py-7 md:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] md:px-10">
        <%= render "invoices/notes", invoice: invoice %>
        <%= render "shared/line_items/summary", document: invoice, scope: "invoice", discount: true, class_name: "self-start" %>
      </section>
    </article>
  </section>

  <section role="tabpanel" aria-label="Preview" data-document-editor-target="panel" data-panel="preview" hidden>
    <%= turbo_frame_tag "invoice_preview" do %>
      <p class="py-16 text-center text-sm text-neutral-500">Loading preview…</p>
    <% end %>
  </section>

  <div class="sticky bottom-0 z-20 mt-4 flex items-center justify-between gap-2 border border-neutral-200 bg-white/95 px-3 py-3 shadow-sm backdrop-blur sm:px-6">
    <%= link_to "Cancel", invoice.persisted? ? invoice_path(invoice) : invoices_path, class: ghost_button_class %>
    <% if invoice.persisted? %>
      <div class="flex items-center gap-2">
        <%= link_to "Save draft", invoice_path(invoice), class: secondary_button_class, data: { action: "document-editor#saveAndShow" } %>
        <%= link_to "Review and send", invoice_path(invoice, view: "email"), class: primary_button_class, data: { action: "document-editor#saveAndShow" } %>
      </div>
    <% else %>
      <%= render "invoices/create_button", invoice: invoice %>
    <% end %>
  </div>
</div>
