<div class="mx-auto max-w-6xl" data-controller="invoice-editor form">
  <%= render "invoices/view_tabs", invoice: invoice, active: :edit %>

  <% if invoice.persisted? %>
    <%= form_with model: invoice, url: invoice_calculation_path, method: :post, id: "new_invoice_form",
        data: { invoice_editor_target: "form", save_url: invoice_path(invoice), save_method: "patch" } do %>
      <%= hidden_field_tag :_method, "post" %>
    <% end %>
  <% else %>
    <%= form_with model: invoice, url: invoice_calculation_path, method: :post, id: "new_invoice_form" do %>
    <% end %>
  <% end %>

  <article class="overflow-hidden border border-neutral-200 bg-white shadow-sm">
    <div class="flex flex-col gap-8 border-b border-neutral-200 px-8 py-10 sm:flex-row sm:items-start sm:justify-between md:px-12">
      <div class="w-full max-w-md">
        <p class="text-2xl font-semibold tracking-tight text-[#0f7082]">INVOICE</p>
        <%= render "invoices/business_fields", invoice: invoice %>
      </div>
      <div class="sm:text-right">
        <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Balance due</p>
        <p id="invoice_balance_due" class="mt-1 text-2xl font-semibold tabular-nums text-neutral-950"><%= minor_currency(invoice.total_minor, invoice.currency_code) %></p>
      </div>
    </div>

    <div id="invoice_errors"><%= render "shared/form_errors", record: invoice %></div>

    <div class="grid gap-8 bg-[#f4f8f8] px-8 py-8 md:grid-cols-[1.2fr_1fr] md:px-12">
      <%= render "invoices/customer", invoice: invoice %>
      <%= render invoice.persisted? ? "invoices/details" : "invoices/new_details", invoice: invoice %>
    </div>

    <section class="px-6 py-7 md:px-10">
      <div class="mb-4">
        <h2 class="text-sm font-semibold text-neutral-950">Product or service</h2>
        <p class="mt-1 text-sm text-neutral-500">Add each item included on this invoice.</p>
      </div>

      <%= turbo_frame_tag "invoice_line_items", class: "block" do %>
        <div class="overflow-x-auto border-y border-neutral-200">
          <table class="min-w-[760px] w-full">
          <thead class="bg-white">
            <tr>
              <th scope="col" class="w-14 px-4 py-2.5 text-center text-xs font-medium text-neutral-500">#</th>
              <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500">Description</th>
              <th scope="col" class="w-28 px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Qty</th>
              <th scope="col" class="w-40 px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Rate (<%= invoice.currency_code %>)</th>
              <th scope="col" class="w-40 px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Amount (<%= invoice.currency_code %>)</th>
              <th scope="col" class="w-12 px-4 py-2.5"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>

          <tbody id="invoice_lines" class="invoice-lines bg-white">
            <% if invoice.persisted? %>
              <% invoice.invoice_lines.each_with_index do |line, index| %>
                <%= render "invoices/new_line", line: line, index: line.persisted? ? "-#{line.id}" : index, first: index.zero? %>
              <% end %>
            <% else %>
              <% invoice.invoice_lines.each_with_index do |line, index| %>
                <%= render "invoices/new_line", line: line, index: index %>
              <% end %>
            <% end %>
          </tbody>
          </table>
        </div>

        <div class="mt-3">
          <%= link_to new_invoice_line_path, class: secondary_button_class(size: :sm), data: { turbo_stream: true } do %>
            <%= inline_svg_tag "icons/plus.svg", class: "h-3.5 w-3.5" %>Add product or service
          <% end %>
        </div>

        <div class="mt-8 ml-auto max-w-sm border-t border-neutral-200 pt-4">
          <div class="flex items-center justify-between text-sm">
            <span class="text-neutral-500">Subtotal</span>
            <span id="invoice_subtotal" class="font-medium tabular-nums text-neutral-950"><%= minor_currency(invoice.subtotal_minor, invoice.currency_code) %></span>
          </div>
          <div class="mt-3 flex items-center justify-between border-t border-neutral-200 pt-3">
            <span class="font-semibold text-neutral-950">Total</span>
            <span id="invoice_total" class="text-xl font-semibold tabular-nums text-neutral-950"><%= minor_currency(invoice.total_minor, invoice.currency_code) %></span>
          </div>
        </div>
      <% end %>
    </section>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 bg-neutral-50 px-6 py-4 md:px-10">
      <%= link_to "Back to invoices", invoices_path, class: ghost_button_class %>
      <% if invoice.persisted? %>
        <%= link_to "Save and preview", invoice_path(invoice), class: primary_button_class, data: { action: "invoice-editor#saveAndShow" } %>
      <% else %>
        <%= render "invoices/create_button", invoice: invoice %>
      <% end %>
    </div>
  </article>
</div>
