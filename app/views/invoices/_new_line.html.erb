<tr id="new_invoice_line_<%= index %>" class="invoice-line border-t border-neutral-200 hover:bg-neutral-50/80" data-controller="service-line">
  <td class="invoice-line-number px-4 py-3 text-center text-sm text-neutral-500"></td>
  <%= fields_for "invoice[invoice_lines_attributes][#{index}]", line, include_id: false do |form| %>
    <td class="px-2 py-2">
      <% services = @services.select { |service| service.active? || service.id == line.service_id } %>
      <% options = services.map { |service| [ service.name, service.id, { data: { description: service.description.presence || service.name, rate: service.default_rate&.to_s("F") } } ] } %>
      <%= form.label :service_id, "Service", class: "mb-1 block text-xs font-medium text-neutral-500 sm:hidden" %>
      <%= render "shared/select_menu", form: form, attribute: :service_id,
          options: options_for_select(options, line.service_id), prompt: "No service", include_blank_option: true,
          select_data: { service_line_target: "service", action: "change->service-line#applyDefaults" }, form_id: "new_invoice_form",
          searchable: true, search_placeholder: "Search services…", empty_message: "No services found", required: false %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :description, "Description", class: "mb-1 block text-xs font-medium text-neutral-500 sm:hidden" %>
      <%= form.text_field :description, form: "new_invoice_form", placeholder: "Product or service description", autocomplete: "off",
          data: { service_line_target: "description" },
          class: "block min-h-11 w-full rounded-md border border-transparent bg-transparent px-2 text-base focus:border-neutral-300 focus:bg-white sm:h-9 sm:min-h-0 sm:text-sm" %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :quantity, class: "mb-1 block text-xs font-medium text-neutral-500 sm:hidden" %>
      <%= form.number_field :quantity, form: "new_invoice_form", min: 0.001, step: 0.001, placeholder: "1", inputmode: "decimal", aria: { label: "Quantity" },
          data: { service_line_target: "quantity", action: "input->service-line#calculateAmount change->form#submit" },
          class: "block min-h-11 w-full rounded-md border border-transparent bg-transparent px-2 text-right text-base tabular-nums focus:border-neutral-300 focus:bg-white sm:h-9 sm:min-h-0 sm:text-sm" %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :rate, class: "mb-1 block text-xs font-medium text-neutral-500 sm:hidden" %>
      <%= form.number_field :rate, form: "new_invoice_form", min: 0, step: 0.01, placeholder: "0.00", inputmode: "decimal", aria: { label: "Rate" },
          data: { action: "input->service-line#calculateAmount change->form#submit", service_line_target: "rate" },
          class: "block min-h-11 w-full rounded-md border border-transparent bg-transparent px-2 text-right text-base tabular-nums focus:border-neutral-300 focus:bg-white sm:h-9 sm:min-h-0 sm:text-sm" %>
    </td>
    <td class="px-2 py-2">
      <%= form.label :amount, class: "mb-1 block text-xs font-medium text-neutral-500 sm:hidden" %>
      <%= form.number_field :amount, form: "new_invoice_form", min: 0, step: 0.01, inputmode: "decimal", aria: { label: "Amount" },
          data: { service_line_target: "amount", invoice_editor_target: "amount", action: "input->invoice-editor#calculateTotals change->form#submit" },
          class: "block min-h-11 w-full rounded-md border border-transparent bg-transparent px-2 text-right text-base font-medium tabular-nums focus:border-neutral-300 focus:bg-white sm:h-9 sm:min-h-0 sm:text-sm" %>
    </td>
    <td class="px-2 py-2 text-right">
      <% unless local_assigns[:first] || index.to_s == "0" %>
        <%= button_tag form: "new_invoice_form", formaction: invoice_line_path(index), formmethod: :post,
            name: :_method, value: :delete, formnovalidate: true, class: icon_button_class do %>
          <span class="sr-only">Remove line</span>
          <%= inline_svg_tag "icons/trash.svg", class: "h-4 w-4" %>
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>
