<% if invoice.credit_notes.any? %>
  <section class="mt-6" aria-labelledby="credit-notes-heading">
    <h2 id="credit-notes-heading" class="text-base font-semibold text-neutral-950">Credit notes</h2>
    <%= render layout: "shared/table", locals: { frame_class: "mt-3", columns: [ { label: "No." }, { label: "Date" }, { label: "Reason" }, { label: "Amount", align: :right }, { label: "", sr_label: "Actions" } ] } do %>
      <% invoice.credit_notes.each do |credit_note| %>
        <tr class="<%= table_row_class %>">
          <td class="<%= table_cell_class(muted: credit_note.voided?) %> whitespace-nowrap"><%= credit_note.number %></td>
          <td class="<%= table_cell_class(muted: credit_note.voided?) %> whitespace-nowrap"><%= credit_note.issued_on.strftime("%b %-d, %Y") %></td>
          <td class="<%= table_cell_class(muted: credit_note.voided?) %>"><%= credit_note.reason %></td>
          <td class="<%= table_cell_class(align: :right, strong: true, muted: credit_note.voided?) %> tabular-nums whitespace-nowrap <%= "line-through" if credit_note.voided? %>"><%= money(credit_note.amount_minor, invoice.currency_code) %></td>
          <td class="<%= table_cell_class(align: :right, muted: credit_note.voided?) %>">
            <% if credit_note.voided? %>
              <span class="text-xs">Voided</span>
            <% else %>
              <%= button_to "Void", invoice_credit_note_void_path(invoice, credit_note), method: :post,
                  class: "cursor-pointer bg-transparent text-sm font-medium text-red-700 hover:underline",
                  form: { data: { turbo_confirm: "Void credit note #{credit_note.number}? The invoice balance goes back up by #{money(credit_note.amount_minor, invoice.currency_code)}." } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </section>
<% end %>
