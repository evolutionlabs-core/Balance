<% content_for :title, "Send invoice #{@invoice.invoice_number}" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Invoices", path: invoices_path }, { label: @invoice.invoice_number.presence || "Invoice", path: invoice_path(@invoice) }, { label: "Send" } ] %>
<% end %>

<% tab_class = "-mb-px cursor-pointer border-b-2 border-transparent px-1 pb-3 text-sm font-medium text-neutral-500 transition-colors hover:text-neutral-900 aria-selected:border-[#0f7082] aria-selected:text-neutral-950" %>

<%= form_with model: @delivery, scope: :delivery, url: invoice_issuance_path(@invoice), method: :post,
    class: "mx-auto max-w-6xl", data: { controller: "invoice-review" } do |form| %>
  <div class="rounded-lg border border-neutral-200 bg-white">
    <div class="flex items-center justify-between gap-4 px-5 pt-4">
      <h1 class="text-base font-medium text-neutral-900">Invoice <%= @invoice.invoice_number %></h1>
      <%= link_to invoice_path(@invoice), class: icon_button_class, aria: { label: "Close" } do %>
        <%= inline_svg_tag "icons/x.svg", class: "h-5 w-5" %>
      <% end %>
    </div>

    <nav class="mt-2 flex gap-6 border-b border-neutral-200 px-5" role="tablist">
      <%= link_to "Edit", edit_invoice_path(@invoice), class: tab_class %>
      <button type="button" role="tab" aria-selected="true" class="<%= tab_class %>"
          data-invoice-review-target="tab" data-panel="email" data-action="invoice-review#select">Email view</button>
      <button type="button" role="tab" aria-selected="false" class="<%= tab_class %>"
          data-invoice-review-target="tab" data-panel="customer" data-action="invoice-review#select">Customer view</button>
      <button type="button" role="tab" aria-selected="false" class="<%= tab_class %>"
          data-invoice-review-target="tab" data-panel="pdf" data-action="invoice-review#select">PDF view</button>
    </nav>

    <div class="bg-neutral-50 px-4 py-6 sm:px-6">
      <section role="tabpanel" data-invoice-review-target="panel" data-panel="email"
          class="grid gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
        <div class="space-y-4">
          <%= render "shared/form_errors", record: @delivery %>
          <div>
            <%= form.label :to, "Send to", class: field_label_class %>
            <%= form.email_field :to, class: field_class, autocomplete: "off" %>
          </div>
          <div>
            <%= form.label :subject, class: field_label_class %>
            <%= form.text_field :subject, class: field_class %>
          </div>
          <div>
            <%= form.label :message, class: field_label_class %>
            <%= form.text_area :message, rows: 9, class: field_class, data: { invoice_review_target: "message", action: "input->invoice-review#preview" } %>
          </div>
        </div>

        <%= tag.iframe title: "Email preview", class: "h-[36rem] w-full rounded-md border border-neutral-200 bg-white",
            data: { invoice_review_target: "frame", action: "load->invoice-review#preview" },
            srcdoc: render("invoice_mailer/email", invoice: @invoice, message: @delivery.message, link: nil, sender_name: @delivery.sender_name).to_str %>
      </section>

      <section role="tabpanel" hidden data-invoice-review-target="panel" data-panel="customer">
        <%= render "invoices/document", invoice: @invoice %>
      </section>

      <section role="tabpanel" hidden data-invoice-review-target="panel" data-panel="pdf">
        <iframe title="Invoice PDF" class="h-[48rem] w-full rounded-md border border-neutral-200 bg-white"
            data-invoice-review-target="pdf" data-src="<%= invoice_path(@invoice, format: :pdf, disposition: "inline") %>"></iframe>
      </section>
    </div>

    <div class="sticky bottom-0 flex flex-wrap items-center justify-between gap-3 rounded-b-lg border-t border-neutral-200 bg-white px-5 py-3">
      <%= link_to invoice_path(@invoice, format: :pdf), class: ghost_button_class(size: :compact), data: { turbo: false } do %>
        <%= inline_svg_tag "icons/download.svg", class: "h-4 w-4" %>Download PDF
      <% end %>
      <div class="flex items-center gap-2">
        <%= form.button "Mark as sent", name: "delivery[send_email]", value: "0", class: secondary_button_class(size: :compact) %>
        <%= form.button "Send invoice", name: "delivery[send_email]", value: "1", class: primary_button_class(size: :compact) %>
      </div>
    </div>
  </div>
<% end %>
