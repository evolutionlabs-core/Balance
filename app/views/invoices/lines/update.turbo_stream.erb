<% if params[:preview] %>
<%= turbo_stream.update dom_id(@line, :errors), partial: "shared/form_errors", locals: { record: @line } %>
<% end %>
<% if @invoice.errors.empty? %>
  <%= turbo_stream.update dom_id(@line, :amount), minor_amount(@line.amount_minor) %>
  <%= render "invoices/totals", invoice: @invoice %>
<% end %>
