<% content_for :title, "Invoices" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Invoices" } ] %>
<% end %>

<% invoice_actions = link_to(new_invoice_path, class: primary_button_class) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New invoice
<% end %>

<%= render "shared/page_header",
    title: "Invoices",
    description: "Create and review customer invoice drafts.",
    action: invoice_actions %>

<% if @invoices.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "No invoices yet",
      description: "Create an invoice draft for a customer and preview it before sending.",
      action: invoice_actions %>
<% else %>
  <div class="mt-4 overflow-x-auto border-y border-neutral-200">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <% [ "Customer", "Issue date", "Due date", "Status" ].each do |label| %>
            <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Total</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @invoices.each do |invoice| %>
          <tr class="group border-t border-neutral-200 transition-colors hover:bg-neutral-50/80">
            <td class="p-0 text-sm font-medium text-neutral-900">
              <%= link_to invoice.contact&.name || blank_cell, invoice_path(invoice), class: "block px-4 py-3" %>
            </td>
            <td class="p-0 text-sm whitespace-nowrap text-neutral-600">
              <%= link_to invoice.issue_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: "block px-4 py-3" %>
            </td>
            <td class="p-0 text-sm whitespace-nowrap text-neutral-600">
              <%= link_to invoice.due_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: "block px-4 py-3" %>
            </td>
            <td class="p-0 text-sm whitespace-nowrap">
              <%= link_to invoice_path(invoice), class: "block px-4 py-3" do %>
                <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-medium text-amber-800">Draft</span>
              <% end %>
            </td>
            <td class="p-0 text-right text-sm font-medium tabular-nums whitespace-nowrap text-neutral-900">
              <%= link_to minor_currency(invoice.total_minor, invoice.currency_code), invoice_path(invoice), class: "block px-4 py-3" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
