<% content_for :title, "Invoices" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Invoices" } ] %>
<% end %>

<% invoice_actions = link_to(new_invoice_path, class: primary_button_class(size: :compact)) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New invoice
<% end %>

<%= render "shared/page_header",
    title: "Invoices",
    description: "Manage and track your invoices.",
    action: invoice_actions %>

<% if current_workspace.invoices.none? %>
  <%= render "shared/empty_state",
      icon: "icons/invoice.svg",
      title: "No invoices yet",
      description: "Create an invoice draft for a customer and preview it before sending.",
      action: invoice_actions %>
<% else %>
  <%= render "summary", summary: @summary %>
  <%= render "filters" %>

  <% if @invoices.empty? %>
    <%= render "shared/empty_state",
        icon: "icons/invoice.svg",
        title: "No invoices found",
        description: "Try a different search or filter." %>
  <% else %>
    <%= render layout: "shared/mobile_list" do %>
      <% @invoices.each do |invoice| %>
        <%= render "shared/mobile_card", title: invoice.customer&.name || blank_cell, url: invoice_path(invoice),
            trailing: mobile_card_amount(minor_currency(invoice.sent? ? invoice.balance_due_kobo : invoice.total_minor, invoice.currency_code)),
            meta: [ invoice.invoice_number, invoice.issue_date&.to_fs(:medium) ].compact.join(" · "),
            footer: invoice_status_badge(invoice),
            action: invoice_row_action(invoice, class: mobile_card_action_class) %>
      <% end %>
    <% end %>
    <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [
          { label: "No." }, { label: "Customer" }, { label: "Date" }, { label: "Status" },
          { label: "Total", align: :right }, { label: "Balance due", align: :right }, { label: "", sr_label: "Actions" }
        ] } do %>
      <%= render @invoices %>
    <% end %>
  <% end %>
<% end %>
