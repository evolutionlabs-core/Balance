<% content_for :title, "Invoices" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Invoices" } ] %>
<% end %>

<% invoice_actions = link_to(new_invoice_path, class: primary_button_class(size: :compact)) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New invoice
<% end %>

<%= render "shared/page_header",
    title: "Invoices",
    description: "Manage and track your invoices.",
    action: invoice_actions %>

<% if @invoices.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/invoice.svg",
      title: "No invoices yet",
      description: "Create an invoice draft for a customer and preview it before sending.",
      action: invoice_actions %>
<% else %>
  <%= render layout: "shared/mobile_list" do %>
    <% @invoices.each do |invoice| %>
      <%= render "shared/mobile_card", title: invoice.customer&.name || blank_cell, url: invoice_path(invoice),
          trailing: mobile_card_amount(minor_currency(invoice.total_minor, invoice.currency_code)),
          footer: safe_join([
            invoice_status_badge(invoice),
            tag.span(invoice.issue_date&.strftime("%b %-d, %Y") || blank_cell, class: "truncate"),
            tag.span("·", aria: { hidden: true }),
            tag.span(safe_join([ "Due ", invoice.due_date&.strftime("%b %-d") || blank_cell ]), class: "truncate")
          ]),
          action: (link_to("Edit", edit_invoice_path(invoice), class: mobile_card_action_class) if invoice.draft?) %>
    <% end %>
  <% end %>
  <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [
        { label: "Customer" }, { label: "Amount", align: :right }, { label: "Status" }, { label: "Date" }, { label: "Due date" }, { label: "Actions", align: :right }
      ] } do %>
    <%= render @invoices %>
  <% end %>
<% end %>
