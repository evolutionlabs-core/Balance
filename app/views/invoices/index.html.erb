<% content_for :title, "Invoices" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Invoices" } ] %>
<% end %>

<% invoice_actions = link_to(new_invoice_path, class: primary_button_class(size: :compact)) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New invoice
<% end %>

<%= render "shared/page_header",
    title: "Invoices",
    description: "Manage and track your invoices.",
    action: invoice_actions %>

<% if @invoices.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/invoice.svg",
      title: "No invoices yet",
      description: "Create an invoice draft for a customer and preview it before sending.",
      action: invoice_actions %>
<% else %>
  <div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200 sm:hidden">
    <% @invoices.each do |invoice| %>
      <article class="py-4">
        <div class="flex items-start justify-between gap-4">
          <%= link_to invoice.customer&.name || blank_cell, invoice_path(invoice), class: "min-w-0 flex-1 truncate text-sm font-medium text-neutral-950" %>
          <span class="shrink-0 text-sm font-semibold tabular-nums text-neutral-950"><%= minor_currency(invoice.total_minor, invoice.currency_code) %></span>
        </div>
        <div class="mt-2 flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-2 text-xs text-neutral-500">
            <%= status_badge("Draft", tone: :warning) %>
            <span class="truncate"><%= invoice.issue_date&.strftime("%b %-d, %Y") || blank_cell %></span>
            <span aria-hidden="true">·</span>
            <span class="truncate">Due <%= invoice.due_date&.strftime("%b %-d") || blank_cell %></span>
          </div>
          <%= link_to "Edit", edit_invoice_path(invoice), class: "flex min-h-11 shrink-0 items-center px-1 text-sm font-medium text-[#0f7082]" %>
        </div>
      </article>
    <% end %>
  </div>
  <div class="mt-4 hidden overflow-x-auto border-y border-neutral-200 sm:block">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Customer</th>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Amount</th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Status</th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Date</th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500">Due date</th>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <%= render @invoices %>
      </tbody>
    </table>
  </div>
<% end %>
