<%= form_with url: invoices_path, method: :get, class: "mt-4 flex flex-col gap-2 sm:flex-row",
    data: { controller: "date-range form", action: "date-range:change->form#submit", turbo_frame: "invoices", turbo_action: "replace" } do |form| %>
  <div class="relative min-w-0 flex-1">
    <%= form.search_field :q, value: params[:q], placeholder: "Search customer or number", autocomplete: "off",
        aria: { label: "Search invoices" }, class: field_class, data: { action: "input->form#search" } %>
  </div>
  <div class="sm:w-44">
    <%= render "shared/select_menu", form: form, attribute: :status,
        options: options_for_select([ [ "All", "all" ] ] + InvoicesController::STATUS_FILTERS.invert.to_a, @status || "all"),
        prompt: nil, required: false, select_data: { action: "change->form#submit" } %>
  </div>
  <div class="relative sm:w-64">
    <%= form.text_field :range,
        value: [ params[:from], params[:to] ].compact_blank.join(" to "),
        placeholder: "Invoice date",
        autocomplete: "off",
        aria: { label: "Invoice date range" },
        class: "#{field_class} cursor-pointer",
        data: { date_range_target: "input" } %>
    <%= form.hidden_field :from, value: params[:from], data: { date_range_target: "from" } %>
    <%= form.hidden_field :to, value: params[:to], data: { date_range_target: "to" } %>
  </div>
  <%= link_to "Clear", invoices_path, class: ghost_button_class, hidden: params.values_at(:q, :from).all?(&:blank?) && @status.nil?,
      data: { form_target: "clear", turbo_frame: "_top" } %>
<% end %>
