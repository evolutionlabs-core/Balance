<% content_for :title, @invoice.voided? ? "Invoice #{@invoice.invoice_number} (voided)" : "Invoice #{@invoice.invoice_number}" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Invoices", path: invoices_path }, { label: @invoice.invoice_number.presence || "Invoice" } ] %>
<% end %>

<div class="mx-auto max-w-6xl">
  <div class="mb-6">
    <%= render "shared/page_header",
        title: "Invoice #{@invoice.invoice_number}",
        description: safe_join([ invoice_status_badge(@invoice), @invoice.customer&.name ].compact, " "),
        action: render("invoices/actions", invoice: @invoice) %>
  </div>

  <%= render "invoices/document", invoice: @invoice %>
  <%= render "invoices/payments", invoice: @invoice %>
</div>
