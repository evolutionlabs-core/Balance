<%= render "shared/modal" do %>
  <%= form_with scope: :invoice_payment, url: invoice_payment_path(@invoice), class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: "Receive payment" %>

    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @invoice %>
      <div class="flex items-center justify-between rounded-md bg-neutral-50 px-3 py-2.5 text-sm">
        <span class="text-neutral-600"><%= @invoice.invoice_number %> · <%= @invoice.customer.name %></span>
        <span class="font-medium tabular-nums text-neutral-950">Balance due <%= minor_currency(@invoice.balance_due_kobo, @invoice.currency_code) %></span>
      </div>

      <div>
        <%= form.label :deposit_account_id, "Deposit to", class: field_label_class %>
        <%= render "shared/select_menu", form: form, attribute: :deposit_account_id,
            options: options_from_collection_for_select(@deposit_accounts, :id, :name, params.dig(:invoice_payment, :deposit_account_id) || current_workspace.default_deposit_account_id),
            prompt: "Select account", searchable: true, search_placeholder: "Search bank and cash accounts…",
            empty_message: "No bank or cash accounts found", select_data: {}, required: true %>
      </div>

      <div>
        <%= form.label :received_on, "Payment date", class: field_label_class %>
        <%= form.text_field :received_on, value: params.dig(:invoice_payment, :received_on) || Date.current,
            required: true, autocomplete: "off", class: "#{field_class} cursor-pointer", data: { controller: "date-picker" } %>
      </div>

      <div>
        <%= form.label :amount, "Amount received", class: field_label_class %>
        <p class="mb-2 text-xs text-neutral-500">Change it for a part payment.</p>
        <%= form.number_field :amount, value: params.dig(:invoice_payment, :amount) || format("%.2f", BigDecimal(@invoice.balance_due_kobo) / 100), min: 0.01,
            max: format("%.2f", BigDecimal(@invoice.balance_due_kobo) / 100), step: 0.01, required: true, class: field_class %>
      </div>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Receive payment" %>
  <% end %>
<% end %>
