<%= render "shared/modal" do %>
  <%= form_with url: invoice_void_path(@invoice), method: :post, class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: "Void invoice" %>

    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @invoice %>
      <% if @invoice.sent? %>
        <p class="text-sm text-neutral-600">Voiding posts a reversal to your books, cancelling this invoice's receivable. This cannot be undone.</p>
      <% else %>
        <p class="text-sm text-neutral-600">Void this draft invoice? Voided invoices keep their number and cannot be changed.</p>
      <% end %>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Void invoice" %>
  <% end %>
<% end %>
