<article class="border border-neutral-200 bg-white shadow-sm">
  <header class="flex flex-col gap-5 border-b border-neutral-200 px-4 py-6 sm:flex-row sm:justify-between sm:px-8 sm:py-10 md:px-12">
    <div>
      <p class="text-2xl font-semibold tracking-tight text-balance-teal-700">INVOICE</p>
      <% business_name = invoice.business_name.nil? ? invoice.workspace.name : invoice.business_name %>
      <% business_email = invoice.business_email.nil? ? invoice.user.email_address : invoice.business_email %>
      <% business_address = invoice.business_address.nil? ? invoice.workspace.address : invoice.business_address %>
      <p class="mt-5 font-semibold text-neutral-950"><%= business_name.presence || "—" %></p>
      <p class="mt-1 text-sm text-neutral-500"><%= business_email.presence || "—" %></p>
      <% if business_address.present? %>
        <p class="mt-1 whitespace-pre-line text-sm text-neutral-500"><%= business_address %></p>
      <% end %>
    </div>
    <dl class="grid content-start gap-2 text-sm sm:min-w-64">
      <div class="flex justify-between gap-8">
        <dt class="text-neutral-500">Invoice date</dt>
        <dd class="font-medium text-neutral-950"><%= invoice.issue_date&.strftime("%b %-d, %Y") || "—" %></dd>
      </div>
      <div class="flex justify-between gap-8">
        <dt class="text-neutral-500">Due date</dt>
        <dd class="font-medium text-neutral-950"><%= invoice.due_date&.strftime("%b %-d, %Y") || "—" %></dd>
      </div>
      <% if PaymentTerms::DAYS.key?(invoice.payment_terms) %>
        <div class="flex justify-between gap-8">
          <dt class="text-neutral-500">Terms</dt>
          <dd class="font-medium text-neutral-950"><%= PaymentTerms.label(invoice.payment_terms) %></dd>
        </div>
      <% end %>
      <% if invoice.reference.present? %>
        <div class="flex justify-between gap-8">
          <dt class="text-neutral-500">Reference</dt>
          <dd class="font-medium text-neutral-950"><%= invoice.reference %></dd>
        </div>
      <% end %>
    </dl>
  </header>

  <section class="bg-balance-teal-50 px-4 py-5 sm:px-8 sm:py-7 md:px-12">
    <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Bill to</p>
    <% bill_to_name = invoice.bill_to_name.nil? ? invoice.customer&.name : invoice.bill_to_name %>
    <% bill_to_email = invoice.bill_to_email.nil? ? invoice.customer&.email : invoice.bill_to_email %>
    <% bill_to_address = invoice.bill_to_address.nil? ? invoice.customer&.address : invoice.bill_to_address %>
    <% if bill_to_name.present? || bill_to_email.present? || bill_to_address.present? %>
      <p class="mt-2 font-semibold text-neutral-950"><%= bill_to_name.presence || "—" %></p>
      <p class="mt-1 text-sm text-neutral-600"><%= bill_to_email.presence || "—" %></p>
      <% if bill_to_address.present? %>
        <p class="mt-1 whitespace-pre-line text-sm text-neutral-600"><%= bill_to_address %></p>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm text-neutral-400">No customer selected</p>
    <% end %>
  </section>

  <section class="px-4 py-6 sm:px-8 sm:py-8 md:px-12">
    <div>
      <table class="invoice-preview-lines min-w-full">
        <thead>
          <tr class="border-b border-neutral-200">
            <th class="py-3 text-left text-xs font-medium text-neutral-500">Description</th>
            <th class="<%= table_header_class(align: :right) %>">Qty</th>
            <th class="<%= table_header_class(align: :right) %>">Rate</th>
            <th class="py-3 text-right text-xs font-medium text-neutral-500">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% invoice.invoice_lines.reject(&:marked_for_destruction?).each do |line| %>
            <tr class="border-b border-neutral-200">
              <td class="py-4 text-sm text-neutral-900">
                <p><%= line.description.presence || "—" %></p>
              </td>
              <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line.quantity ? number_with_precision(line.quantity, precision: 3, strip_insignificant_zeros: true) : "—" %></td>
              <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line.rate_minor ? minor_currency(line.rate_minor, invoice.currency_code) : "—" %></td>
              <td class="py-4 text-right text-sm font-medium tabular-nums text-neutral-950"><%= minor_currency(line.amount_minor, invoice.currency_code) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if invoice.invoice_lines.all?(&:marked_for_destruction?) %>
        <p class="border-b border-neutral-200 py-8 text-center text-sm text-neutral-400">No line items added</p>
      <% end %>
    </div>

    <dl class="mt-8 ml-auto max-w-sm">
      <div class="flex justify-between text-sm">
        <dt class="text-neutral-500">Subtotal</dt>
        <dd class="font-medium tabular-nums text-neutral-950"><%= minor_currency(invoice.subtotal_minor, invoice.currency_code) %></dd>
      </div>
      <% if invoice.discounted? %>
        <div class="mt-3 flex justify-between text-sm">
          <dt class="text-neutral-500"><%= invoice.discount_label %></dt>
          <dd class="tabular-nums text-neutral-950">−<%= minor_currency(invoice.discount_minor, invoice.currency_code) %></dd>
        </div>
      <% end %>
      <% if invoice.discounted? || invoice.balance_due_kobo != invoice.total_minor %>
        <div class="mt-3 flex justify-between text-sm">
          <dt class="text-neutral-500">Total</dt>
          <dd class="font-medium tabular-nums text-neutral-950"><%= minor_currency(invoice.total_minor, invoice.currency_code) %></dd>
        </div>
      <% end %>
      <% invoice.credit_notes.reject(&:voided?).each do |credit_note| %>
        <div class="mt-3 flex justify-between gap-4 text-sm">
          <dt class="text-neutral-500">
            Credit note <%= credit_note.number %>
            <span class="block text-xs text-neutral-400"><%= credit_note.reason %></span>
          </dt>
          <dd class="tabular-nums text-neutral-950">−<%= minor_currency(credit_note.amount_minor, invoice.currency_code) %></dd>
        </div>
      <% end %>
      <% if invoice.applied_amount_kobo.positive? %>
        <div class="mt-3 flex justify-between text-sm">
          <dt class="text-neutral-500">Paid</dt>
          <dd class="tabular-nums text-neutral-950">−<%= minor_currency(invoice.applied_amount_kobo, invoice.currency_code) %></dd>
        </div>
      <% end %>
      <div class="mt-4 flex justify-between border-t border-neutral-200 pt-4">
        <dt class="font-semibold text-neutral-950">Balance due</dt>
        <dd class="text-xl font-semibold tabular-nums text-neutral-950"><%= minor_currency(invoice.balance_due_kobo, invoice.currency_code) %></dd>
      </div>
    </dl>
  </section>

  <% if invoice.payment_instructions.present? || invoice.notes.present? %>
    <section class="grid gap-6 border-t border-neutral-200 px-4 py-6 text-sm sm:grid-cols-2 sm:px-8 md:px-12">
      <% if invoice.payment_instructions.present? %>
        <div>
          <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Payment details</p>
          <p class="mt-2 whitespace-pre-line text-neutral-900"><%= invoice.payment_instructions %></p>
        </div>
      <% end %>
      <% if invoice.notes.present? %>
        <div>
          <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Note</p>
          <p class="mt-2 whitespace-pre-line text-neutral-900"><%= invoice.notes %></p>
        </div>
      <% end %>
    </section>
  <% end %>
</article>
