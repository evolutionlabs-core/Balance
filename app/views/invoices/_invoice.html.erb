<tr class="group border-t border-neutral-200 transition-colors hover:bg-neutral-50">
  <td data-label="Customer" class="p-0 text-sm font-medium text-neutral-900">
    <%= link_to invoice.customer&.name || blank_cell, invoice_path(invoice), class: "block px-4 py-4" %>
  </td>
  <td data-label="Amount" class="p-0 text-right text-sm font-medium tabular-nums whitespace-nowrap text-neutral-900">
    <%= link_to minor_currency(invoice.total_minor, invoice.currency_code), invoice_path(invoice), class: "block px-4 py-4" %>
  </td>
  <td data-label="Status" class="p-0 text-sm whitespace-nowrap">
    <%= link_to invoice_path(invoice), class: "block px-4 py-4" do %>
      <%= status_badge("Draft", tone: :warning) %>
    <% end %>
  </td>
  <td data-label="Date" class="p-0 text-sm whitespace-nowrap text-neutral-600">
    <%= link_to invoice.issue_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: "block px-4 py-4" %>
  </td>
  <td data-label="Due" class="p-0 text-sm whitespace-nowrap text-neutral-600">
    <%= link_to invoice.due_date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: "block px-4 py-4" %>
  </td>
  <td data-label="Actions" class="px-4 py-4 text-right text-sm">
    <%= link_to "Edit", edit_invoice_path(invoice), class: "font-medium text-[#0f7082] hover:underline", aria: { label: "Edit invoice" } %>
  </td>
</tr>
