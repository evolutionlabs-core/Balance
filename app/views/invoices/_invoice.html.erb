<tr id="<%= dom_id(invoice) %>" class="<%= table_row_class %>">
  <td class="<%= table_cell_class(strong: true, link: true) %> whitespace-nowrap">
    <%= link_to invoice.invoice_number || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
  </td>
  <td class="<%= table_cell_class(link: true) %>">
    <%= link_to invoice.customer&.name || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
  </td>
  <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
    <%= link_to invoice.issue_date&.to_fs(:medium) || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
  </td>
  <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
    <%= link_to invoice_path(invoice), class: table_cell_link_class do %><%= invoice_status_badge(invoice) %><% end %>
  </td>
  <td class="<%= table_cell_class(align: :right, link: true) %> tabular-nums whitespace-nowrap">
    <%= link_to minor_currency(invoice.total_minor, invoice.currency_code), invoice_path(invoice), class: table_cell_link_class %>
  </td>
  <td class="<%= table_cell_class(align: :right, strong: true, link: true) %> tabular-nums whitespace-nowrap">
    <%= link_to (invoice.sent? ? minor_currency(invoice.balance_due_kobo, invoice.currency_code) : blank_cell), invoice_path(invoice), class: table_cell_link_class %>
  </td>
  <td class="<%= table_cell_class(align: :right) %> whitespace-nowrap">
    <%= invoice_row_action(invoice, class: "font-medium text-balance-teal-700 hover:underline") %>
  </td>
</tr>
