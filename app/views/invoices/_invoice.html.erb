<tr class="<%= table_row_class %>">
  <td class="<%= table_cell_class(strong: true, link: true) %>">
    <%= link_to invoice.customer&.name || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
  </td>
  <td class="<%= table_cell_class(align: :right, strong: true, link: true) %> tabular-nums whitespace-nowrap">
    <%= link_to minor_currency(invoice.total_minor, invoice.currency_code), invoice_path(invoice), class: table_cell_link_class %>
  </td>
  <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
    <%= link_to invoice_path(invoice), class: table_cell_link_class do %>
      <%= invoice_status_badge(invoice) %>
    <% end %>
  </td>
  <% [ invoice.issue_date, invoice.due_date ].each do |date| %>
    <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
      <%= link_to date&.strftime("%b %-d, %Y") || blank_cell, invoice_path(invoice), class: table_cell_link_class %>
    </td>
  <% end %>
  <td class="<%= table_cell_class(align: :right) %>">
    <%= link_to "Edit", edit_invoice_path(invoice), class: "font-medium text-balance-teal-700 hover:underline", aria: { label: "Edit invoice" } if invoice.draft? %>
  </td>
</tr>
