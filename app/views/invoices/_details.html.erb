<%= turbo_frame_tag dom_id(invoice, :details) do %>
  <%= form_with model: invoice, data: { controller: "form", action: "change->form#submit" }, class: "grid content-start gap-4 sm:grid-cols-2" do |form| %>
    <div class="sm:col-span-2"><%= render "shared/form_errors", record: invoice %></div>
    <div>
      <%= form.label :issue_date, "Invoice date", class: field_label_class %>
      <%= form.text_field :issue_date, autocomplete: "off", class: "#{field_class} cursor-pointer",
          data: { controller: "date-picker", date_picker_allow_future_value: true } %>
    </div>
    <div>
      <%= form.label :due_date, "Due date", class: field_label_class %>
      <%= form.text_field :due_date, autocomplete: "off", class: "#{field_class} cursor-pointer",
          data: { controller: "date-picker", date_picker_allow_future_value: true } %>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :currency_code, "Currency", class: field_label_class %>
      <%= form.select :currency_code, [ [ "Nigerian naira (NGN)", "NGN" ] ], {}, class: field_class %>
    </div>
  <% end %>
<% end %>
