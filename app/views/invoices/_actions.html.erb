<% can_void = invoice.may_mark_voided? %>
<% shared = invoice.sent? || invoice.paid? %>
<% collecting = invoice.sent? && invoice.balance_due_kobo.positive? %>

<div class="flex flex-wrap items-center gap-2">
  <% if invoice.draft? %>
    <%= link_to edit_invoice_path(invoice), class: secondary_button_class(size: :compact) do %>
      <%= inline_svg_tag "icons/edit.svg", class: "h-4 w-4" %>Edit
    <% end %>
  <% else %>
    <%= link_to invoice_path(invoice, format: :pdf), class: secondary_button_class(size: :compact), data: { turbo: false } do %>
      <%= inline_svg_tag "icons/download.svg", class: "h-4 w-4" %>Download PDF
    <% end %>
  <% end %>

  <% if invoice.draft? %>
    <% recipient = local_assigns[:delivery]&.to %>
    <button type="submit" form="invoice-delivery" name="delivery[send_email]" value="1"
        class="<%= primary_button_class(size: :compact) %>"
        data-invoice-review-target="sendButton" data-action="invoice-review#send"
        data-turbo-confirm="Email invoice <%= invoice.invoice_number %> to <%= recipient.presence || "the customer" %>?">
      <%= inline_svg_tag "icons/mail.svg", class: "h-4 w-4" %>Send invoice
    </button>
  <% elsif collecting %>
    <%= button_to "Mark as paid", invoice_settlement_path(invoice), method: :post,
        class: primary_button_class(size: :compact), form: { class: "contents" } %>
  <% end %>

  <% if invoice.draft? || shared || can_void %>
    <div data-controller="menu" data-action="keydown->menu#dismiss" class="relative inline-block text-left">
      <button type="button" data-menu-target="button" data-action="menu#toggle"
          class="inline-flex h-[34px] w-[34px] cursor-pointer items-center justify-center rounded-md border border-neutral-200 bg-white text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-950"
          aria-label="More invoice actions" aria-haspopup="menu" aria-expanded="false">
        <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4" %>
      </button>
      <div data-menu-target="menu" role="menu" class="hidden w-52 rounded-md border border-neutral-200 bg-white p-1 text-left shadow-md">
        <% if invoice.draft? %>
          <%= link_to invoice_path(invoice, format: :pdf), role: "menuitem", class: menu_item_class, data: { turbo: false } do %>
            <%= inline_svg_tag "icons/download.svg", class: "h-4 w-4 flex-none" %>
            Download PDF
          <% end %>
          <button type="submit" form="invoice-delivery" name="delivery[send_email]" value="0" role="menuitem" class="<%= menu_item_class %>"
              data-turbo-confirm="Mark invoice <%= invoice.invoice_number %> as sent without emailing it?">
            <%= inline_svg_tag "icons/check.svg", class: "h-4 w-4 flex-none" %>
            Mark as sent
          </button>
        <% end %>

        <% if collecting %>
          <%= link_to new_invoice_payment_path(invoice), role: "menuitem", class: menu_item_class, data: { turbo_frame: "modal" } do %>
            <%= inline_svg_tag "icons/banknote.svg", class: "h-4 w-4 flex-none" %>
            Record partial payment…
          <% end %>
        <% end %>

        <% if shared %>
          <button type="button" role="menuitem" data-controller="copy"
              data-copy-value-value="<%= client_invoice_url(invoice.generate_token_for(:client_view)) %>"
              data-action="copy#copy" class="<%= menu_item_class %>">
            <span data-copy-target="defaultIcon" class="flex items-center gap-2.5">
              <%= inline_svg_tag "icons/copy.svg", class: "h-4 w-4 flex-none" %>
              Copy secure link
            </span>
            <span hidden data-copy-target="doneIcon" class="flex items-center gap-2.5 text-green-600">
              <%= inline_svg_tag "icons/check.svg", class: "h-4 w-4 flex-none" %>
              Link copied
            </span>
          </button>
        <% end %>

        <% if can_void %>
          <%= link_to new_invoice_void_path(invoice), role: "menuitem", class: "#{menu_item_class} text-red-700 hover:text-red-800", data: { turbo_frame: "modal" } do %>
            <%= inline_svg_tag "icons/x.svg", class: "h-4 w-4 flex-none" %>
            Void invoice
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
