<%= render "shared/modal" do %>
  <%= form_with scope: :credit_note, url: invoice_credit_note_path(@invoice), class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: "Credit note" %>

    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @invoice %>
      <div class="flex items-center justify-between rounded-md bg-neutral-50 px-3 py-2.5 text-sm">
        <span class="text-neutral-600"><%= @invoice.invoice_number %> · <%= @invoice.customer.name %></span>
        <span class="font-medium tabular-nums text-neutral-950">Balance due <%= minor_currency(@invoice.balance_due_kobo, @invoice.currency_code) %></span>
      </div>
      <p class="text-sm text-neutral-600">Lowers what <%= @invoice.customer.name %> owes on this invoice.</p>

      <div>
        <%= form.label :amount, "Amount", class: field_label_class %>
        <p class="mb-2 text-xs text-neutral-500">Change it for a partial credit.</p>
        <%= form.number_field :amount, value: params.dig(:credit_note, :amount) || format("%.2f", BigDecimal(@invoice.balance_due_kobo) / 100), min: 0.01,
            max: format("%.2f", BigDecimal(@invoice.balance_due_kobo) / 100), step: 0.01, required: true, class: field_class %>
      </div>

      <div>
        <%= form.label :issued_on, "Date", class: field_label_class %>
        <%= form.text_field :issued_on, value: params.dig(:credit_note, :issued_on) || Date.current,
            required: true, autocomplete: "off", class: "#{field_class} cursor-pointer", data: { controller: "date-picker" } %>
      </div>

      <div>
        <%= form.label :reason, "Reason", class: field_label_class %>
        <p class="mb-2 text-xs text-neutral-500">Your customer sees this on the invoice.</p>
        <%= form.text_area :reason, value: params.dig(:credit_note, :reason), rows: 2, required: true,
            placeholder: "Returned 2 items", class: field_class %>
      </div>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Issue credit note" %>
  <% end %>
<% end %>
