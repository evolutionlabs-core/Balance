<article class="border border-neutral-200 bg-white shadow-sm">
  <header class="flex flex-col gap-5 border-b border-neutral-200 px-4 py-6 sm:flex-row sm:justify-between sm:px-8 sm:py-10 md:px-12">
    <div>
      <p class="text-2xl font-semibold tracking-tight text-balance-teal-700">CREDIT NOTE</p>
      <p class="mt-5 font-semibold text-neutral-950"><%= credit_note.workspace.name %></p>
      <p class="mt-1 text-sm text-neutral-500"><%= credit_note.user.email_address %></p>
      <% if credit_note.workspace.address.present? %>
        <p class="mt-1 whitespace-pre-line text-sm text-neutral-500"><%= credit_note.workspace.address %></p>
      <% end %>
    </div>
    <dl class="grid content-start gap-2 text-sm sm:min-w-64">
      <div class="flex justify-between gap-8">
        <dt class="text-neutral-500">Credit note no.</dt>
        <dd class="font-medium text-neutral-950"><%= credit_note.number %></dd>
      </div>
      <div class="flex justify-between gap-8">
        <dt class="text-neutral-500">Date</dt>
        <dd class="font-medium text-neutral-950"><%= credit_note.issued_on.strftime("%b %-d, %Y") %></dd>
      </div>
      <% if credit_note.invoice %>
        <div class="flex justify-between gap-8">
          <dt class="text-neutral-500">Invoice</dt>
          <dd class="font-medium text-neutral-950"><%= credit_note.invoice.invoice_number %></dd>
        </div>
      <% end %>
    </dl>
  </header>

  <section class="bg-balance-teal-50 px-4 py-5 sm:px-8 sm:py-7 md:px-12">
    <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Credit to</p>
    <p class="mt-2 font-semibold text-neutral-950"><%= credit_note.bill_to_name.presence || credit_note.customer.name %></p>
    <p class="mt-1 text-sm text-neutral-600"><%= credit_note.bill_to_email.presence || "—" %></p>
    <% if credit_note.bill_to_address.present? %>
      <p class="mt-1 whitespace-pre-line text-sm text-neutral-600"><%= credit_note.bill_to_address %></p>
    <% end %>
  </section>

  <section class="px-4 py-6 sm:px-8 sm:py-8 md:px-12">
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-neutral-200">
          <th class="py-3 text-left text-xs font-medium text-neutral-500">Description</th>
          <th class="<%= table_header_class(align: :right) %>">Qty</th>
          <th class="<%= table_header_class(align: :right) %>">Rate</th>
          <th class="py-3 text-right text-xs font-medium text-neutral-500">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% credit_note.lines.each do |line| %>
          <tr class="border-b border-neutral-200">
            <td class="py-4 text-sm text-neutral-900"><%= line.description %></td>
            <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line.quantity ? number_with_precision(line.quantity, precision: 3, strip_insignificant_zeros: true) : "—" %></td>
            <td class="px-4 py-4 text-right text-sm tabular-nums text-neutral-600"><%= line.rate_minor ? minor_currency(line.rate_minor, credit_note.currency_code) : "—" %></td>
            <td class="py-4 text-right text-sm font-medium tabular-nums text-neutral-950"><%= minor_currency(line.amount_minor, credit_note.currency_code) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <dl class="mt-8 ml-auto max-w-sm">
      <% if credit_note.discounted? %>
        <div class="flex justify-between text-sm">
          <dt class="text-neutral-500">Subtotal</dt>
          <dd class="font-medium tabular-nums text-neutral-950"><%= minor_currency(credit_note.subtotal_minor, credit_note.currency_code) %></dd>
        </div>
        <div class="mt-3 flex justify-between text-sm">
          <dt class="text-neutral-500"><%= credit_note.discount_label %></dt>
          <dd class="tabular-nums text-neutral-950">−<%= minor_currency(credit_note.discount_minor, credit_note.currency_code) %></dd>
        </div>
      <% end %>
      <div class="mt-4 flex justify-between border-t border-neutral-200 pt-4">
        <dt class="font-semibold text-neutral-950">Total credit</dt>
        <dd class="text-xl font-semibold tabular-nums text-neutral-950"><%= minor_currency(credit_note.total_minor, credit_note.currency_code) %></dd>
      </div>
    </dl>
  </section>

  <% if credit_note.notes.present? %>
    <section class="border-t border-neutral-200 px-4 py-6 text-sm sm:px-8 md:px-12">
      <p class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Note</p>
      <p class="mt-2 whitespace-pre-line text-neutral-900"><%= credit_note.notes %></p>
    </section>
  <% end %>
</article>
