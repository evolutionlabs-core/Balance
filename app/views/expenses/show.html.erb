<% content_for :title, @expense.posted? ? "Expense" : "Review expense" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Expenses", path: expenses_path }, { label: @expense.posted? ? "Expense" : "Review" } ] %>
<% end %>

<div class="mx-auto max-w-4xl">
  <% if @posting_errors.present? %>
    <div class="mb-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
      <%= @posting_errors.to_sentence %>
    </div>
  <% end %>

  <% if @possible_duplicates.any? %>
    <div class="mb-5 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-amber-900" role="alert">
      <p class="font-medium">This expense may already be recorded.</p>
      <p class="mt-1 text-sm text-amber-800">Review the possible matches before posting. You can still post this expense if it is legitimate.</p>
      <ul class="mt-3 divide-y divide-amber-200 border-y border-amber-200">
        <% @possible_duplicates.each do |duplicate| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
            <span>
              <%= duplicate.payment_date.to_fs(:medium) %> · <%= naira(duplicate.total_kobo) %>
            </span>
            <%= link_to "View expense", expense_path(duplicate), class: "font-medium text-amber-950 underline" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-4 border-b border-neutral-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-[#0f7082]"><%= @expense.posted? ? "Posted expense" : "Review expense" %></p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-neutral-950"><%= @expense.description %></h1>
      <p class="mt-1 text-sm text-neutral-500">
        <%= @expense.payment_date.to_fs(:long) %> · Paid from <%= @expense.payment_account.name %>
      </p>
    </div>
    <p class="text-3xl font-semibold tabular-nums text-neutral-950"><%= naira(@expense.total_kobo) %></p>
  </div>

  <% if @expense.memo.present? %>
    <dl class="mt-5 border-b border-neutral-200 pb-5">
      <div>
        <dt class="text-xs font-medium text-neutral-500">Memo</dt>
        <dd class="mt-1 text-sm text-neutral-900"><%= @expense.memo %></dd>
      </div>
    </dl>
  <% end %>

  <section class="mt-7">
    <h2 class="text-sm font-semibold text-neutral-900">Expense details</h2>
    <div class="mt-3 overflow-x-auto border-y border-neutral-200">
      <table class="min-w-full">
        <thead>
          <tr>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500">Category</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500">Description</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @expense.expense_lines.each do |line| %>
            <tr class="border-t border-neutral-200">
              <td class="px-4 py-3 text-sm font-medium text-neutral-900"><%= line.account.name %></td>
              <td class="px-4 py-3 text-sm text-neutral-600"><%= line.description %></td>
              <td class="px-4 py-3 text-right text-sm tabular-nums text-neutral-900"><%= naira(line.amount_kobo) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-7">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-neutral-900">Accounting entry</h2>
      <% if @engine_result.ok? %>
        <span class="text-xs font-medium text-emerald-700">Balanced</span>
      <% end %>
    </div>
    <div class="mt-3 overflow-x-auto border-y border-neutral-200">
      <table class="min-w-full">
        <thead>
          <tr>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-neutral-500">Account</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Debit</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium text-neutral-500">Credit</th>
          </tr>
        </thead>
        <tbody>
          <% @journal_entry.journal_entry_lines.each do |line| %>
            <tr class="border-t border-neutral-200">
              <td class="px-4 py-3 text-sm font-medium text-neutral-900"><%= line.account.name %></td>
              <td class="px-4 py-3 text-right text-sm tabular-nums text-neutral-600"><%= line.debit_kobo.positive? ? naira(line.debit_kobo) : blank_cell %></td>
              <td class="px-4 py-3 text-right text-sm tabular-nums text-neutral-600"><%= line.credit_kobo.positive? ? naira(line.credit_kobo) : blank_cell %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-8 flex items-center justify-end gap-2 border-t border-neutral-200 pt-5">
    <% if @expense.draft? %>
      <%= link_to "Back to edit", edit_expense_path(@expense), class: secondary_button_class %>
      <%= button_to "Post expense", expense_posting_path(@expense), method: :post,
          class: primary_button_class,
          disabled: !@can_post %>
    <% else %>
      <%= link_to "Back to expenses", expenses_path, class: secondary_button_class %>
    <% end %>
  </div>
</div>
