<% content_for :title, "Expense" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Expenses", path: expenses_path }, { label: "Expense" } ] %>
<% end %>

<div class="mx-auto max-w-4xl">
  <div class="flex flex-col gap-4 border-b border-neutral-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <p class="text-sm font-medium text-balance-teal-700">Expense</p>
        <%= expense_status(@expense) %>
      </div>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-neutral-950"><%= @expense.description %></h1>
      <p class="mt-1 text-sm text-neutral-500">
        <%= @expense.payment_date.to_fs(:long) %> · Paid from <%= @expense.payment_account.name %>
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:items-end">
      <p class="text-3xl font-semibold tabular-nums text-neutral-950"><%= money(@expense.total_kobo) %></p>
      <% if @expense.voidable? %>
        <%= link_to "Void", new_expense_void_path(@expense), class: secondary_button_class(size: :compact), data: { turbo_frame: "modal" } %>
      <% end %>
    </div>
  </div>

  <% if @expense.memo.present? %>
    <dl class="mt-5 border-b border-neutral-200 pb-5">
      <div>
        <dt class="text-xs font-medium text-neutral-500">Memo</dt>
        <dd class="mt-1 text-sm text-neutral-900"><%= @expense.memo %></dd>
      </div>
    </dl>
  <% end %>

  <section class="mt-7">
    <h2 class="text-sm font-semibold text-neutral-900">Expense details</h2>
    <%= render layout: "shared/table", locals: { frame_class: "mt-3", columns: [ { label: "Category" }, { label: "Description" }, { label: "Amount", align: :right } ] } do %>
      <% @expense.expense_lines.each do |line| %>
        <tr class="<%= table_row_class %>">
          <td class="<%= table_cell_class(strong: true) %>"><%= line.account.name %></td>
          <td class="<%= table_cell_class %>"><%= line.description %></td>
          <td class="<%= table_cell_class(align: :right, strong: true) %> tabular-nums"><%= money(line.amount_kobo) %></td>
        </tr>
      <% end %>
    <% end %>
  </section>

  <% if @journal_entry %>
    <section class="mt-7">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-semibold text-neutral-900">Accounting entry</h2>
        <div class="flex items-center gap-4 text-sm">
          <%= link_to "Entry ##{@journal_entry.number}", journal_entry_path(@journal_entry), class: "font-medium text-balance-teal-700 hover:underline" %>
          <% if @expense.void_entry %>
            <%= link_to "Void entry ##{@expense.void_entry.number}", journal_entry_path(@expense.void_entry), class: "font-medium text-balance-teal-700 hover:underline" %>
          <% end %>
        </div>
      </div>
      <%= render layout: "shared/table", locals: { frame_class: "mt-3", columns: [ { label: "Account" }, { label: "Debit", align: :right }, { label: "Credit", align: :right } ] } do %>
        <% @journal_entry.journal_entry_lines.each do |line| %>
          <tr class="<%= table_row_class %>">
            <td class="<%= table_cell_class(strong: true) %>"><%= line.account.name %></td>
            <td class="<%= table_cell_class(align: :right) %> tabular-nums"><%= line.debit.positive? ? money(line.debit) : blank_cell %></td>
            <td class="<%= table_cell_class(align: :right) %> tabular-nums"><%= line.credit.positive? ? money(line.credit) : blank_cell %></td>
          </tr>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <div class="mt-8 flex items-center justify-end gap-2 border-t border-neutral-200 pt-5">
    <%= link_to "Back to expenses", expenses_path, class: secondary_button_class %>
  </div>
</div>
