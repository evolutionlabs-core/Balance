<% content_for :title, "Expenses" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Expenses" } ] %>
<% end %>

<% expense_actions = tag.div(class: "flex items-center gap-2") do %>
  <%= link_to(new_expense_path, class: primary_button_class(size: :compact)) do %>
    <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New expense
  <% end %>
<% end %>

<%= render "shared/page_header",
    title: "Expenses",
    description: "Manage and track your expenses.",
    action: expense_actions %>

<% if @expenses.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/banknote.svg",
      title: "No expenses yet",
      description: "Record a paid expense and Balance posts the accounting entry for you.",
      action: expense_actions %>
<% else %>
  <div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200 sm:hidden">
    <% @expenses.each do |expense| %>
      <article class="py-4">
        <div class="flex items-start justify-between gap-4">
          <%= link_to expense.description, expense_path(expense), class: "min-w-0 flex-1 truncate text-sm font-medium text-neutral-950" %>
          <span class="shrink-0 text-sm font-semibold tabular-nums text-neutral-950"><%= money(expense.total_kobo) %></span>
        </div>
        <p class="mt-1 truncate text-xs text-neutral-500"><%= expense.payment_account.name %> · <%= expense.category_label %></p>
        <div class="mt-2 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-xs text-neutral-500">
            <span><%= expense.payment_date.to_fs(:medium) %></span>
            <%= expense_status(expense) %>
          </div>
          <%= link_to "View", expense_path(expense), class: "flex min-h-11 shrink-0 items-center px-1 text-sm font-medium text-balance-teal-700" %>
        </div>
      </article>
    <% end %>
  </div>
  <%= render layout: "shared/table", locals: { frame_class: "mt-4 hidden sm:block", columns: [
        { label: "Date" }, { label: "Description" }, { label: "Payment account" }, { label: "Category" }, { label: "Status" },
        { label: "Amount", align: :right }, { label: "Actions", align: :right }
      ] } do %>
    <% @expenses.each do |expense| %>
      <tr id="<%= dom_id(expense) %>" class="<%= table_row_class %>">
        <% [ expense.payment_date.to_fs(:medium), expense.description, expense.payment_account.name, expense.category_label ].each do |value| %>
          <td class="<%= table_cell_class(link: true) %> whitespace-nowrap"><%= link_to value, expense_path(expense), class: table_cell_link_class %></td>
        <% end %>
        <td class="<%= table_cell_class(link: true) %> whitespace-nowrap">
          <%= link_to expense_path(expense), class: table_cell_link_class do %><%= expense_status(expense) %><% end %>
        </td>
        <td class="<%= table_cell_class(align: :right, strong: true, link: true) %> tabular-nums whitespace-nowrap">
          <%= link_to money(expense.total_kobo), expense_path(expense), class: table_cell_link_class %>
        </td>
        <td class="<%= table_cell_class(align: :right) %>">
          <%= link_to "View", expense_path(expense), class: "font-medium text-balance-teal-700 hover:underline" %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
