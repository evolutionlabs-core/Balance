<% content_for :title, "Expenses" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Expenses" } ] %>
<% end %>

<% expense_actions = tag.div(class: "flex items-center gap-2") do %>
  <%= link_to(new_expense_path, class: primary_button_class(size: :compact)) do %>
    <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New expense
  <% end %>
<% end %>

<%= render "shared/page_header",
    title: "Expenses",
    description: "Manage and track your expenses.",
    action: expense_actions %>

<% if @expenses.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/banknote.svg",
      title: "No expenses yet",
      description: "Record a paid expense and Balance will prepare the accounting entry for review.",
      action: expense_actions %>
<% else %>
  <div class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200 sm:hidden">
    <% @expenses.each do |expense| %>
      <article class="py-4">
        <div class="flex items-start justify-between gap-4">
          <%= link_to expense.description, expense_path(expense), class: "min-w-0 flex-1 truncate text-sm font-medium text-neutral-950" %>
          <span class="shrink-0 text-sm font-semibold tabular-nums text-neutral-950"><%= naira(expense.total_kobo) %></span>
        </div>
        <p class="mt-1 truncate text-xs text-neutral-500"><%= expense.payment_account.name %> · <%= expense.category_label %></p>
        <div class="mt-2 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-xs text-neutral-500">
            <span><%= expense.payment_date.to_fs(:medium) %></span>
            <%= expense_status(expense) %>
          </div>
          <%= link_to expense.draft? ? "Edit" : "View", expense.draft? ? edit_expense_path(expense) : expense_path(expense), class: "flex min-h-11 shrink-0 items-center px-1 text-sm font-medium text-[#0f7082]" %>
        </div>
      </article>
    <% end %>
  </div>
  <div class="mt-4 hidden overflow-x-auto border-y border-neutral-200 sm:block">
    <table class="min-w-full">
      <thead class="bg-white">
        <tr>
          <% [ "Date", "Description", "Payment account", "Category", "Status" ].each do |label| %>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-neutral-500"><%= label %></th>
          <% end %>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Amount</th>
          <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-neutral-500">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white">
        <% @expenses.each do |expense| %>
          <tr id="<%= dom_id(expense) %>" class="group border-t border-neutral-200 transition-colors hover:bg-neutral-50">
            <td data-label="Date" class="p-0 text-sm whitespace-nowrap text-neutral-600">
              <%= link_to expense.payment_date.to_fs(:medium), expense_path(expense), class: "block px-4 py-4" %>
            </td>
            <% [ [ "Description", expense.description ], [ "Payment", expense.payment_account.name ], [ "Category", expense.category_label ] ].each do |label, value| %>
              <td data-label="<%= label %>" class="p-0 text-sm whitespace-nowrap text-neutral-600">
                <%= link_to value, expense_path(expense), class: "block px-4 py-4" %>
              </td>
            <% end %>
            <td data-label="Status" class="p-0 text-sm whitespace-nowrap">
              <%= link_to expense_path(expense), class: "block px-4 py-4" do %><%= expense_status(expense) %><% end %>
            </td>
            <td data-label="Amount" class="p-0 text-right text-sm font-medium tabular-nums whitespace-nowrap text-neutral-900">
              <%= link_to naira(expense.total_kobo), expense_path(expense), class: "block px-4 py-4" %>
            </td>
            <td data-label="Actions" class="px-4 py-4 text-right text-sm">
              <%= link_to expense.draft? ? "Edit" : "View", expense.draft? ? edit_expense_path(expense) : expense_path(expense), class: "font-medium text-[#0f7082] hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
