<%= render "shared/modal" do %>
  <%= form_with url: expense_void_path(@expense), method: :post, class: "flex min-h-0 flex-1 flex-col" do |form| %>
    <%= render "shared/modal/header", title: "Void expense" %>

    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
      <%= render "shared/form_errors", record: @expense %>
      <p class="text-sm text-neutral-600">Voiding posts a reversal dated today that puts <%= money(@expense.total_kobo) %> back into <%= @expense.payment_account.name %>. The expense stays on record and cannot be changed.</p>
    </div>

    <%= render "shared/modal/footer", form: form, submit_label: "Void expense" %>
  <% end %>
<% end %>
