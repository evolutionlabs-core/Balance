<%= form_with model: workspace, url: url, class: "flex min-h-0 flex-1 flex-col" do |form| %>
  <%= render "shared/modal/header", title: "Edit company" %>

  <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-4">
    <%= render "shared/form_errors", record: workspace %>

    <div>
      <%= form.label :name, "Business name", class: field_label_class %>
      <%= form.text_field :name, required: true, class: field_class %>
    </div>

    <div>
      <%= form.label :address, "Business address", class: field_label_class %>
      <%= form.text_area :address, rows: 3, placeholder: "Address", class: field_class %>
    </div>
    <div>
      <%= form.label :default_sales_account_id, "Default income account", class: field_label_class %>
      <%= form.collection_select :default_sales_account_id, workspace.income_accounts.ordered, :id, :name,
          { include_blank: "Choose when posting" }, { class: field_class } %>
      <p class="mt-1 text-xs text-neutral-500">Used for invoice lines without a service. You can change the account before posting.</p>
    </div>
    <div>
      <%= form.label :default_deposit_account_id, "Default deposit account", class: field_label_class %>
      <%= form.collection_select :default_deposit_account_id, workspace.deposit_accounts.ordered, :id, :name,
          {}, { class: field_class } %>
      <p class="mt-1 text-xs text-neutral-500">Where customer payments land when you mark an invoice as paid.</p>
    </div>
  </div>

  <%= render "shared/modal/footer", form: form, submit_label: "Save changes" %>
<% end %>
