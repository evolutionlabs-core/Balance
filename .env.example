# Copy to .env for optional local Docker Compose overrides:
#   cp .env.example .env
#
# This file contains no application secrets. Production secrets belong in
# .kamal/secrets and Rails credentials.

# Optional local Postgres password. Defaults to balance_dev_password.
BALANCE_DATABASE_PASSWORD=

# Optional local model configuration. These default to an LM Studio server.
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=

# Required only when running the production Docker profile locally.
RAILS_MASTER_KEY=

# Live harness benchmark settings.
HARNESS_EVAL_MODEL=qwen3.5-35b-a3b
HARNESS_EVAL_BASE_URL=http://127.0.0.1:1234/v1
HARNESS_EVAL_RUNS=1

# In-app feedback: reports become GitHub issues. Leave the token blank to hide the Send feedback link.
# Fine-grained token owned by evolutionlabs-core, Balance repo only, Issues: read and write.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=evolutionlabs-core/Balance
